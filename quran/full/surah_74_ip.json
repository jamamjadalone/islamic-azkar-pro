{"surah":74,"ayahs":[{"n":1,"t":"یٰۤاَیُّهَا الْمُدَّثِّرُ ۟ۙ"},{"n":2,"t":"قُمْ فَاَنْذِرْ ۟ۙ"},{"n":3,"t":"وَرَبَّكَ فَكَبِّرْ ۟ۙ"},{"n":4,"t":"وَثِیَابَكَ فَطَهِّرْ ۟ۙ"},{"n":5,"t":"وَالرُّجْزَ فَاهْجُرْ ۟ۙ"},{"n":6,"t":"وَلَا تَمْنُنْ تَسْتَكْثِرُ ۟ۙ"},{"n":7,"t":"وَلِرَبِّكَ فَاصْبِرْ ۟ؕ"},{"n":8,"t":"فَاِذَا نُقِرَ فِی النَّاقُوْرِ ۟ۙ"},{"n":9,"t":"فَذٰلِكَ یَوْمَىِٕذٍ یَّوْمٌ عَسِیْرٌ ۟ۙ"},{"n":10,"t":"عَلَی الْكٰفِرِیْنَ غَیْرُ یَسِیْرٍ ۟"},{"n":11,"t":"ذَرْنِیْ وَمَنْ خَلَقْتُ وَحِیْدًا ۟ۙ"},{"n":12,"t":"وَّجَعَلْتُ لَهٗ مَالًا مَّمْدُوْدًا ۟ۙ"},{"n":13,"t":"وَّبَنِیْنَ شُهُوْدًا ۟ۙ"},{"n":14,"t":"وَّمَهَّدْتُّ لَهٗ تَمْهِیْدًا ۟ۙ"},{"n":15,"t":"ثُمَّ یَطْمَعُ اَنْ اَزِیْدَ ۟ۙ"},{"n":16,"t":"كَلَّا ؕ— اِنَّهٗ كَانَ لِاٰیٰتِنَا عَنِیْدًا ۟ؕ"},{"n":17,"t":"سَاُرْهِقُهٗ صَعُوْدًا ۟ؕ"},{"n":18,"t":"اِنَّهٗ فَكَّرَ وَقَدَّرَ ۟ۙ"},{"n":19,"t":"فَقُتِلَ كَیْفَ قَدَّرَ ۟ۙ"},{"n":20,"t":"ثُمَّ قُتِلَ كَیْفَ قَدَّرَ ۟ۙ"},{"n":21,"t":"ثُمَّ نَظَرَ ۟ۙ"},{"n":22,"t":"ثُمَّ عَبَسَ وَبَسَرَ ۟ۙ"},{"n":23,"t":"ثُمَّ اَدْبَرَ وَاسْتَكْبَرَ ۟ۙ"},{"n":24,"t":"فَقَالَ اِنْ هٰذَاۤ اِلَّا سِحْرٌ یُّؤْثَرُ ۟ۙ"},{"n":25,"t":"اِنْ هٰذَاۤ اِلَّا قَوْلُ الْبَشَرِ ۟ؕ"},{"n":26,"t":"سَاُصْلِیْهِ سَقَرَ ۟"},{"n":27,"t":"وَمَاۤ اَدْرٰىكَ مَا سَقَرُ ۟ؕ"},{"n":28,"t":"لَا تُبْقِیْ وَلَا تَذَرُ ۟ۚ"},{"n":29,"t":"لَوَّاحَةٌ لِّلْبَشَرِ ۟ۚ"},{"n":30,"t":"عَلَیْهَا تِسْعَةَ عَشَرَ ۟ؕ"},{"n":31,"t":"وَمَا جَعَلْنَاۤ اَصْحٰبَ النَّارِ اِلَّا مَلٰٓىِٕكَةً ۪— وَّمَا جَعَلْنَا عِدَّتَهُمْ اِلَّا فِتْنَةً لِّلَّذِیْنَ كَفَرُوْا ۙ— لِیَسْتَیْقِنَ الَّذِیْنَ اُوْتُوا الْكِتٰبَ وَیَزْدَادَ الَّذِیْنَ اٰمَنُوْۤا اِیْمَانًا وَّلَا یَرْتَابَ الَّذِیْنَ اُوْتُوا الْكِتٰبَ وَالْمُؤْمِنُوْنَ ۙ— وَلِیَقُوْلَ الَّذِیْنَ فِیْ قُلُوْبِهِمْ مَّرَضٌ وَّالْكٰفِرُوْنَ مَاذَاۤ اَرَادَ اللّٰهُ بِهٰذَا مَثَلًا ؕ— كَذٰلِكَ یُضِلُّ اللّٰهُ مَنْ یَّشَآءُ وَیَهْدِیْ مَنْ یَّشَآءُ ؕ— وَمَا یَعْلَمُ جُنُوْدَ رَبِّكَ اِلَّا هُوَ ؕ— وَمَا هِیَ اِلَّا ذِكْرٰی لِلْبَشَرِ ۟۠"},{"n":32,"t":"كَلَّا وَالْقَمَرِ ۟ۙ"},{"n":33,"t":"وَالَّیْلِ اِذْ اَدْبَرَ ۟ۙ"},{"n":34,"t":"وَالصُّبْحِ اِذَاۤ اَسْفَرَ ۟ۙ"},{"n":35,"t":"اِنَّهَا لَاِحْدَی الْكُبَرِ ۟ۙ"},{"n":36,"t":"نَذِیْرًا لِّلْبَشَرِ ۟ۙ"},{"n":37,"t":"لِمَنْ شَآءَ مِنْكُمْ اَنْ یَّتَقَدَّمَ اَوْ یَتَاَخَّرَ ۟ؕ"},{"n":38,"t":"كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِیْنَةٌ ۟ۙ"},{"n":39,"t":"اِلَّاۤ اَصْحٰبَ الْیَمِیْنِ ۟ؕۛ"},{"n":40,"t":"فِیْ جَنّٰتٍ ۛ۫— یَتَسَآءَلُوْنَ ۟ۙ"},{"n":41,"t":"عَنِ الْمُجْرِمِیْنَ ۟ۙ"},{"n":42,"t":"مَا سَلَكَكُمْ فِیْ سَقَرَ ۟"},{"n":43,"t":"قَالُوْا لَمْ نَكُ مِنَ الْمُصَلِّیْنَ ۟ۙ"},{"n":44,"t":"وَلَمْ نَكُ نُطْعِمُ الْمِسْكِیْنَ ۟ۙ"},{"n":45,"t":"وَكُنَّا نَخُوْضُ مَعَ الْخَآىِٕضِیْنَ ۟ۙ"},{"n":46,"t":"وَكُنَّا نُكَذِّبُ بِیَوْمِ الدِّیْنِ ۟ۙ"},{"n":47,"t":"حَتّٰۤی اَتٰىنَا الْیَقِیْنُ ۟ؕ"},{"n":48,"t":"فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشّٰفِعِیْنَ ۟ؕ"},{"n":49,"t":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِیْنَ ۟ۙ"},{"n":50,"t":"كَاَنَّهُمْ حُمُرٌ مُّسْتَنْفِرَةٌ ۟ۙ"},{"n":51,"t":"فَرَّتْ مِنْ قَسْوَرَةٍ ۟ؕ"},{"n":52,"t":"بَلْ یُرِیْدُ كُلُّ امْرِئٍ مِّنْهُمْ اَنْ یُّؤْتٰی صُحُفًا مُّنَشَّرَةً ۟ۙ"},{"n":53,"t":"كَلَّا ؕ— بَلْ لَّا یَخَافُوْنَ الْاٰخِرَةَ ۟ؕ"},{"n":54,"t":"كَلَّاۤ اِنَّهٗ تَذْكِرَةٌ ۟ۚ"},{"n":55,"t":"فَمَنْ شَآءَ ذَكَرَهٗ ۟ؕ"},{"n":56,"t":"وَمَا یَذْكُرُوْنَ اِلَّاۤ اَنْ یَّشَآءَ اللّٰهُ ؕ— هُوَ اَهْلُ التَّقْوٰی وَاَهْلُ الْمَغْفِرَةِ ۟۠"}]}