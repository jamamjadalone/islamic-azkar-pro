{
 "surah": 107,
 "ayahs": [
  {
   "n": 1,
   "t": "أَرَءَیۡتَ ٱلَّذِی یُكَذِّبُ بِٱلدِّینِ",
   "tc": "ارءيت الذي يكذب بالدين"
  },
  {
   "n": 2,
   "t": "فَذَ ٰ⁠لِكَ ٱلَّذِی یَدُعُّ ٱلۡیَتِیمَ",
   "tc": "فذ لك الذي يدع اليتيم"
  },
  {
   "n": 3,
   "t": "وَلَا یَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ",
   "tc": "ولا يحض علي طعام المسكين"
  },
  {
   "n": 4,
   "t": "فَوَیۡلࣱ لِّلۡمُصَلِّینَ",
   "tc": "فويلࣱ للمصلين"
  },
  {
   "n": 5,
   "t": "ٱلَّذِینَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ",
   "tc": "الذين هم عن صلاتهم ساهون"
  },
  {
   "n": 6,
   "t": "ٱلَّذِینَ هُمۡ یُرَاۤءُونَ",
   "tc": "الذين هم يراءون"
  },
  {
   "n": 7,
   "t": "وَیَمۡنَعُونَ ٱلۡمَاعُونَ",
   "tc": "ويمنعون الماعون"
  }
 ]
}