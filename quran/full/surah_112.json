   "n": 1,
   "t": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ",
   "tc": "قل هو الله احد"
  },
  {
   "n": 2,
   "t": "ٱللَّهُ ٱلصَّمَدُ",
   "tc": "الله الصمد"
  },
  {
   "n": 3,
   "t": "لَمۡ یَلِدۡ وَلَمۡ یُولَدۡ",
   "tc": "لم يلد ولم يولد"
  },
  {
   "n": 4,
   "t": "وَلَمۡ یَكُن لَّهُۥ كُفُوًا أَحَدُۢ",
   "tc": "ولم يكن له كفوا احد"
  }
