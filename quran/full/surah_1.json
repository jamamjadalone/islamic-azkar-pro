{
 "surah": 1,
 "ayahs": [
  {
   "n": 1,
   "t": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ",
   "tc": "بسم الله الرحمن الرحيم"
  },
  {
   "n": 2,
   "t": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَـٰلَمِینَ",
   "tc": "الحمد لله رب العلمين"
  },
  {
   "n": 3,
   "t": "ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ",
   "tc": "الرحمن الرحيم"
  },
  {
   "n": 4,
   "t": "مَـٰلِكِ یَوۡمِ ٱلدِّینِ",
   "tc": "ملك يوم الدين"
  },
  {
   "n": 5,
   "t": "إِیَّاكَ نَعۡبُدُ وَإِیَّاكَ نَسۡتَعِینُ",
   "tc": "اياك نعبد واياك نستعين"
  },
  {
   "n": 6,
   "t": "ٱهۡدِنَا ٱلصِّرَ ٰ⁠طَ ٱلۡمُسۡتَقِیمَ",
   "tc": "اهدنا الصر ط المستقيم"
  },
  {
   "n": 7,
   "t": "صِرَ ٰ⁠طَ ٱلَّذِینَ أَنۡعَمۡتَ عَلَیۡهِمۡ غَیۡرِ ٱلۡمَغۡضُوبِ عَلَیۡهِمۡ وَلَا ٱلضَّاۤلِّینَ",
   "tc": "صر ط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين"
  }
 ]
}