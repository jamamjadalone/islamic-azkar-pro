{
 "surah": 102,
 "ayahs": [
  {
   "n": 1,
   "t": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
   "tc": "الهيكم التكاثر"
  },
  {
   "n": 2,
   "t": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
   "tc": "حتي زرتم المقابر"
  },
  {
   "n": 3,
   "t": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
   "tc": "كلا سوف تعلمون"
  },
  {
   "n": 4,
   "t": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
   "tc": "ثم كلا سوف تعلمون"
  },
  {
   "n": 5,
   "t": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡیَقِینِ",
   "tc": "كلا لو تعلمون علم اليقين"
  },
  {
   "n": 6,
   "t": "لَتَرَوُنَّ ٱلۡجَحِیمَ",
   "tc": "لترون الجحيم"
  },
  {
   "n": 7,
   "t": "ثُمَّ لَتَرَوُنَّهَا عَیۡنَ ٱلۡیَقِینِ",
   "tc": "ثم لترونها عين اليقين"
  },
  {
   "n": 8,
   "t": "ثُمَّ لَتُسۡـَٔلُنَّ یَوۡمَىِٕذٍ عَنِ ٱلنَّعِیمِ",
   "tc": "ثم لتسلن يوميذ عن النعيم"
  }
 ]
}