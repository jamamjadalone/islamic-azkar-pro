{
 "surah": 90,
 "ayahs": [
  {
   "n": 1,
   "t": "لَاۤ أُقۡسِمُ بِهَـٰذَا ٱلۡبَلَدِ",
   "tc": "لا اقسم بهذا البلد"
  },
  {
   "n": 2,
   "t": "وَأَنتَ حِلُّۢ بِهَـٰذَا ٱلۡبَلَدِ",
   "tc": "وانت حل بهذا البلد"
  },
  {
   "n": 3,
   "t": "وَوَالِدࣲ وَمَا وَلَدَ",
   "tc": "ووالدࣲ وما ولد"
  },
  {
   "n": 4,
   "t": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَـٰنَ فِی كَبَدٍ",
   "tc": "لقد خلقنا الانسن في كبد"
  },
  {
   "n": 5,
   "t": "أَیَحۡسَبُ أَن لَّن یَقۡدِرَ عَلَیۡهِ أَحَدࣱ",
   "tc": "ايحسب ان لن يقدر عليه احدࣱ"
  },
  {
   "n": 6,
   "t": "یَقُولُ أَهۡلَكۡتُ مَالࣰا لُّبَدًا",
   "tc": "يقول اهلكت مالࣰا لبدا"
  },
  {
   "n": 7,
   "t": "أَیَحۡسَبُ أَن لَّمۡ یَرَهُۥۤ أَحَدٌ",
   "tc": "ايحسب ان لم يره احد"
  },
  {
   "n": 8,
   "t": "أَلَمۡ نَجۡعَل لَّهُۥ عَیۡنَیۡنِ",
   "tc": "الم نجعل له عينين"
  },
  {
   "n": 9,
   "t": "وَلِسَانࣰا وَشَفَتَیۡنِ",
   "tc": "ولسانࣰا وشفتين"
  },
  {
   "n": 10,
   "t": "وَهَدَیۡنَـٰهُ ٱلنَّجۡدَیۡنِ",
   "tc": "وهدينه النجدين"
  },
  {
   "n": 11,
   "t": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ",
   "tc": "فلا اقتحم العقبه"
  },
  {
   "n": 12,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ",
   "tc": "وما ادريك ما العقبه"
  },
  {
   "n": 13,
   "t": "فَكُّ رَقَبَةٍ",
   "tc": "فك رقبه"
  },
  {
   "n": 14,
   "t": "أَوۡ إِطۡعَـٰمࣱ فِی یَوۡمࣲ ذِی مَسۡغَبَةࣲ",
   "tc": "او اطعمࣱ في يومࣲ ذي مسغبهࣲ"
  },
  {
   "n": 15,
   "t": "یَتِیمࣰا ذَا مَقۡرَبَةٍ",
   "tc": "يتيمࣰا ذا مقربه"
  },
  {
   "n": 16,
   "t": "أَوۡ مِسۡكِینࣰا ذَا مَتۡرَبَةࣲ",
   "tc": "او مسكينࣰا ذا متربهࣲ"
  },
  {
   "n": 17,
   "t": "ثُمَّ كَانَ مِنَ ٱلَّذِینَ ءَامَنُوا۟ وَتَوَاصَوۡا۟ بِٱلصَّبۡرِ وَتَوَاصَوۡا۟ بِٱلۡمَرۡحَمَةِ",
   "tc": "ثم كان من الذين ءامنوا وتواصوا بالصبر وتواصوا بالمرحمه"
  },
  {
   "n": 18,
   "t": "أُو۟لَـٰۤىِٕكَ أَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ",
   "tc": "اوليك اصحب الميمنه"
  },
  {
   "n": 19,
   "t": "وَٱلَّذِینَ كَفَرُوا۟ بِـَٔایَـٰتِنَا هُمۡ أَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ",
   "tc": "والذين كفروا بايتنا هم اصحب المشمه"
  },
  {
   "n": 20,
   "t": "عَلَیۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ",
   "tc": "عليهم نارࣱ مؤصده"
  }
 ]
}