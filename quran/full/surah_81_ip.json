{"surah":81,"ayahs":[{"n":1,"t":"اِذَا الشَّمْسُ كُوِّرَتْ ۟"},{"n":2,"t":"وَاِذَا النُّجُوْمُ انْكَدَرَتْ ۟"},{"n":3,"t":"وَاِذَا الْجِبَالُ سُیِّرَتْ ۟"},{"n":4,"t":"وَاِذَا الْعِشَارُ عُطِّلَتْ ۟"},{"n":5,"t":"وَاِذَا الْوُحُوْشُ حُشِرَتْ ۟"},{"n":6,"t":"وَاِذَا الْبِحَارُ سُجِّرَتْ ۟"},{"n":7,"t":"وَاِذَا النُّفُوْسُ زُوِّجَتْ ۟"},{"n":8,"t":"وَاِذَا الْمَوْءٗدَةُ سُىِٕلَتْ ۟"},{"n":9,"t":"بِاَیِّ ذَنْۢبٍ قُتِلَتْ ۟ۚ"},{"n":10,"t":"وَاِذَا الصُّحُفُ نُشِرَتْ ۟"},{"n":11,"t":"وَاِذَا السَّمَآءُ كُشِطَتْ ۟"},{"n":12,"t":"وَاِذَا الْجَحِیْمُ سُعِّرَتْ ۟"},{"n":13,"t":"وَاِذَا الْجَنَّةُ اُزْلِفَتْ ۟"},{"n":14,"t":"عَلِمَتْ نَفْسٌ مَّاۤ اَحْضَرَتْ ۟ؕ"},{"n":15,"t":"فَلَاۤ اُقْسِمُ بِالْخُنَّسِ ۟ۙ"},{"n":16,"t":"الْجَوَارِ الْكُنَّسِ ۟ۙ"},{"n":17,"t":"وَالَّیْلِ اِذَا عَسْعَسَ ۟ۙ"},{"n":18,"t":"وَالصُّبْحِ اِذَا تَنَفَّسَ ۟ۙ"},{"n":19,"t":"اِنَّهٗ لَقَوْلُ رَسُوْلٍ كَرِیْمٍ ۟ۙ"},{"n":20,"t":"ذِیْ قُوَّةٍ عِنْدَ ذِی الْعَرْشِ مَكِیْنٍ ۟ۙ"},{"n":21,"t":"مُّطَاعٍ ثَمَّ اَمِیْنٍ ۟ؕ"},{"n":22,"t":"وَمَا صَاحِبُكُمْ بِمَجْنُوْنٍ ۟ۚ"},{"n":23,"t":"وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُبِیْنِ ۟ۚ"},{"n":24,"t":"وَمَا هُوَ عَلَی الْغَیْبِ بِضَنِیْنٍ ۟ۚ"},{"n":25,"t":"وَمَا هُوَ بِقَوْلِ شَیْطٰنٍ رَّجِیْمٍ ۟ۙ"},{"n":26,"t":"فَاَیْنَ تَذْهَبُوْنَ ۟ؕ"},{"n":27,"t":"اِنْ هُوَ اِلَّا ذِكْرٌ لِّلْعٰلَمِیْنَ ۟ۙ"},{"n":28,"t":"لِمَنْ شَآءَ مِنْكُمْ اَنْ یَّسْتَقِیْمَ ۟ؕ"},{"n":29,"t":"وَمَا تَشَآءُوْنَ اِلَّاۤ اَنْ یَّشَآءَ اللّٰهُ رَبُّ الْعٰلَمِیْنَ ۟۠"}]}