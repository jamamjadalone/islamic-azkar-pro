{"surah":93,"ayahs":[{"n":1,"t":"وَالضُّحٰی ۟ۙ"},{"n":2,"t":"وَالَّیْلِ اِذَا سَجٰی ۟ۙ"},{"n":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰی ۟ؕ"},{"n":4,"t":"وَلَلْاٰخِرَةُ خَیْرٌ لَّكَ مِنَ الْاُوْلٰی ۟ؕ"},{"n":5,"t":"وَلَسَوْفَ یُعْطِیْكَ رَبُّكَ فَتَرْضٰی ۟ؕ"},{"n":6,"t":"اَلَمْ یَجِدْكَ یَتِیْمًا فَاٰوٰی ۪۟"},{"n":7,"t":"وَوَجَدَكَ ضَآلًّا فَهَدٰی ۪۟"},{"n":8,"t":"وَوَجَدَكَ عَآىِٕلًا فَاَغْنٰی ۟ؕ"},{"n":9,"t":"فَاَمَّا الْیَتِیْمَ فَلَا تَقْهَرْ ۟ؕ"},{"n":10,"t":"وَاَمَّا السَّآىِٕلَ فَلَا تَنْهَرْ ۟ؕ"},{"n":11,"t":"وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ۟۠"}]}