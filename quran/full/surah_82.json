{
 "surah": 82,
 "ayahs": [
  {
   "n": 1,
   "t": "إِذَا ٱلسَّمَاۤءُ ٱنفَطَرَتۡ",
   "tc": "اذا السماء انفطرت"
  },
  {
   "n": 2,
   "t": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",
   "tc": "واذا الكواكب انتثرت"
  },
  {
   "n": 3,
   "t": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",
   "tc": "واذا البحار فجرت"
  },
  {
   "n": 4,
   "t": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",
   "tc": "واذا القبور بعثرت"
  },
  {
   "n": 5,
   "t": "عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",
   "tc": "علمت نفسࣱ ما قدمت واخرت"
  },
  {
   "n": 6,
   "t": "یَـٰۤأَیُّهَا ٱلۡإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِیمِ",
   "tc": "يايها الانسن ما غرك بربك الكريم"
  },
  {
   "n": 7,
   "t": "ٱلَّذِی خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
   "tc": "الذي خلقك فسويك فعدلك"
  },
  {
   "n": 8,
   "t": "فِیۤ أَیِّ صُورَةࣲ مَّا شَاۤءَ رَكَّبَكَ",
   "tc": "في اي صورهࣲ ما شاء ركبك"
  },
  {
   "n": 9,
   "t": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّینِ",
   "tc": "كلا بل تكذبون بالدين"
  },
  {
   "n": 10,
   "t": "وَإِنَّ عَلَیۡكُمۡ لَحَـٰفِظِینَ",
   "tc": "وان عليكم لحفظين"
  },
  {
   "n": 11,
   "t": "كِرَامࣰا كَـٰتِبِینَ",
   "tc": "كرامࣰا كتبين"
  },
  {
   "n": 12,
   "t": "یَعۡلَمُونَ مَا تَفۡعَلُونَ",
   "tc": "يعلمون ما تفعلون"
  },
  {
   "n": 13,
   "t": "إِنَّ ٱلۡأَبۡرَارَ لَفِی نَعِیمࣲ",
   "tc": "ان الابرار لفي نعيمࣲ"
  },
  {
   "n": 14,
   "t": "وَإِنَّ ٱلۡفُجَّارَ لَفِی جَحِیمࣲ",
   "tc": "وان الفجار لفي جحيمࣲ"
  },
  {
   "n": 15,
   "t": "یَصۡلَوۡنَهَا یَوۡمَ ٱلدِّینِ",
   "tc": "يصلونها يوم الدين"
  },
  {
   "n": 16,
   "t": "وَمَا هُمۡ عَنۡهَا بِغَاۤىِٕبِینَ",
   "tc": "وما هم عنها بغايبين"
  },
  {
   "n": 17,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلدِّینِ",
   "tc": "وما ادريك ما يوم الدين"
  },
  {
   "n": 18,
   "t": "ثُمَّ مَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلدِّینِ",
   "tc": "ثم ما ادريك ما يوم الدين"
  },
  {
   "n": 19,
   "t": "یَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَیۡـࣰٔاۖ وَٱلۡأَمۡرُ یَوۡمَىِٕذࣲ لِّلَّهِ",
   "tc": "يوم لا تملك نفسࣱ لنفسࣲ شيࣰا والامر يوميذࣲ لله"
  }
 ]
}