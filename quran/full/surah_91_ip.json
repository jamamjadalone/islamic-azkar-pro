{"surah":91,"ayahs":[{"n":1,"t":"وَالشَّمْسِ وَضُحٰىهَا ۟"},{"n":2,"t":"وَالْقَمَرِ اِذَا تَلٰىهَا ۟"},{"n":3,"t":"وَالنَّهَارِ اِذَا جَلّٰىهَا ۟"},{"n":4,"t":"وَالَّیْلِ اِذَا یَغْشٰىهَا ۟"},{"n":5,"t":"وَالسَّمَآءِ وَمَا بَنٰىهَا ۟"},{"n":6,"t":"وَالْاَرْضِ وَمَا طَحٰىهَا ۟"},{"n":7,"t":"وَنَفْسٍ وَّمَا سَوّٰىهَا ۟"},{"n":8,"t":"فَاَلْهَمَهَا فُجُوْرَهَا وَتَقْوٰىهَا ۟"},{"n":9,"t":"قَدْ اَفْلَحَ مَنْ زَكّٰىهَا ۟"},{"n":10,"t":"وَقَدْ خَابَ مَنْ دَسّٰىهَا ۟ؕ"},{"n":11,"t":"كَذَّبَتْ ثَمُوْدُ بِطَغْوٰىهَاۤ ۟"},{"n":12,"t":"اِذِ انْۢبَعَثَ اَشْقٰىهَا ۟"},{"n":13,"t":"فَقَالَ لَهُمْ رَسُوْلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْیٰهَا ۟ؕ"},{"n":14,"t":"فَكَذَّبُوْهُ فَعَقَرُوْهَا— فَدَمْدَمَ عَلَیْهِمْ رَبُّهُمْ بِذَنْۢبِهِمْ فَسَوّٰىهَا ۟"},{"n":15,"t":"وَلَا یَخَافُ عُقْبٰهَا ۟۠"}]}