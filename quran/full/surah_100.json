{
 "surah": 100,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلۡعَـٰدِیَـٰتِ ضَبۡحࣰا",
   "tc": "والعديت ضبحࣰا"
  },
  {
   "n": 2,
   "t": "فَٱلۡمُورِیَـٰتِ قَدۡحࣰا",
   "tc": "فالموريت قدحࣰا"
  },
  {
   "n": 3,
   "t": "فَٱلۡمُغِیرَ ٰ⁠تِ صُبۡحࣰا",
   "tc": "فالمغير ت صبحࣰا"
  },
  {
   "n": 4,
   "t": "فَأَثَرۡنَ بِهِۦ نَقۡعࣰا",
   "tc": "فاثرن به نقعࣰا"
  },
  {
   "n": 5,
   "t": "فَوَسَطۡنَ بِهِۦ جَمۡعًا",
   "tc": "فوسطن به جمعا"
  },
  {
   "n": 6,
   "t": "إِنَّ ٱلۡإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودࣱ",
   "tc": "ان الانسن لربه لكنودࣱ"
  },
  {
   "n": 7,
   "t": "وَإِنَّهُۥ عَلَىٰ ذَ ٰ⁠لِكَ لَشَهِیدࣱ",
   "tc": "وانه علي ذ لك لشهيدࣱ"
  },
  {
   "n": 8,
   "t": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَیۡرِ لَشَدِیدٌ",
   "tc": "وانه لحب الخير لشديد"
  },
  {
   "n": 9,
   "t": "۞ أَفَلَا یَعۡلَمُ إِذَا بُعۡثِرَ مَا فِی ٱلۡقُبُورِ",
   "tc": "افلا يعلم اذا بعثر ما في القبور"
  },
  {
   "n": 10,
   "t": "وَحُصِّلَ مَا فِی ٱلصُّدُورِ",
   "tc": "وحصل ما في الصدور"
  },
  {
   "n": 11,
   "t": "إِنَّ رَبَّهُم بِهِمۡ یَوۡمَىِٕذࣲ لَّخَبِیرُۢ",
   "tc": "ان ربهم بهم يوميذࣲ لخبير"
  }
 ]
}