{
 "surah": 91,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلشَّمۡسِ وَضُحَىٰهَا",
   "tc": "والشمس وضحيها"
  },
  {
   "n": 2,
   "t": "وَٱلۡقَمَرِ إِذَا تَلَىٰهَا",
   "tc": "والقمر اذا تليها"
  },
  {
   "n": 3,
   "t": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
   "tc": "والنهار اذا جليها"
  },
  {
   "n": 4,
   "t": "وَٱلَّیۡلِ إِذَا یَغۡشَىٰهَا",
   "tc": "واليل اذا يغشيها"
  },
  {
   "n": 5,
   "t": "وَٱلسَّمَاۤءِ وَمَا بَنَىٰهَا",
   "tc": "والسماء وما بنيها"
  },
  {
   "n": 6,
   "t": "وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا",
   "tc": "والارض وما طحيها"
  },
  {
   "n": 7,
   "t": "وَنَفۡسࣲ وَمَا سَوَّىٰهَا",
   "tc": "ونفسࣲ وما سويها"
  },
  {
   "n": 8,
   "t": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا",
   "tc": "فالهمها فجورها وتقويها"
  },
  {
   "n": 9,
   "t": "قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا",
   "tc": "قد افلح من زكيها"
  },
  {
   "n": 10,
   "t": "وَقَدۡ خَابَ مَن دَسَّىٰهَا",
   "tc": "وقد خاب من دسيها"
  },
  {
   "n": 11,
   "t": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَاۤ",
   "tc": "كذبت ثمود بطغويها"
  },
  {
   "n": 12,
   "t": "إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا",
   "tc": "اذ انبعث اشقيها"
  },
  {
   "n": 13,
   "t": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡیَـٰهَا",
   "tc": "فقال لهم رسول الله ناقه الله وسقيها"
  },
  {
   "n": 14,
   "t": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَیۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا",
   "tc": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسويها"
  },
  {
   "n": 15,
   "t": "وَلَا یَخَافُ عُقۡبَـٰهَا",
   "tc": "ولا يخاف عقبها"
  }
 ]
}