{"surah":82,"ayahs":[{"n":1,"t":"اِذَا السَّمَآءُ انْفَطَرَتْ ۟ۙ"},{"n":2,"t":"وَاِذَا الْكَوَاكِبُ انْتَثَرَتْ ۟ۙ"},{"n":3,"t":"وَاِذَا الْبِحَارُ فُجِّرَتْ ۟ۙ"},{"n":4,"t":"وَاِذَا الْقُبُوْرُ بُعْثِرَتْ ۟ۙ"},{"n":5,"t":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَاَخَّرَتْ ۟ؕ"},{"n":6,"t":"یٰۤاَیُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِیْمِ ۟ۙ"},{"n":7,"t":"الَّذِیْ خَلَقَكَ فَسَوّٰىكَ فَعَدَلَكَ ۟ۙ"},{"n":8,"t":"فِیْۤ اَیِّ صُوْرَةٍ مَّا شَآءَ رَكَّبَكَ ۟ؕ"},{"n":9,"t":"كَلَّا بَلْ تُكَذِّبُوْنَ بِالدِّیْنِ ۟ۙ"},{"n":10,"t":"وَاِنَّ عَلَیْكُمْ لَحٰفِظِیْنَ ۟ۙ"},{"n":11,"t":"كِرَامًا كٰتِبِیْنَ ۟ۙ"},{"n":12,"t":"یَعْلَمُوْنَ مَا تَفْعَلُوْنَ ۟"},{"n":13,"t":"اِنَّ الْاَبْرَارَ لَفِیْ نَعِیْمٍ ۟ۙ"},{"n":14,"t":"وَاِنَّ الْفُجَّارَ لَفِیْ جَحِیْمٍ ۟ۙ"},{"n":15,"t":"یَّصْلَوْنَهَا یَوْمَ الدِّیْنِ ۟"},{"n":16,"t":"وَمَا هُمْ عَنْهَا بِغَآىِٕبِیْنَ ۟ؕ"},{"n":17,"t":"وَمَاۤ اَدْرٰىكَ مَا یَوْمُ الدِّیْنِ ۟ۙ"},{"n":18,"t":"ثُمَّ مَاۤ اَدْرٰىكَ مَا یَوْمُ الدِّیْنِ ۟ؕ"},{"n":19,"t":"یَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَیْـًٔا ؕ— وَالْاَمْرُ یَوْمَىِٕذٍ لِّلّٰهِ ۟۠"}]}