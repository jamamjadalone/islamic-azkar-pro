{
 "surah": 81,
 "ayahs": [
  {
   "n": 1,
   "t": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
   "tc": "اذا الشمس كورت"
  },
  {
   "n": 2,
   "t": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
   "tc": "واذا النجوم انكدرت"
  },
  {
   "n": 3,
   "t": "وَإِذَا ٱلۡجِبَالُ سُیِّرَتۡ",
   "tc": "واذا الجبال سيرت"
  },
  {
   "n": 4,
   "t": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
   "tc": "واذا العشار عطلت"
  },
  {
   "n": 5,
   "t": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
   "tc": "واذا الوحوش حشرت"
  },
  {
   "n": 6,
   "t": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",
   "tc": "واذا البحار سجرت"
  },
  {
   "n": 7,
   "t": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
   "tc": "واذا النفوس زوجت"
  },
  {
   "n": 8,
   "t": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُىِٕلَتۡ",
   "tc": "واذا الموءده سيلت"
  },
  {
   "n": 9,
   "t": "بِأَیِّ ذَنۢبࣲ قُتِلَتۡ",
   "tc": "باي ذنبࣲ قتلت"
  },
  {
   "n": 10,
   "t": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",
   "tc": "واذا الصحف نشرت"
  },
  {
   "n": 11,
   "t": "وَإِذَا ٱلسَّمَاۤءُ كُشِطَتۡ",
   "tc": "واذا السماء كشطت"
  },
  {
   "n": 12,
   "t": "وَإِذَا ٱلۡجَحِیمُ سُعِّرَتۡ",
   "tc": "واذا الجحيم سعرت"
  },
  {
   "n": 13,
   "t": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
   "tc": "واذا الجنه ازلفت"
  },
  {
   "n": 14,
   "t": "عَلِمَتۡ نَفۡسࣱ مَّاۤ أَحۡضَرَتۡ",
   "tc": "علمت نفسࣱ ما احضرت"
  },
  {
   "n": 15,
   "t": "فَلَاۤ أُقۡسِمُ بِٱلۡخُنَّسِ",
   "tc": "فلا اقسم بالخنس"
  },
  {
   "n": 16,
   "t": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
   "tc": "الجوار الكنس"
  },
  {
   "n": 17,
   "t": "وَٱلَّیۡلِ إِذَا عَسۡعَسَ",
   "tc": "واليل اذا عسعس"
  },
  {
   "n": 18,
   "t": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
   "tc": "والصبح اذا تنفس"
  },
  {
   "n": 19,
   "t": "إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِیمࣲ",
   "tc": "انه لقول رسولࣲ كريمࣲ"
  },
  {
   "n": 20,
   "t": "ذِی قُوَّةٍ عِندَ ذِی ٱلۡعَرۡشِ مَكِینࣲ",
   "tc": "ذي قوه عند ذي العرش مكينࣲ"
  },
  {
   "n": 21,
   "t": "مُّطَاعࣲ ثَمَّ أَمِینࣲ",
   "tc": "مطاعࣲ ثم امينࣲ"
  },
  {
   "n": 22,
   "t": "وَمَا صَاحِبُكُم بِمَجۡنُونࣲ",
   "tc": "وما صاحبكم بمجنونࣲ"
  },
  {
   "n": 23,
   "t": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِینِ",
   "tc": "ولقد رءاه بالافق المبين"
  },
  {
   "n": 24,
   "t": "وَمَا هُوَ عَلَى ٱلۡغَیۡبِ بِضَنِینࣲ",
   "tc": "وما هو علي الغيب بضنينࣲ"
  },
  {
   "n": 25,
   "t": "وَمَا هُوَ بِقَوۡلِ شَیۡطَـٰنࣲ رَّجِیمࣲ",
   "tc": "وما هو بقول شيطنࣲ رجيمࣲ"
  },
  {
   "n": 26,
   "t": "فَأَیۡنَ تَذۡهَبُونَ",
   "tc": "فاين تذهبون"
  },
  {
   "n": 27,
   "t": "إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَـٰلَمِینَ",
   "tc": "ان هو الا ذكرࣱ للعلمين"
  },
  {
   "n": 28,
   "t": "لِمَن شَاۤءَ مِنكُمۡ أَن یَسۡتَقِیمَ",
   "tc": "لمن شاء منكم ان يستقيم"
  },
  {
   "n": 29,
   "t": "وَمَا تَشَاۤءُونَ إِلَّاۤ أَن یَشَاۤءَ ٱللَّهُ رَبُّ ٱلۡعَـٰلَمِینَ",
   "tc": "وما تشاءون الا ان يشاء الله رب العلمين"
  }
 ]
}