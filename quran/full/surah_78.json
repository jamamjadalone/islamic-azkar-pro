{
 "surah": 78,
 "ayahs": [
  {
   "n": 1,
   "t": "عَمَّ یَتَسَاۤءَلُونَ",
   "tc": "عم يتساءلون"
  },
  {
   "n": 2,
   "t": "عَنِ ٱلنَّبَإِ ٱلۡعَظِیمِ",
   "tc": "عن النبا العظيم"
  },
  {
   "n": 3,
   "t": "ٱلَّذِی هُمۡ فِیهِ مُخۡتَلِفُونَ",
   "tc": "الذي هم فيه مختلفون"
  },
  {
   "n": 4,
   "t": "كَلَّا سَیَعۡلَمُونَ",
   "tc": "كلا سيعلمون"
  },
  {
   "n": 5,
   "t": "ثُمَّ كَلَّا سَیَعۡلَمُونَ",
   "tc": "ثم كلا سيعلمون"
  },
  {
   "n": 6,
   "t": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَـٰدࣰا",
   "tc": "الم نجعل الارض مهدࣰا"
  },
  {
   "n": 7,
   "t": "وَٱلۡجِبَالَ أَوۡتَادࣰا",
   "tc": "والجبال اوتادࣰا"
  },
  {
   "n": 8,
   "t": "وَخَلَقۡنَـٰكُمۡ أَزۡوَ ٰ⁠جࣰا",
   "tc": "وخلقنكم ازو جࣰا"
  },
  {
   "n": 9,
   "t": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتࣰا",
   "tc": "وجعلنا نومكم سباتࣰا"
  },
  {
   "n": 10,
   "t": "وَجَعَلۡنَا ٱلَّیۡلَ لِبَاسࣰا",
   "tc": "وجعلنا اليل لباسࣰا"
  },
  {
   "n": 11,
   "t": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشࣰا",
   "tc": "وجعلنا النهار معاشࣰا"
  },
  {
   "n": 12,
   "t": "وَبَنَیۡنَا فَوۡقَكُمۡ سَبۡعࣰا شِدَادࣰا",
   "tc": "وبنينا فوقكم سبعࣰا شدادࣰا"
  },
  {
   "n": 13,
   "t": "وَجَعَلۡنَا سِرَاجࣰا وَهَّاجࣰا",
   "tc": "وجعلنا سراجࣰا وهاجࣰا"
  },
  {
   "n": 14,
   "t": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَ ٰ⁠تِ مَاۤءࣰ ثَجَّاجࣰا",
   "tc": "وانزلنا من المعصر ت ماءࣰ ثجاجࣰا"
  },
  {
   "n": 15,
   "t": "لِّنُخۡرِجَ بِهِۦ حَبࣰّا وَنَبَاتࣰا",
   "tc": "لنخرج به حبࣰا ونباتࣰا"
  },
  {
   "n": 16,
   "t": "وَجَنَّـٰتٍ أَلۡفَافًا",
   "tc": "وجنت الفافا"
  },
  {
   "n": 17,
   "t": "إِنَّ یَوۡمَ ٱلۡفَصۡلِ كَانَ مِیقَـٰتࣰا",
   "tc": "ان يوم الفصل كان ميقتࣰا"
  },
  {
   "n": 18,
   "t": "یَوۡمَ یُنفَخُ فِی ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجࣰا",
   "tc": "يوم ينفخ في الصور فتاتون افواجࣰا"
  },
  {
   "n": 19,
   "t": "وَفُتِحَتِ ٱلسَّمَاۤءُ فَكَانَتۡ أَبۡوَ ٰ⁠بࣰا",
   "tc": "وفتحت السماء فكانت ابو بࣰا"
  },
  {
   "n": 20,
   "t": "وَسُیِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا",
   "tc": "وسيرت الجبال فكانت سرابا"
  },
  {
   "n": 21,
   "t": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادࣰا",
   "tc": "ان جهنم كانت مرصادࣰا"
  },
  {
   "n": 22,
   "t": "لِّلطَّـٰغِینَ مَـَٔابࣰا",
   "tc": "للطغين مابࣰا"
  },
  {
   "n": 23,
   "t": "لَّـٰبِثِینَ فِیهَاۤ أَحۡقَابࣰا",
   "tc": "لبثين فيها احقابࣰا"
  },
  {
   "n": 24,
   "t": "لَّا یَذُوقُونَ فِیهَا بَرۡدࣰا وَلَا شَرَابًا",
   "tc": "لا يذوقون فيها بردࣰا ولا شرابا"
  },
  {
   "n": 25,
   "t": "إِلَّا حَمِیمࣰا وَغَسَّاقࣰا",
   "tc": "الا حميمࣰا وغساقࣰا"
  },
  {
   "n": 26,
   "t": "جَزَاۤءࣰ وِفَاقًا",
   "tc": "جزاءࣰ وفاقا"
  },
  {
   "n": 27,
   "t": "إِنَّهُمۡ كَانُوا۟ لَا یَرۡجُونَ حِسَابࣰا",
   "tc": "انهم كانوا لا يرجون حسابࣰا"
  },
  {
   "n": 28,
   "t": "وَكَذَّبُوا۟ بِـَٔایَـٰتِنَا كِذَّابࣰا",
   "tc": "وكذبوا بايتنا كذابࣰا"
  },
  {
   "n": 29,
   "t": "وَكُلَّ شَیۡءٍ أَحۡصَیۡنَـٰهُ كِتَـٰبࣰا",
   "tc": "وكل شيء احصينه كتبࣰا"
  },
  {
   "n": 30,
   "t": "فَذُوقُوا۟ فَلَن نَّزِیدَكُمۡ إِلَّا عَذَابًا",
   "tc": "فذوقوا فلن نزيدكم الا عذابا"
  },
  {
   "n": 31,
   "t": "إِنَّ لِلۡمُتَّقِینَ مَفَازًا",
   "tc": "ان للمتقين مفازا"
  },
  {
   "n": 32,
   "t": "حَدَاۤىِٕقَ وَأَعۡنَـٰبࣰا",
   "tc": "حدايق واعنبࣰا"
  },
  {
   "n": 33,
   "t": "وَكَوَاعِبَ أَتۡرَابࣰا",
   "tc": "وكواعب اترابࣰا"
  },
  {
   "n": 34,
   "t": "وَكَأۡسࣰا دِهَاقࣰا",
   "tc": "وكاسࣰا دهاقࣰا"
  },
  {
   "n": 35,
   "t": "لَّا یَسۡمَعُونَ فِیهَا لَغۡوࣰا وَلَا كِذَّ ٰ⁠بࣰا",
   "tc": "لا يسمعون فيها لغوࣰا ولا كذ بࣰا"
  },
  {
   "n": 36,
   "t": "جَزَاۤءࣰ مِّن رَّبِّكَ عَطَاۤءً حِسَابࣰا",
   "tc": "جزاءࣰ من ربك عطاء حسابࣰا"
  },
  {
   "n": 37,
   "t": "رَّبِّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَا ٱلرَّحۡمَـٰنِۖ لَا یَمۡلِكُونَ مِنۡهُ خِطَابࣰا",
   "tc": "رب السمو ت والارض وما بينهما الرحمن لا يملكون منه خطابࣰا"
  },
  {
   "n": 38,
   "t": "یَوۡمَ یَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰۤىِٕكَةُ صَفࣰّاۖ لَّا یَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَـٰنُ وَقَالَ صَوَابࣰا",
   "tc": "يوم يقوم الروح والمليكه صفࣰا لا يتكلمون الا من اذن له الرحمن وقال صوابࣰا"
  },
  {
   "n": 39,
   "t": "ذَ ٰ⁠لِكَ ٱلۡیَوۡمُ ٱلۡحَقُّۖ فَمَن شَاۤءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
   "tc": "ذ لك اليوم الحق فمن شاء اتخذ الي ربه مابا"
  },
  {
   "n": 40,
   "t": "إِنَّاۤ أَنذَرۡنَـٰكُمۡ عَذَابࣰا قَرِیبࣰا یَوۡمَ یَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ یَدَاهُ وَیَقُولُ ٱلۡكَافِرُ یَـٰلَیۡتَنِی كُنتُ تُرَ ٰ⁠بَۢا",
   "tc": "انا انذرنكم عذابࣰا قريبࣰا يوم ينظر المرء ما قدمت يداه ويقول الكافر يليتني كنت تر با"
  }
 ]
}