{"surah":104,"ayahs":[{"n":1,"t":"وَیْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِ ۟ۙ"},{"n":2,"t":"١لَّذِیْ جَمَعَ مَالًا وَّعَدَّدَهٗ ۟ۙ"},{"n":3,"t":"یَحْسَبُ اَنَّ مَالَهٗۤ اَخْلَدَهٗ ۟ۚ"},{"n":4,"t":"كَلَّا لَیُنْۢبَذَنَّ فِی الْحُطَمَةِ ۟ؗۖ"},{"n":5,"t":"وَمَاۤ اَدْرٰىكَ مَا الْحُطَمَةُ ۟ؕ"},{"n":6,"t":"نَارُ اللّٰهِ الْمُوْقَدَةُ ۟ۙ"},{"n":7,"t":"الَّتِیْ تَطَّلِعُ عَلَی الْاَفْـِٕدَةِ ۟ؕ"},{"n":8,"t":"اِنَّهَا عَلَیْهِمْ مُّؤْصَدَةٌ ۟ۙ"},{"n":9,"t":"فِیْ عَمَدٍ مُّمَدَّدَةٍ ۟۠"}]}