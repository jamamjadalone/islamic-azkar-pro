{"surah":78,"ayahs":[{"n":1,"t":"عَمَّ یَتَسَآءَلُوْنَ ۟ۚ"},{"n":2,"t":"عَنِ النَّبَاِ الْعَظِیْمِ ۟ۙ"},{"n":3,"t":"الَّذِیْ هُمْ فِیْهِ مُخْتَلِفُوْنَ ۟ؕ"},{"n":4,"t":"كَلَّا سَیَعْلَمُوْنَ ۟ۙ"},{"n":5,"t":"ثُمَّ كَلَّا سَیَعْلَمُوْنَ ۟"},{"n":6,"t":"اَلَمْ نَجْعَلِ الْاَرْضَ مِهٰدًا ۟ۙ"},{"n":7,"t":"وَّالْجِبَالَ اَوْتَادًا ۟ۙ"},{"n":8,"t":"وَّخَلَقْنٰكُمْ اَزْوَاجًا ۟ۙ"},{"n":9,"t":"وَّجَعَلْنَا نَوْمَكُمْ سُبَاتًا ۟ۙ"},{"n":10,"t":"وَّجَعَلْنَا الَّیْلَ لِبَاسًا ۟ۙ"},{"n":11,"t":"وَّجَعَلْنَا النَّهَارَ مَعَاشًا ۟ۚ"},{"n":12,"t":"وَبَنَیْنَا فَوْقَكُمْ سَبْعًا شِدَادًا ۟ۙ"},{"n":13,"t":"وَّجَعَلْنَا سِرَاجًا وَّهَّاجًا ۟ۙ"},{"n":14,"t":"وَّاَنْزَلْنَا مِنَ الْمُعْصِرٰتِ مَآءً ثَجَّاجًا ۟ۙ"},{"n":15,"t":"لِّنُخْرِجَ بِهٖ حَبًّا وَّنَبَاتًا ۟ۙ"},{"n":16,"t":"وَّجَنّٰتٍ اَلْفَافًا ۟ؕ"},{"n":17,"t":"اِنَّ یَوْمَ الْفَصْلِ كَانَ مِیْقَاتًا ۟ۙ"},{"n":18,"t":"یَّوْمَ یُنْفَخُ فِی الصُّوْرِ فَتَاْتُوْنَ اَفْوَاجًا ۟ۙ"},{"n":19,"t":"وَّفُتِحَتِ السَّمَآءُ فَكَانَتْ اَبْوَابًا ۟ۙ"},{"n":20,"t":"وَّسُیِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا ۟ؕ"},{"n":21,"t":"اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا ۟ۙ"},{"n":22,"t":"لِّلطَّاغِیْنَ مَاٰبًا ۟ۙ"},{"n":23,"t":"لّٰبِثِیْنَ فِیْهَاۤ اَحْقَابًا ۟ۚ"},{"n":24,"t":"لَا یَذُوْقُوْنَ فِیْهَا بَرْدًا وَّلَا شَرَابًا ۟ۙ"},{"n":25,"t":"اِلَّا حَمِیْمًا وَّغَسَّاقًا ۟ۙ"},{"n":26,"t":"جَزَآءً وِّفَاقًا ۟ؕ"},{"n":27,"t":"اِنَّهُمْ كَانُوْا لَا یَرْجُوْنَ حِسَابًا ۟ۙ"},{"n":28,"t":"وَّكَذَّبُوْا بِاٰیٰتِنَا كِذَّابًا ۟ؕ"},{"n":29,"t":"وَكُلَّ شَیْءٍ اَحْصَیْنٰهُ كِتٰبًا ۟ۙ"},{"n":30,"t":"فَذُوْقُوْا فَلَنْ نَّزِیْدَكُمْ اِلَّا عَذَابًا ۟۠"},{"n":31,"t":"اِنَّ لِلْمُتَّقِیْنَ مَفَازًا ۟ۙ"},{"n":32,"t":"حَدَآىِٕقَ وَاَعْنَابًا ۟ۙ"},{"n":33,"t":"وَّكَوَاعِبَ اَتْرَابًا ۟ۙ"},{"n":34,"t":"وَّكَاْسًا دِهَاقًا ۟ؕ"},{"n":35,"t":"لَا یَسْمَعُوْنَ فِیْهَا لَغْوًا وَّلَا كِذّٰبًا ۟ۚۖ"},{"n":36,"t":"جَزَآءً مِّنْ رَّبِّكَ عَطَآءً حِسَابًا ۟ۙ"},{"n":37,"t":"رَّبِّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا الرَّحْمٰنِ لَا یَمْلِكُوْنَ مِنْهُ خِطَابًا ۟ۚ"},{"n":38,"t":"یَوْمَ یَقُوْمُ الرُّوْحُ وَالْمَلٰٓىِٕكَةُ صَفًّا ۙۗؕ— لَّا یَتَكَلَّمُوْنَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا ۟"},{"n":39,"t":"ذٰلِكَ الْیَوْمُ الْحَقُّ ۚ— فَمَنْ شَآءَ اتَّخَذَ اِلٰی رَبِّهٖ مَاٰبًا ۟"},{"n":40,"t":"اِنَّاۤ اَنْذَرْنٰكُمْ عَذَابًا قَرِیْبًا ۖۚ۬— یَّوْمَ یَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ یَدٰهُ وَیَقُوْلُ الْكٰفِرُ یٰلَیْتَنِیْ كُنْتُ تُرٰبًا ۟۠"}]}