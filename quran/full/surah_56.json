  },
  {
   "n": 90,
   "t": "وَأَمَّاۤ إِن كَانَ مِنۡ أَصۡحَـٰبِ ٱلۡیَمِینِ",
   "tc": "واما ان كان من اصحب اليمين"
  },
  {
   "n": 91,
   "t": "فَسَلَـٰمࣱ لَّكَ مِنۡ أَصۡحَـٰبِ ٱلۡیَمِینِ",
   "tc": "فسلمࣱ لك من اصحب اليمين"
  },
  {
   "n": 92,
   "t": "وَأَمَّاۤ إِن كَانَ مِنَ ٱلۡمُكَذِّبِینَ ٱلضَّاۤلِّینَ",
   "tc": "واما ان كان من المكذبين الضالين"
