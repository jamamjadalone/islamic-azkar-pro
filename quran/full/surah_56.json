  },
  {
   "n": 94,
   "t": "وَتَصۡلِیَةُ جَحِیمٍ",
   "tc": "وتصليه جحيم"
  },
  {
   "n": 95,
   "t": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلۡیَقِینِ",
   "tc": "ان هذا لهو حق اليقين"
  },
  {
   "n": 96,
   "t": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِیمِ",
   "tc": "فسبح باسم ربك العظيم"
  }
 ]
