{
 "surah": 56,
 "ayahs": [
  {
   "n": 1,
   "t": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ",
   "tc": "اذا وقعت الواقعه"
  },
  {
   "n": 2,
   "t": "لَیۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ",
   "tc": "ليس لوقعتها كاذبه"
  },
  {
   "n": 3,
   "t": "خَافِضَةࣱ رَّافِعَةٌ",
   "tc": "خافضهࣱ رافعه"
  },
  {
   "n": 4,
   "t": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجࣰّا",
   "tc": "اذا رجت الارض رجࣰا"
  },
  {
   "n": 5,
   "t": "وَبُسَّتِ ٱلۡجِبَالُ بَسࣰّا",
   "tc": "وبست الجبال بسࣰا"
  },
  {
   "n": 6,
   "t": "فَكَانَتۡ هَبَاۤءࣰ مُّنۢبَثࣰّا",
   "tc": "فكانت هباءࣰ منبثࣰا"
  },
  {
   "n": 7,
   "t": "وَكُنتُمۡ أَزۡوَ ٰ⁠جࣰا ثَلَـٰثَةࣰ",
   "tc": "وكنتم ازو جࣰا ثلثهࣰ"
  },
  {
   "n": 8,
   "t": "فَأَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ مَاۤ أَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ",
   "tc": "فاصحب الميمنه ما اصحب الميمنه"
  },
  {
   "n": 9,
   "t": "وَأَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ مَاۤ أَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ",
   "tc": "واصحب المشمه ما اصحب المشمه"
  },
  {
   "n": 10,
   "t": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
   "tc": "والسبقون السبقون"
  },
  {
   "n": 11,
   "t": "أُو۟لَـٰۤىِٕكَ ٱلۡمُقَرَّبُونَ",
   "tc": "اوليك المقربون"
  },
  {
   "n": 12,
   "t": "فِی جَنَّـٰتِ ٱلنَّعِیمِ",
   "tc": "في جنت النعيم"
  },
  {
   "n": 13,
   "t": "ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِینَ",
   "tc": "ثلهࣱ من الاولين"
  },
  {
   "n": 14,
   "t": "وَقَلِیلࣱ مِّنَ ٱلۡـَٔاخِرِینَ",
   "tc": "وقليلࣱ من الاخرين"
  },
  {
   "n": 15,
   "t": "عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ",
   "tc": "علي سررࣲ موضونهࣲ"
  },
  {
   "n": 16,
   "t": "مُّتَّكِـِٔینَ عَلَیۡهَا مُتَقَـٰبِلِینَ",
   "tc": "متكين عليها متقبلين"
  },
  {
   "n": 17,
   "t": "یَطُوفُ عَلَیۡهِمۡ وِلۡدَ ٰ⁠نࣱ مُّخَلَّدُونَ",
   "tc": "يطوف عليهم ولد نࣱ مخلدون"
  },
  {
   "n": 18,
   "t": "بِأَكۡوَابࣲ وَأَبَارِیقَ وَكَأۡسࣲ مِّن مَّعِینࣲ",
   "tc": "باكوابࣲ واباريق وكاسࣲ من معينࣲ"
  },
  {
   "n": 19,
   "t": "لَّا یُصَدَّعُونَ عَنۡهَا وَلَا یُنزِفُونَ",
   "tc": "لا يصدعون عنها ولا ينزفون"
  },
  {
   "n": 20,
   "t": "وَفَـٰكِهَةࣲ مِّمَّا یَتَخَیَّرُونَ",
   "tc": "وفكههࣲ مما يتخيرون"
  },
  {
   "n": 21,
   "t": "وَلَحۡمِ طَیۡرࣲ مِّمَّا یَشۡتَهُونَ",
   "tc": "ولحم طيرࣲ مما يشتهون"
  },
  {
   "n": 22,
   "t": "وَحُورٌ عِینࣱ",
   "tc": "وحور عينࣱ"
  },
  {
   "n": 23,
   "t": "كَأَمۡثَـٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ",
   "tc": "كامثل اللؤلو المكنون"
  },
  {
   "n": 24,
   "t": "جَزَاۤءَۢ بِمَا كَانُوا۟ یَعۡمَلُونَ",
   "tc": "جزاء بما كانوا يعملون"
  },
  {
   "n": 25,
   "t": "لَا یَسۡمَعُونَ فِیهَا لَغۡوࣰا وَلَا تَأۡثِیمًا",
   "tc": "لا يسمعون فيها لغوࣰا ولا تاثيما"
  },
  {
   "n": 26,
   "t": "إِلَّا قِیلࣰا سَلَـٰمࣰا سَلَـٰمࣰا",
   "tc": "الا قيلࣰا سلمࣰا سلمࣰا"
  },
  {
   "n": 27,
   "t": "وَأَصۡحَـٰبُ ٱلۡیَمِینِ مَاۤ أَصۡحَـٰبُ ٱلۡیَمِینِ",
   "tc": "واصحب اليمين ما اصحب اليمين"
  },
  {
   "n": 28,
   "t": "فِی سِدۡرࣲ مَّخۡضُودࣲ",
   "tc": "في سدرࣲ مخضودࣲ"
  },
  {
   "n": 29,
   "t": "وَطَلۡحࣲ مَّنضُودࣲ",
   "tc": "وطلحࣲ منضودࣲ"
  },
  {
   "n": 30,
   "t": "وَظِلࣲّ مَّمۡدُودࣲ",
   "tc": "وظلࣲ ممدودࣲ"
  },
  {
   "n": 31,
   "t": "وَمَاۤءࣲ مَّسۡكُوبࣲ",
   "tc": "وماءࣲ مسكوبࣲ"
  },
  {
   "n": 32,
   "t": "وَفَـٰكِهَةࣲ كَثِیرَةࣲ",
   "tc": "وفكههࣲ كثيرهࣲ"
  },
  {
   "n": 33,
   "t": "لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ",
   "tc": "لا مقطوعهࣲ ولا ممنوعهࣲ"
  },
  {
   "n": 34,
   "t": "وَفُرُشࣲ مَّرۡفُوعَةٍ",
   "tc": "وفرشࣲ مرفوعه"
  },
  {
   "n": 35,
   "t": "إِنَّاۤ أَنشَأۡنَـٰهُنَّ إِنشَاۤءࣰ",
   "tc": "انا انشانهن انشاءࣰ"
  },
  {
   "n": 36,
   "t": "فَجَعَلۡنَـٰهُنَّ أَبۡكَارًا",
   "tc": "فجعلنهن ابكارا"
  },
  {
   "n": 37,
   "t": "عُرُبًا أَتۡرَابࣰا",
   "tc": "عربا اترابࣰا"
  },
  {
   "n": 38,
   "t": "لِّأَصۡحَـٰبِ ٱلۡیَمِینِ",
   "tc": "لاصحب اليمين"
  },
  {
   "n": 39,
   "t": "ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِینَ",
   "tc": "ثلهࣱ من الاولين"
  },
  {
   "n": 40,
   "t": "وَثُلَّةࣱ مِّنَ ٱلۡـَٔاخِرِینَ",
   "tc": "وثلهࣱ من الاخرين"
  },
  {
   "n": 41,
   "t": "وَأَصۡحَـٰبُ ٱلشِّمَالِ مَاۤ أَصۡحَـٰبُ ٱلشِّمَالِ",
   "tc": "واصحب الشمال ما اصحب الشمال"
  },
  {
   "n": 42,
   "t": "فِی سَمُومࣲ وَحَمِیمࣲ",
   "tc": "في سمومࣲ وحميمࣲ"
  },
  {
   "n": 43,
   "t": "وَظِلࣲّ مِّن یَحۡمُومࣲ",
   "tc": "وظلࣲ من يحمومࣲ"
  },
  {
   "n": 44,
   "t": "لَّا بَارِدࣲ وَلَا كَرِیمٍ",
   "tc": "لا باردࣲ ولا كريم"
  },
  {
   "n": 45,
   "t": "إِنَّهُمۡ كَانُوا۟ قَبۡلَ ذَ ٰ⁠لِكَ مُتۡرَفِینَ",
   "tc": "انهم كانوا قبل ذ لك مترفين"
  },
  {
   "n": 46,
   "t": "وَكَانُوا۟ یُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِیمِ",
   "tc": "وكانوا يصرون علي الحنث العظيم"
  },
  {
   "n": 47,
   "t": "وَكَانُوا۟ یَقُولُونَ أَىِٕذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
   "tc": "وكانوا يقولون ايذا متنا وكنا ترابࣰا وعظما اءنا لمبعوثون"
  },
  {
   "n": 48,
   "t": "أَوَءَابَاۤؤُنَا ٱلۡأَوَّلُونَ",
   "tc": "اوءاباؤنا الاولون"
  },
  {
   "n": 49,
   "t": "قُلۡ إِنَّ ٱلۡأَوَّلِینَ وَٱلۡـَٔاخِرِینَ",
   "tc": "قل ان الاولين والاخرين"
  },
  {
   "n": 50,
   "t": "لَمَجۡمُوعُونَ إِلَىٰ مِیقَـٰتِ یَوۡمࣲ مَّعۡلُومࣲ",
   "tc": "لمجموعون الي ميقت يومࣲ معلومࣲ"
  },
  {
   "n": 51,
   "t": "ثُمَّ إِنَّكُمۡ أَیُّهَا ٱلضَّاۤلُّونَ ٱلۡمُكَذِّبُونَ",
   "tc": "ثم انكم ايها الضالون المكذبون"
  },
  {
   "n": 52,
   "t": "لَـَٔاكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ",
   "tc": "لاكلون من شجرࣲ من زقومࣲ"
  },
  {
   "n": 53,
   "t": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
   "tc": "فمالون منها البطون"
  },
  {
   "n": 54,
   "t": "فَشَـٰرِبُونَ عَلَیۡهِ مِنَ ٱلۡحَمِیمِ",
   "tc": "فشربون عليه من الحميم"
  },
  {
   "n": 55,
   "t": "فَشَـٰرِبُونَ شُرۡبَ ٱلۡهِیمِ",
   "tc": "فشربون شرب الهيم"
  },
  {
   "n": 56,
   "t": "هَـٰذَا نُزُلُهُمۡ یَوۡمَ ٱلدِّینِ",
   "tc": "هذا نزلهم يوم الدين"
  },
  {
   "n": 57,
   "t": "نَحۡنُ خَلَقۡنَـٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ",
   "tc": "نحن خلقنكم فلولا تصدقون"
  },
  {
   "n": 58,
   "t": "أَفَرَءَیۡتُم مَّا تُمۡنُونَ",
   "tc": "افرءيتم ما تمنون"
  },
  {
   "n": 59,
   "t": "ءَأَنتُمۡ تَخۡلُقُونَهُۥۤ أَمۡ نَحۡنُ ٱلۡخَـٰلِقُونَ",
   "tc": "ءانتم تخلقونه ام نحن الخلقون"
  },
  {
   "n": 60,
   "t": "نَحۡنُ قَدَّرۡنَا بَیۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِینَ",
   "tc": "نحن قدرنا بينكم الموت وما نحن بمسبوقين"
  },
  {
   "n": 61,
   "t": "عَلَىٰۤ أَن نُّبَدِّلَ أَمۡثَـٰلَكُمۡ وَنُنشِئَكُمۡ فِی مَا لَا تَعۡلَمُونَ",
   "tc": "علي ان نبدل امثلكم وننشئكم في ما لا تعلمون"
  },
  {
   "n": 62,
   "t": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ",
   "tc": "ولقد علمتم النشاه الاولي فلولا تذكرون"
  },
  {
   "n": 63,
   "t": "أَفَرَءَیۡتُم مَّا تَحۡرُثُونَ",
   "tc": "افرءيتم ما تحرثون"
  },
  {
   "n": 64,
   "t": "ءَأَنتُمۡ تَزۡرَعُونَهُۥۤ أَمۡ نَحۡنُ ٱلزَّ ٰ⁠رِعُونَ",
   "tc": "ءانتم تزرعونه ام نحن الز رعون"
  },
  {
   "n": 65,
   "t": "لَوۡ نَشَاۤءُ لَجَعَلۡنَـٰهُ حُطَـٰمࣰا فَظَلۡتُمۡ تَفَكَّهُونَ",
   "tc": "لو نشاء لجعلنه حطمࣰا فظلتم تفكهون"
  },
  {
   "n": 66,
   "t": "إِنَّا لَمُغۡرَمُونَ",
   "tc": "انا لمغرمون"
  },
  {
   "n": 67,
   "t": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
   "tc": "بل نحن محرومون"
  },
  {
   "n": 68,
   "t": "أَفَرَءَیۡتُمُ ٱلۡمَاۤءَ ٱلَّذِی تَشۡرَبُونَ",
   "tc": "افرءيتم الماء الذي تشربون"
  },
  {
   "n": 69,
   "t": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ",
   "tc": "ءانتم انزلتموه من المزن ام نحن المنزلون"
  },
  {
   "n": 70,
   "t": "لَوۡ نَشَاۤءُ جَعَلۡنَـٰهُ أُجَاجࣰا فَلَوۡلَا تَشۡكُرُونَ",
   "tc": "لو نشاء جعلنه اجاجࣰا فلولا تشكرون"
  },
  {
   "n": 71,
   "t": "أَفَرَءَیۡتُمُ ٱلنَّارَ ٱلَّتِی تُورُونَ",
   "tc": "افرءيتم النار التي تورون"
  },
  {
   "n": 72,
   "t": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَاۤ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ",
   "tc": "ءانتم انشاتم شجرتها ام نحن المنشون"
  },
  {
   "n": 73,
   "t": "نَحۡنُ جَعَلۡنَـٰهَا تَذۡكِرَةࣰ وَمَتَـٰعࣰا لِّلۡمُقۡوِینَ",
   "tc": "نحن جعلنها تذكرهࣰ ومتعࣰا للمقوين"
  },
  {
   "n": 74,
   "t": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِیمِ",
   "tc": "فسبح باسم ربك العظيم"
  },
  {
   "n": 75,
   "t": "۞ فَلَاۤ أُقۡسِمُ بِمَوَ ٰ⁠قِعِ ٱلنُّجُومِ",
   "tc": "فلا اقسم بمو قع النجوم"
  },
  {
   "n": 76,
   "t": "وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِیمٌ",
   "tc": "وانه لقسمࣱ لو تعلمون عظيم"
  },
  {
   "n": 77,
   "t": "إِنَّهُۥ لَقُرۡءَانࣱ كَرِیمࣱ",
   "tc": "انه لقرءانࣱ كريمࣱ"
  },
  {
   "n": 78,
   "t": "فِی كِتَـٰبࣲ مَّكۡنُونࣲ",
   "tc": "في كتبࣲ مكنونࣲ"
  },
  {
   "n": 79,
   "t": "لَّا یَمَسُّهُۥۤ إِلَّا ٱلۡمُطَهَّرُونَ",
   "tc": "لا يمسه الا المطهرون"
  },
  {
   "n": 80,
   "t": "تَنزِیلࣱ مِّن رَّبِّ ٱلۡعَـٰلَمِینَ",
   "tc": "تنزيلࣱ من رب العلمين"
  },
  {
   "n": 81,
   "t": "أَفَبِهَـٰذَا ٱلۡحَدِیثِ أَنتُم مُّدۡهِنُونَ",
   "tc": "افبهذا الحديث انتم مدهنون"
  },
  {
   "n": 82,
   "t": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ",
   "tc": "وتجعلون رزقكم انكم تكذبون"
  },
  {
   "n": 83,
   "t": "فَلَوۡلَاۤ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ",
   "tc": "فلولا اذا بلغت الحلقوم"
  },
  {
   "n": 84,
   "t": "وَأَنتُمۡ حِینَىِٕذࣲ تَنظُرُونَ",
   "tc": "وانتم حينيذࣲ تنظرون"
  },
  {
   "n": 85,
   "t": "وَنَحۡنُ أَقۡرَبُ إِلَیۡهِ مِنكُمۡ وَلَـٰكِن لَّا تُبۡصِرُونَ",
   "tc": "ونحن اقرب اليه منكم ولكن لا تبصرون"
  },
  {
   "n": 86,
   "t": "فَلَوۡلَاۤ إِن كُنتُمۡ غَیۡرَ مَدِینِینَ",
   "tc": "فلولا ان كنتم غير مدينين"
  },
  {
   "n": 87,
   "t": "تَرۡجِعُونَهَاۤ إِن كُنتُمۡ صَـٰدِقِینَ",
   "tc": "ترجعونها ان كنتم صدقين"
  },
  {
   "n": 88,
   "t": "فَأَمَّاۤ إِن كَانَ مِنَ ٱلۡمُقَرَّبِینَ",
   "tc": "فاما ان كان من المقربين"
  },
  {
   "n": 89,
   "t": "فَرَوۡحࣱ وَرَیۡحَانࣱ وَجَنَّتُ نَعِیمࣲ",
