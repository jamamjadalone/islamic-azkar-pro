{"surah":84,"ayahs":[{"n":1,"t":"اِذَا السَّمَآءُ انْشَقَّتْ ۟ۙ"},{"n":2,"t":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۟ۙ"},{"n":3,"t":"وَاِذَا الْاَرْضُ مُدَّتْ ۟ؕ"},{"n":4,"t":"وَاَلْقَتْ مَا فِیْهَا وَتَخَلَّتْ ۟ۙ"},{"n":5,"t":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۟ؕ"},{"n":6,"t":"یٰۤاَیُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰی رَبِّكَ كَدْحًا فَمُلٰقِیْهِ ۟ۚ"},{"n":7,"t":"فَاَمَّا مَنْ اُوْتِیَ كِتٰبَهٗ بِیَمِیْنِهٖ ۟ۙ"},{"n":8,"t":"فَسَوْفَ یُحَاسَبُ حِسَابًا یَّسِیْرًا ۟ۙ"},{"n":9,"t":"وَّیَنْقَلِبُ اِلٰۤی اَهْلِهٖ مَسْرُوْرًا ۟ؕ"},{"n":10,"t":"وَاَمَّا مَنْ اُوْتِیَ كِتٰبَهٗ وَرَآءَ ظَهْرِهٖ ۟ۙ"},{"n":11,"t":"فَسَوْفَ یَدْعُوْا ثُبُوْرًا ۟ۙ"},{"n":12,"t":"وَّیَصْلٰی سَعِیْرًا ۟ؕ"},{"n":13,"t":"اِنَّهٗ كَانَ فِیْۤ اَهْلِهٖ مَسْرُوْرًا ۟ؕ"},{"n":14,"t":"اِنَّهٗ ظَنَّ اَنْ لَّنْ یَّحُوْرَ ۟ۚۛ"},{"n":15,"t":"بَلٰۤی ۛۚ— اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِیْرًا ۟ؕ"},{"n":16,"t":"فَلَاۤ اُقْسِمُ بِالشَّفَقِ ۟ۙ"},{"n":17,"t":"وَالَّیْلِ وَمَا وَسَقَ ۟ۙ"},{"n":18,"t":"وَالْقَمَرِ اِذَا اتَّسَقَ ۟ۙ"},{"n":19,"t":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ ۟ؕ"},{"n":20,"t":"فَمَا لَهُمْ لَا یُؤْمِنُوْنَ ۟ۙ"},{"n":21,"t":"وَاِذَا قُرِئَ عَلَیْهِمُ الْقُرْاٰنُ لَا یَسْجُدُوْنَ ۟"},{"n":22,"t":"بَلِ الَّذِیْنَ كَفَرُوْا یُكَذِّبُوْنَ ۟ؗۖ"},{"n":23,"t":"وَاللّٰهُ اَعْلَمُ بِمَا یُوْعُوْنَ ۟ؗۖ"},{"n":24,"t":"فَبَشِّرْهُمْ بِعَذَابٍ اَلِیْمٍ ۟ۙ"},{"n":25,"t":"اِلَّا الَّذِیْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ لَهُمْ اَجْرٌ غَیْرُ مَمْنُوْنٍ ۟۠"}]}