{
 "surah": 89,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلۡفَجۡرِ",
   "tc": "والفجر"
  },
  {
   "n": 2,
   "t": "وَلَیَالٍ عَشۡرࣲ",
   "tc": "وليال عشرࣲ"
  },
  {
   "n": 3,
   "t": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ",
   "tc": "والشفع والوتر"
  },
  {
   "n": 4,
   "t": "وَٱلَّیۡلِ إِذَا یَسۡرِ",
   "tc": "واليل اذا يسر"
  },
  {
   "n": 5,
   "t": "هَلۡ فِی ذَ ٰ⁠لِكَ قَسَمࣱ لِّذِی حِجۡرٍ",
   "tc": "هل في ذ لك قسمࣱ لذي حجر"
  },
  {
   "n": 6,
   "t": "أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِعَادٍ",
   "tc": "الم تر كيف فعل ربك بعاد"
  },
  {
   "n": 7,
   "t": "إِرَمَ ذَاتِ ٱلۡعِمَادِ",
   "tc": "ارم ذات العماد"
  },
  {
   "n": 8,
   "t": "ٱلَّتِی لَمۡ یُخۡلَقۡ مِثۡلُهَا فِی ٱلۡبِلَـٰدِ",
   "tc": "التي لم يخلق مثلها في البلد"
  },
  {
   "n": 9,
   "t": "وَثَمُودَ ٱلَّذِینَ جَابُوا۟ ٱلصَّخۡرَ بِٱلۡوَادِ",
   "tc": "وثمود الذين جابوا الصخر بالواد"
  },
  {
   "n": 10,
   "t": "وَفِرۡعَوۡنَ ذِی ٱلۡأَوۡتَادِ",
   "tc": "وفرعون ذي الاوتاد"
  },
  {
   "n": 11,
   "t": "ٱلَّذِینَ طَغَوۡا۟ فِی ٱلۡبِلَـٰدِ",
   "tc": "الذين طغوا في البلد"
  },
  {
   "n": 12,
   "t": "فَأَكۡثَرُوا۟ فِیهَا ٱلۡفَسَادَ",
   "tc": "فاكثروا فيها الفساد"
  },
  {
   "n": 13,
   "t": "فَصَبَّ عَلَیۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ",
   "tc": "فصب عليهم ربك سوط عذاب"
  },
  {
   "n": 14,
   "t": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ",
   "tc": "ان ربك لبالمرصاد"
  },
  {
   "n": 15,
   "t": "فَأَمَّا ٱلۡإِنسَـٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَیَقُولُ رَبِّیۤ أَكۡرَمَنِ",
   "tc": "فاما الانسن اذا ما ابتليه ربه فاكرمه ونعمه فيقول ربي اكرمن"
  },
  {
   "n": 16,
   "t": "وَأَمَّاۤ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَیۡهِ رِزۡقَهُۥ فَیَقُولُ رَبِّیۤ أَهَـٰنَنِ",
   "tc": "واما اذا ما ابتليه فقدر عليه رزقه فيقول ربي اهنن"
  },
  {
   "n": 17,
   "t": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡیَتِیمَ",
   "tc": "كلا بل لا تكرمون اليتيم"
  },
  {
   "n": 18,
   "t": "وَلَا تَحَـٰۤضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ",
   "tc": "ولا تحضون علي طعام المسكين"
  },
  {
   "n": 19,
   "t": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلࣰا لَّمࣰّا",
   "tc": "وتاكلون التراث اكلࣰا لمࣰا"
  },
  {
   "n": 20,
   "t": "وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّا جَمࣰّا",
   "tc": "وتحبون المال حبࣰا جمࣰا"
  },
  {
   "n": 21,
   "t": "كَلَّاۤۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكࣰّا دَكࣰّا",
   "tc": "كلا اذا دكت الارض دكࣰا دكࣰا"
  },
  {
   "n": 22,
   "t": "وَجَاۤءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّا صَفࣰّا",
   "tc": "وجاء ربك والملك صفࣰا صفࣰا"
  },
  {
   "n": 23,
   "t": "وَجِا۟یۤءَ یَوۡمَىِٕذِۭ بِجَهَنَّمَۚ یَوۡمَىِٕذࣲ یَتَذَكَّرُ ٱلۡإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ",
   "tc": "وجايء يوميذ بجهنم يوميذࣲ يتذكر الانسن واني له الذكري"
  },
  {
   "n": 24,
   "t": "یَقُولُ یَـٰلَیۡتَنِی قَدَّمۡتُ لِحَیَاتِی",
   "tc": "يقول يليتني قدمت لحياتي"
  },
  {
   "n": 25,
   "t": "فَیَوۡمَىِٕذࣲ لَّا یُعَذِّبُ عَذَابَهُۥۤ أَحَدࣱ",
   "tc": "فيوميذࣲ لا يعذب عذابه احدࣱ"
  },
  {
   "n": 26,
   "t": "وَلَا یُوثِقُ وَثَاقَهُۥۤ أَحَدࣱ",
   "tc": "ولا يوثق وثاقه احدࣱ"
  },
  {
   "n": 27,
   "t": "یَـٰۤأَیَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَىِٕنَّةُ",
   "tc": "يايتها النفس المطمينه"
  },
  {
   "n": 28,
   "t": "ٱرۡجِعِیۤ إِلَىٰ رَبِّكِ رَاضِیَةࣰ مَّرۡضِیَّةࣰ",
   "tc": "ارجعي الي ربك راضيهࣰ مرضيهࣰ"
  },
  {
   "n": 29,
   "t": "فَٱدۡخُلِی فِی عِبَـٰدِی",
   "tc": "فادخلي في عبدي"
  },
  {
   "n": 30,
   "t": "وَٱدۡخُلِی جَنَّتِی",
   "tc": "وادخلي جنتي"
  }
 ]
}