{
 "surah": 114,
 "ayahs": [
  {
   "n": 1,
   "t": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
   "tc": "قل اعوذ برب الناس"
  },
  {
   "n": 2,
   "t": "مَلِكِ ٱلنَّاسِ",
   "tc": "ملك الناس"
  },
  {
   "n": 3,
   "t": "إِلَـٰهِ ٱلنَّاسِ",
   "tc": "اله الناس"
  },
  {
   "n": 4,
   "t": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
   "tc": "من شر الوسواس الخناس"
  },
  {
   "n": 5,
   "t": "ٱلَّذِی یُوَسۡوِسُ فِی صُدُورِ ٱلنَّاسِ",
   "tc": "الذي يوسوس في صدور الناس"
  },
  {
   "n": 6,
   "t": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
   "tc": "من الجنه والناس"
  }
 ]
}