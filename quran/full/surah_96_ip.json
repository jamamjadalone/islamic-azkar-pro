{"surah":96,"ayahs":[{"n":1,"t":"اِقْرَاْ بِاسْمِ رَبِّكَ الَّذِیْ خَلَقَ ۟ۚ"},{"n":2,"t":"خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍ ۟ۚ"},{"n":3,"t":"اِقْرَاْ وَرَبُّكَ الْاَكْرَمُ ۟ۙ"},{"n":4,"t":"الَّذِیْ عَلَّمَ بِالْقَلَمِ ۟ۙ"},{"n":5,"t":"عَلَّمَ الْاِنْسَانَ مَا لَمْ یَعْلَمْ ۟ؕ"},{"n":6,"t":"كَلَّاۤ اِنَّ الْاِنْسَانَ لَیَطْغٰۤی ۟ۙ"},{"n":7,"t":"اَنْ رَّاٰهُ اسْتَغْنٰی ۟ؕ"},{"n":8,"t":"اِنَّ اِلٰی رَبِّكَ الرُّجْعٰی ۟ؕ"},{"n":9,"t":"اَرَءَیْتَ الَّذِیْ یَنْهٰی ۟ۙ"},{"n":10,"t":"عَبْدًا اِذَا صَلّٰی ۟ؕ"},{"n":11,"t":"اَرَءَیْتَ اِنْ كَانَ عَلَی الْهُدٰۤی ۟ۙ"},{"n":12,"t":"اَوْ اَمَرَ بِالتَّقْوٰی ۟ؕ"},{"n":13,"t":"اَرَءَیْتَ اِنْ كَذَّبَ وَتَوَلّٰی ۟ؕ"},{"n":14,"t":"اَلَمْ یَعْلَمْ بِاَنَّ اللّٰهَ یَرٰی ۟ؕ"},{"n":15,"t":"كَلَّا لَىِٕنْ لَّمْ یَنْتَهِ ۙ۬— لَنَسْفَعًا بِالنَّاصِیَةِ ۟ۙ"},{"n":16,"t":"نَاصِیَةٍ كَاذِبَةٍ خَاطِئَةٍ ۟ۚ"},{"n":17,"t":"فَلْیَدْعُ نَادِیَهٗ ۟ۙ"},{"n":18,"t":"سَنَدْعُ الزَّبَانِیَةَ ۟ۙ"},{"n":19,"t":"كَلَّا ؕ— لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۟"}]}