{
 "surah": 77,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلۡمُرۡسَلَـٰتِ عُرۡفࣰا",
   "tc": "والمرسلت عرفࣰا"
  },
  {
   "n": 2,
   "t": "فَٱلۡعَـٰصِفَـٰتِ عَصۡفࣰا",
   "tc": "فالعصفت عصفࣰا"
  },
  {
   "n": 3,
   "t": "وَٱلنَّـٰشِرَ ٰ⁠تِ نَشۡرࣰا",
   "tc": "والنشر ت نشرࣰا"
  },
  {
   "n": 4,
   "t": "فَٱلۡفَـٰرِقَـٰتِ فَرۡقࣰا",
   "tc": "فالفرقت فرقࣰا"
  },
  {
   "n": 5,
   "t": "فَٱلۡمُلۡقِیَـٰتِ ذِكۡرًا",
   "tc": "فالملقيت ذكرا"
  },
  {
   "n": 6,
   "t": "عُذۡرًا أَوۡ نُذۡرًا",
   "tc": "عذرا او نذرا"
  },
  {
   "n": 7,
   "t": "إِنَّمَا تُوعَدُونَ لَوَ ٰ⁠قِعࣱ",
   "tc": "انما توعدون لو قعࣱ"
  },
  {
   "n": 8,
   "t": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ",
   "tc": "فاذا النجوم طمست"
  },
  {
   "n": 9,
   "t": "وَإِذَا ٱلسَّمَاۤءُ فُرِجَتۡ",
   "tc": "واذا السماء فرجت"
  },
  {
   "n": 10,
   "t": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ",
   "tc": "واذا الجبال نسفت"
  },
  {
   "n": 11,
   "t": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ",
   "tc": "واذا الرسل اقتت"
  },
  {
   "n": 12,
   "t": "لِأَیِّ یَوۡمٍ أُجِّلَتۡ",
   "tc": "لاي يوم اجلت"
  },
  {
   "n": 13,
   "t": "لِیَوۡمِ ٱلۡفَصۡلِ",
   "tc": "ليوم الفصل"
  },
  {
   "n": 14,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلۡفَصۡلِ",
   "tc": "وما ادريك ما يوم الفصل"
  },
  {
   "n": 15,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 16,
   "t": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِینَ",
   "tc": "الم نهلك الاولين"
  },
  {
   "n": 17,
   "t": "ثُمَّ نُتۡبِعُهُمُ ٱلۡـَٔاخِرِینَ",
   "tc": "ثم نتبعهم الاخرين"
  },
  {
   "n": 18,
   "t": "كَذَ ٰ⁠لِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِینَ",
   "tc": "كذ لك نفعل بالمجرمين"
  },
  {
   "n": 19,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 20,
   "t": "أَلَمۡ نَخۡلُقكُّم مِّن مَّاۤءࣲ مَّهِینࣲ",
   "tc": "الم نخلقكم من ماءࣲ مهينࣲ"
  },
  {
   "n": 21,
   "t": "فَجَعَلۡنَـٰهُ فِی قَرَارࣲ مَّكِینٍ",
   "tc": "فجعلنه في قرارࣲ مكين"
  },
  {
   "n": 22,
   "t": "إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ",
   "tc": "الي قدرࣲ معلومࣲ"
  },
  {
   "n": 23,
   "t": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَـٰدِرُونَ",
   "tc": "فقدرنا فنعم القدرون"
  },
  {
   "n": 24,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 25,
   "t": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا",
   "tc": "الم نجعل الارض كفاتا"
  },
  {
   "n": 26,
   "t": "أَحۡیَاۤءࣰ وَأَمۡوَ ٰ⁠تࣰا",
   "tc": "احياءࣰ وامو تࣰا"
  },
  {
   "n": 27,
   "t": "وَجَعَلۡنَا فِیهَا رَوَ ٰ⁠سِیَ شَـٰمِخَـٰتࣲ وَأَسۡقَیۡنَـٰكُم مَّاۤءࣰ فُرَاتࣰا",
   "tc": "وجعلنا فيها رو سي شمختࣲ واسقينكم ماءࣰ فراتࣰا"
  },
  {
   "n": 28,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 29,
   "t": "ٱنطَلِقُوۤا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
   "tc": "انطلقوا الي ما كنتم به تكذبون"
  },
  {
   "n": 30,
   "t": "ٱنطَلِقُوۤا۟ إِلَىٰ ظِلࣲّ ذِی ثَلَـٰثِ شُعَبࣲ",
   "tc": "انطلقوا الي ظلࣲ ذي ثلث شعبࣲ"
  },
  {
   "n": 31,
   "t": "لَّا ظَلِیلࣲ وَلَا یُغۡنِی مِنَ ٱللَّهَبِ",
   "tc": "لا ظليلࣲ ولا يغني من اللهب"
  },
  {
   "n": 32,
   "t": "إِنَّهَا تَرۡمِی بِشَرَرࣲ كَٱلۡقَصۡرِ",
   "tc": "انها ترمي بشررࣲ كالقصر"
  },
  {
   "n": 33,
   "t": "كَأَنَّهُۥ جِمَـٰلَتࣱ صُفۡرࣱ",
   "tc": "كانه جملتࣱ صفرࣱ"
  },
  {
   "n": 34,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 35,
   "t": "هَـٰذَا یَوۡمُ لَا یَنطِقُونَ",
   "tc": "هذا يوم لا ينطقون"
  },
  {
   "n": 36,
   "t": "وَلَا یُؤۡذَنُ لَهُمۡ فَیَعۡتَذِرُونَ",
   "tc": "ولا يؤذن لهم فيعتذرون"
  },
  {
   "n": 37,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 38,
   "t": "هَـٰذَا یَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَـٰكُمۡ وَٱلۡأَوَّلِینَ",
   "tc": "هذا يوم الفصل جمعنكم والاولين"
  },
  {
   "n": 39,
   "t": "فَإِن كَانَ لَكُمۡ كَیۡدࣱ فَكِیدُونِ",
   "tc": "فان كان لكم كيدࣱ فكيدون"
  },
  {
   "n": 40,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 41,
   "t": "إِنَّ ٱلۡمُتَّقِینَ فِی ظِلَـٰلࣲ وَعُیُونࣲ",
   "tc": "ان المتقين في ظللࣲ وعيونࣲ"
  },
  {
   "n": 42,
   "t": "وَفَوَ ٰ⁠كِهَ مِمَّا یَشۡتَهُونَ",
   "tc": "وفو كه مما يشتهون"
  },
  {
   "n": 43,
   "t": "كُلُوا۟ وَٱشۡرَبُوا۟ هَنِیۤـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ",
   "tc": "كلوا واشربوا هنيا بما كنتم تعملون"
  },
  {
   "n": 44,
   "t": "إِنَّا كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ",
   "tc": "انا كذ لك نجزي المحسنين"
  },
  {
   "n": 45,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 46,
   "t": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِیلًا إِنَّكُم مُّجۡرِمُونَ",
   "tc": "كلوا وتمتعوا قليلا انكم مجرمون"
  },
  {
   "n": 47,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 48,
   "t": "وَإِذَا قِیلَ لَهُمُ ٱرۡكَعُوا۟ لَا یَرۡكَعُونَ",
   "tc": "واذا قيل لهم اركعوا لا يركعون"
  },
  {
   "n": 49,
   "t": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ",
   "tc": "ويلࣱ يوميذࣲ للمكذبين"
  },
  {
   "n": 50,
   "t": "فَبِأَیِّ حَدِیثِۭ بَعۡدَهُۥ یُؤۡمِنُونَ",
   "tc": "فباي حديث بعده يؤمنون"
  }
 ]
}