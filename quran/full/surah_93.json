{
 "surah": 93,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلضُّحَىٰ",
   "tc": "والضحي"
  },
  {
   "n": 2,
   "t": "وَٱلَّیۡلِ إِذَا سَجَىٰ",
   "tc": "واليل اذا سجي"
  },
  {
   "n": 3,
   "t": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
   "tc": "ما ودعك ربك وما قلي"
  },
  {
   "n": 4,
   "t": "وَلَلۡـَٔاخِرَةُ خَیۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ",
   "tc": "وللاخره خيرࣱ لك من الاولي"
  },
  {
   "n": 5,
   "t": "وَلَسَوۡفَ یُعۡطِیكَ رَبُّكَ فَتَرۡضَىٰۤ",
   "tc": "ولسوف يعطيك ربك فترضي"
  },
  {
   "n": 6,
   "t": "أَلَمۡ یَجِدۡكَ یَتِیمࣰا فَـَٔاوَىٰ",
   "tc": "الم يجدك يتيمࣰا فاوي"
  },
  {
   "n": 7,
   "t": "وَوَجَدَكَ ضَاۤلࣰّا فَهَدَىٰ",
   "tc": "ووجدك ضالࣰا فهدي"
  },
  {
   "n": 8,
   "t": "وَوَجَدَكَ عَاۤىِٕلࣰا فَأَغۡنَىٰ",
   "tc": "ووجدك عايلࣰا فاغني"
  },
  {
   "n": 9,
   "t": "فَأَمَّا ٱلۡیَتِیمَ فَلَا تَقۡهَرۡ",
   "tc": "فاما اليتيم فلا تقهر"
  },
  {
   "n": 10,
   "t": "وَأَمَّا ٱلسَّاۤىِٕلَ فَلَا تَنۡهَرۡ",
   "tc": "واما السايل فلا تنهر"
  },
  {
   "n": 11,
   "t": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
   "tc": "واما بنعمه ربك فحدث"
  }
 ]
}