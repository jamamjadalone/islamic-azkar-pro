{
 "surah": 94,
 "ayahs": [
  {
   "n": 1,
   "t": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",
   "tc": "الم نشرح لك صدرك"
  },
  {
   "n": 2,
   "t": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ",
   "tc": "ووضعنا عنك وزرك"
  },
  {
   "n": 3,
   "t": "ٱلَّذِیۤ أَنقَضَ ظَهۡرَكَ",
   "tc": "الذي انقض ظهرك"
  },
  {
   "n": 4,
   "t": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
   "tc": "ورفعنا لك ذكرك"
  },
  {
   "n": 5,
   "t": "فَإِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرًا",
   "tc": "فان مع العسر يسرا"
  },
  {
   "n": 6,
   "t": "إِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرࣰا",
   "tc": "ان مع العسر يسرࣰا"
  },
  {
   "n": 7,
   "t": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ",
   "tc": "فاذا فرغت فانصب"
  },
  {
   "n": 8,
   "t": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب",
   "tc": "والي ربك فارغب"
  }
 ]
}