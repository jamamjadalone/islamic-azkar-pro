{"surah":86,"ayahs":[{"n":1,"t":"وَالسَّمَآءِ وَالطَّارِقِ ۟ۙ"},{"n":2,"t":"وَمَاۤ اَدْرٰىكَ مَا الطَّارِقُ ۟ۙ"},{"n":3,"t":"النَّجْمُ الثَّاقِبُ ۟ۙ"},{"n":4,"t":"اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَیْهَا حَافِظٌ ۟ؕ"},{"n":5,"t":"فَلْیَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ ۟ؕ"},{"n":6,"t":"خُلِقَ مِنْ مَّآءٍ دَافِقٍ ۟ۙ"},{"n":7,"t":"یَّخْرُجُ مِنْ بَیْنِ الصُّلْبِ وَالتَّرَآىِٕبِ ۟ؕ"},{"n":8,"t":"اِنَّهٗ عَلٰی رَجْعِهٖ لَقَادِرٌ ۟ؕ"},{"n":9,"t":"یَوْمَ تُبْلَی السَّرَآىِٕرُ ۟ۙ"},{"n":10,"t":"فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍ ۟ؕ"},{"n":11,"t":"وَالسَّمَآءِ ذَاتِ الرَّجْعِ ۟ۙ"},{"n":12,"t":"وَالْاَرْضِ ذَاتِ الصَّدْعِ ۟ۙ"},{"n":13,"t":"اِنَّهٗ لَقَوْلٌ فَصْلٌ ۟ۙ"},{"n":14,"t":"وَّمَا هُوَ بِالْهَزْلِ ۟ؕ"},{"n":15,"t":"اِنَّهُمْ یَكِیْدُوْنَ كَیْدًا ۟ۙ"},{"n":16,"t":"وَّاَكِیْدُ كَیْدًا ۟ۚۖ"},{"n":17,"t":"فَمَهِّلِ الْكٰفِرِیْنَ اَمْهِلْهُمْ رُوَیْدًا ۟۠"}]}