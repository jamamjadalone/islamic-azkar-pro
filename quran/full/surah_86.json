{
 "surah": 86,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلسَّمَاۤءِ وَٱلطَّارِقِ",
   "tc": "والسماء والطارق"
  },
  {
   "n": 2,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
   "tc": "وما ادريك ما الطارق"
  },
  {
   "n": 3,
   "t": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
   "tc": "النجم الثاقب"
  },
  {
   "n": 4,
   "t": "إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَیۡهَا حَافِظࣱ",
   "tc": "ان كل نفسࣲ لما عليها حافظࣱ"
  },
  {
   "n": 5,
   "t": "فَلۡیَنظُرِ ٱلۡإِنسَـٰنُ مِمَّ خُلِقَ",
   "tc": "فلينظر الانسن مم خلق"
  },
  {
   "n": 6,
   "t": "خُلِقَ مِن مَّاۤءࣲ دَافِقࣲ",
   "tc": "خلق من ماءࣲ دافقࣲ"
  },
  {
   "n": 7,
   "t": "یَخۡرُجُ مِنۢ بَیۡنِ ٱلصُّلۡبِ وَٱلتَّرَاۤىِٕبِ",
   "tc": "يخرج من بين الصلب والترايب"
  },
  {
   "n": 8,
   "t": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ",
   "tc": "انه علي رجعه لقادرࣱ"
  },
  {
   "n": 9,
   "t": "یَوۡمَ تُبۡلَى ٱلسَّرَاۤىِٕرُ",
   "tc": "يوم تبلي السراير"
  },
  {
   "n": 10,
   "t": "فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ",
   "tc": "فما له من قوهࣲ ولا ناصرࣲ"
  },
  {
   "n": 11,
   "t": "وَٱلسَّمَاۤءِ ذَاتِ ٱلرَّجۡعِ",
   "tc": "والسماء ذات الرجع"
  },
  {
   "n": 12,
   "t": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
   "tc": "والارض ذات الصدع"
  },
  {
   "n": 13,
   "t": "إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ",
   "tc": "انه لقولࣱ فصلࣱ"
  },
  {
   "n": 14,
   "t": "وَمَا هُوَ بِٱلۡهَزۡلِ",
   "tc": "وما هو بالهزل"
  },
  {
   "n": 15,
   "t": "إِنَّهُمۡ یَكِیدُونَ كَیۡدࣰا",
   "tc": "انهم يكيدون كيدࣰا"
  },
  {
   "n": 16,
   "t": "وَأَكِیدُ كَیۡدࣰا",
   "tc": "واكيد كيدࣰا"
  },
  {
   "n": 17,
   "t": "فَمَهِّلِ ٱلۡكَـٰفِرِینَ أَمۡهِلۡهُمۡ رُوَیۡدَۢا",
   "tc": "فمهل الكفرين امهلهم رويدا"
  }
 ]
}