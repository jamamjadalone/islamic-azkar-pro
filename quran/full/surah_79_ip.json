{"surah":79,"ayahs":[{"n":1,"t":"وَالنّٰزِعٰتِ غَرْقًا ۟ۙ"},{"n":2,"t":"وَّالنّٰشِطٰتِ نَشْطًا ۟ۙ"},{"n":3,"t":"وَّالسّٰبِحٰتِ سَبْحًا ۟ۙ"},{"n":4,"t":"فَالسّٰبِقٰتِ سَبْقًا ۟ۙ"},{"n":5,"t":"فَالْمُدَبِّرٰتِ اَمْرًا ۟ۘ"},{"n":6,"t":"یَوْمَ تَرْجُفُ الرَّاجِفَةُ ۟ۙ"},{"n":7,"t":"تَتْبَعُهَا الرَّادِفَةُ ۟ؕ"},{"n":8,"t":"قُلُوْبٌ یَّوْمَىِٕذٍ وَّاجِفَةٌ ۟ۙ"},{"n":9,"t":"اَبْصَارُهَا خَاشِعَةٌ ۟ۘ"},{"n":10,"t":"یَقُوْلُوْنَ ءَاِنَّا لَمَرْدُوْدُوْنَ فِی الْحَافِرَةِ ۟ؕ"},{"n":11,"t":"ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ۟ؕ"},{"n":12,"t":"قَالُوْا تِلْكَ اِذًا كَرَّةٌ خَاسِرَةٌ ۟ۘ"},{"n":13,"t":"فَاِنَّمَا هِیَ زَجْرَةٌ وَّاحِدَةٌ ۟ۙ"},{"n":14,"t":"فَاِذَا هُمْ بِالسَّاهِرَةِ ۟ؕ"},{"n":15,"t":"هَلْ اَتٰىكَ حَدِیْثُ مُوْسٰی ۟ۘ"},{"n":16,"t":"اِذْ نَادٰىهُ رَبُّهٗ بِالْوَادِ الْمُقَدَّسِ طُوًی ۟ۚ"},{"n":17,"t":"اِذْهَبْ اِلٰی فِرْعَوْنَ اِنَّهٗ طَغٰی ۟ؗۖ"},{"n":18,"t":"فَقُلْ هَلْ لَّكَ اِلٰۤی اَنْ تَزَكّٰی ۟ۙ"},{"n":19,"t":"وَاَهْدِیَكَ اِلٰی رَبِّكَ فَتَخْشٰی ۟ۚ"},{"n":20,"t":"فَاَرٰىهُ الْاٰیَةَ الْكُبْرٰی ۟ؗۖ"},{"n":21,"t":"فَكَذَّبَ وَعَصٰی ۟ؗۖ"},{"n":22,"t":"ثُمَّ اَدْبَرَ یَسْعٰی ۟ؗۖ"},{"n":23,"t":"فَحَشَرَ ۫— فَنَادٰی ۟ؗۖ"},{"n":24,"t":"فَقَالَ اَنَا رَبُّكُمُ الْاَعْلٰی ۟ؗۖ"},{"n":25,"t":"فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُوْلٰی ۟ؕ"},{"n":26,"t":"اِنَّ فِیْ ذٰلِكَ لَعِبْرَةً لِّمَنْ یَّخْشٰی ۟ؕ۠"},{"n":27,"t":"ءَاَنْتُمْ اَشَدُّ خَلْقًا اَمِ السَّمَآءُ ؕ— بَنٰىهَا ۟۫"},{"n":28,"t":"رَفَعَ سَمْكَهَا فَسَوّٰىهَا ۟ۙ"},{"n":29,"t":"وَاَغْطَشَ لَیْلَهَا وَاَخْرَجَ ضُحٰىهَا ۪۟"},{"n":30,"t":"وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰىهَا ۟ؕ"},{"n":31,"t":"اَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعٰىهَا ۪۟"},{"n":32,"t":"وَالْجِبَالَ اَرْسٰىهَا ۟ۙ"},{"n":33,"t":"مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۟ؕ"},{"n":34,"t":"فَاِذَا جَآءَتِ الطَّآمَّةُ الْكُبْرٰی ۟ؗۖ"},{"n":35,"t":"یَوْمَ یَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰی ۟ۙ"},{"n":36,"t":"وَبُرِّزَتِ الْجَحِیْمُ لِمَنْ یَّرٰی ۟"},{"n":37,"t":"فَاَمَّا مَنْ طَغٰی ۟ۙ"},{"n":38,"t":"وَاٰثَرَ الْحَیٰوةَ الدُّنْیَا ۟ۙ"},{"n":39,"t":"فَاِنَّ الْجَحِیْمَ هِیَ الْمَاْوٰی ۟ؕ"},{"n":40,"t":"وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّهٖ وَنَهَی النَّفْسَ عَنِ الْهَوٰی ۟ۙ"},{"n":41,"t":"فَاِنَّ الْجَنَّةَ هِیَ الْمَاْوٰی ۟ؕ"},{"n":42,"t":"یَسْـَٔلُوْنَكَ عَنِ السَّاعَةِ اَیَّانَ مُرْسٰىهَا ۟ؕ"},{"n":43,"t":"فِیْمَ اَنْتَ مِنْ ذِكْرٰىهَا ۟ؕ"},{"n":44,"t":"اِلٰی رَبِّكَ مُنْتَهٰىهَا ۟ؕ"},{"n":45,"t":"اِنَّمَاۤ اَنْتَ مُنْذِرُ مَنْ یَّخْشٰىهَا ۟ؕ"},{"n":46,"t":"كَاَنَّهُمْ یَوْمَ یَرَوْنَهَا لَمْ یَلْبَثُوْۤا اِلَّا عَشِیَّةً اَوْ ضُحٰىهَا ۟۠"}]}