{"surah":75,"ayahs":[{"n":1,"t":"لَاۤ اُقْسِمُ بِیَوْمِ الْقِیٰمَةِ ۟ۙ"},{"n":2,"t":"وَلَاۤ اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ ۟"},{"n":3,"t":"اَیَحْسَبُ الْاِنْسَانُ اَلَّنْ نَّجْمَعَ عِظَامَهٗ ۟ؕ"},{"n":4,"t":"بَلٰى قٰدِرِیْنَ عَلٰۤی اَنْ نُّسَوِّیَ بَنَانَهٗ ۟"},{"n":5,"t":"بَلْ یُرِیْدُ الْاِنْسَانُ لِیَفْجُرَ اَمَامَهٗ ۟ۚ"},{"n":6,"t":"یَسْـَٔلُ اَیَّانَ یَوْمُ الْقِیٰمَةِ ۟ؕ"},{"n":7,"t":"فَاِذَا بَرِقَ الْبَصَرُ ۟ۙ"},{"n":8,"t":"وَخَسَفَ الْقَمَرُ ۟ۙ"},{"n":9,"t":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ ۟ۙ"},{"n":10,"t":"یَقُوْلُ الْاِنْسَانُ یَوْمَىِٕذٍ اَیْنَ الْمَفَرُّ ۟ۚ"},{"n":11,"t":"كَلَّا لَا وَزَرَ ۟ؕ"},{"n":12,"t":"اِلٰى رَبِّكَ یَوْمَىِٕذِ ١لْمُسْتَقَرُّ ۟ؕ"},{"n":13,"t":"یُنَبَّؤُا الْاِنْسَانُ یَوْمَىِٕذٍ بِمَا قَدَّمَ وَاَخَّرَ ۟ؕ"},{"n":14,"t":"بَلِ الْاِنْسَانُ عَلٰی نَفْسِهٖ بَصِیْرَةٌ ۟ۙ"},{"n":15,"t":"وَّلَوْ اَلْقٰى مَعَاذِیْرَهٗ ۟ؕ"},{"n":16,"t":"لَا تُحَرِّكْ بِهٖ لِسَانَكَ لِتَعْجَلَ بِهٖ ۟ؕ"},{"n":17,"t":"اِنَّ عَلَیْنَا جَمْعَهٗ وَقُرْاٰنَهٗ ۟ۚۖ"},{"n":18,"t":"فَاِذَا قَرَاْنٰهُ فَاتَّبِعْ قُرْاٰنَهٗ ۟ۚ"},{"n":19,"t":"ثُمَّ اِنَّ عَلَیْنَا بَیَانَهٗ ۟ؕ"},{"n":20,"t":"كَلَّا بَلْ تُحِبُّوْنَ الْعَاجِلَةَ ۟ۙ"},{"n":21,"t":"وَتَذَرُوْنَ الْاٰخِرَةَ ۟ؕ"},{"n":22,"t":"وُجُوْهٌ یَّوْمَىِٕذٍ نَّاضِرَةٌ ۟ۙ"},{"n":23,"t":"اِلٰى رَبِّهَا نَاظِرَةٌ ۟ۚ"},{"n":24,"t":"وَوُجُوْهٌ یَّوْمَىِٕذٍ بَاسِرَةٌ ۟ۙ"},{"n":25,"t":"تَظُنُّ اَنْ یُّفْعَلَ بِهَا فَاقِرَةٌ ۟ؕ"},{"n":26,"t":"كَلَّاۤ اِذَا بَلَغَتِ التَّرَاقِیَ ۟ۙ"},{"n":27,"t":"وَقِیْلَ مَنْ ٚ— رَاقٍ ۟ۙ"},{"n":28,"t":"وَّظَنَّ اَنَّهُ الْفِرَاقُ ۟ۙ"},{"n":29,"t":"وَالْتَفَّتِ السَّاقُ بِالسَّاقِ ۟ۙ"},{"n":30,"t":"اِلٰى رَبِّكَ یَوْمَىِٕذِ ١لْمَسَاقُ ۟ؕ۠"},{"n":31,"t":"فَلَا صَدَّقَ وَلَا صَلّٰى ۟ۙ"},{"n":32,"t":"وَلٰكِنْ كَذَّبَ وَتَوَلّٰى ۟ۙ"},{"n":33,"t":"ثُمَّ ذَهَبَ اِلٰۤی اَهْلِهٖ یَتَمَطّٰى ۟ؕ"},{"n":34,"t":"اَوْلٰى لَكَ فَاَوْلٰى ۟ۙ"},{"n":35,"t":"ثُمَّ اَوْلٰى لَكَ فَاَوْلٰى ۟ؕ"},{"n":36,"t":"اَیَحْسَبُ الْاِنْسَانُ اَنْ یُّتْرَكَ سُدًی ۟ؕ"},{"n":37,"t":"اَلَمْ یَكُ نُطْفَةً مِّنْ مَّنِیٍّ یُّمْنٰى ۟ۙ"},{"n":38,"t":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰى ۟ۙ"},{"n":39,"t":"فَجَعَلَ مِنْهُ الزَّوْجَیْنِ الذَّكَرَ وَالْاُ ۟ؕ"},{"n":40,"t":"اَلَیْسَ ذٰلِكَ بِقٰدِرٍ عَلٰۤی اَنْ یُّحْیِ الْمَوْتٰى ۟۠"}]}