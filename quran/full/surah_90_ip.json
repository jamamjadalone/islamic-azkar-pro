{"surah":90,"ayahs":[{"n":1,"t":"لَاۤ اُقْسِمُ بِهٰذَا الْبَلَدِ ۟ۙ"},{"n":2,"t":"وَاَنْتَ حِلٌّۢ بِهٰذَا الْبَلَدِ ۟ۙ"},{"n":3,"t":"وَوَالِدٍ وَّمَا وَلَدَ ۟ۙ"},{"n":4,"t":"لَقَدْ خَلَقْنَا الْاِنْسَانَ فِیْ كَبَدٍ ۟ؕ"},{"n":5,"t":"اَیَحْسَبُ اَنْ لَّنْ یَّقْدِرَ عَلَیْهِ اَحَدٌ ۟ۘ"},{"n":6,"t":"یَقُوْلُ اَهْلَكْتُ مَالًا لُّبَدًا ۟ؕ"},{"n":7,"t":"اَیَحْسَبُ اَنْ لَّمْ یَرَهٗۤ اَحَدٌ ۟ؕ"},{"n":8,"t":"اَلَمْ نَجْعَلْ لَّهٗ عَیْنَیْنِ ۟ۙ"},{"n":9,"t":"وَلِسَانًا وَّشَفَتَیْنِ ۟ۙ"},{"n":10,"t":"وَهَدَیْنٰهُ النَّجْدَیْنِ ۟ۚ"},{"n":11,"t":"فَلَا اقْتَحَمَ الْعَقَبَةَ ۟ؗۖ"},{"n":12,"t":"وَمَاۤ اَدْرٰىكَ مَا الْعَقَبَةُ ۟ؕ"},{"n":13,"t":"فَكُّ رَقَبَةٍ ۟ۙ"},{"n":14,"t":"اَوْ اِطْعٰمٌ فِیْ یَوْمٍ ذِیْ مَسْغَبَةٍ ۟ۙ"},{"n":15,"t":"یَّتِیْمًا ذَا مَقْرَبَةٍ ۟ۙ"},{"n":16,"t":"اَوْ مِسْكِیْنًا ذَا مَتْرَبَةٍ ۟ؕ"},{"n":17,"t":"ثُمَّ كَانَ مِنَ الَّذِیْنَ اٰمَنُوْا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ ۟ؕ"},{"n":18,"t":"اُولٰٓىِٕكَ اَصْحٰبُ الْمَیْمَنَةِ ۟ؕ"},{"n":19,"t":"وَالَّذِیْنَ كَفَرُوْا بِاٰیٰتِنَا هُمْ اَصْحٰبُ الْمَشْـَٔمَةِ ۟ؕ"},{"n":20,"t":"عَلَیْهِمْ نَارٌ مُّؤْصَدَةٌ ۟۠"}]}