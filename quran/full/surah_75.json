{
 "surah": 75,
 "ayahs": [
  {
   "n": 1,
   "t": "لَاۤ أُقۡسِمُ بِیَوۡمِ ٱلۡقِیَـٰمَةِ",
   "tc": "لا اقسم بيوم القيمه"
  },
  {
   "n": 2,
   "t": "وَلَاۤ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ",
   "tc": "ولا اقسم بالنفس اللوامه"
  },
  {
   "n": 3,
   "t": "أَیَحۡسَبُ ٱلۡإِنسَـٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ",
   "tc": "ايحسب الانسن الن نجمع عظامه"
  },
  {
   "n": 4,
   "t": "بَلَىٰ قَـٰدِرِینَ عَلَىٰۤ أَن نُّسَوِّیَ بَنَانَهُۥ",
   "tc": "بلي قدرين علي ان نسوي بنانه"
  },
  {
   "n": 5,
   "t": "بَلۡ یُرِیدُ ٱلۡإِنسَـٰنُ لِیَفۡجُرَ أَمَامَهُۥ",
   "tc": "بل يريد الانسن ليفجر امامه"
  },
  {
   "n": 6,
   "t": "یَسۡـَٔلُ أَیَّانَ یَوۡمُ ٱلۡقِیَـٰمَةِ",
   "tc": "يسل ايان يوم القيمه"
  },
  {
   "n": 7,
   "t": "فَإِذَا بَرِقَ ٱلۡبَصَرُ",
   "tc": "فاذا برق البصر"
  },
  {
   "n": 8,
   "t": "وَخَسَفَ ٱلۡقَمَرُ",
   "tc": "وخسف القمر"
  },
  {
   "n": 9,
   "t": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ",
   "tc": "وجمع الشمس والقمر"
  },
  {
   "n": 10,
   "t": "یَقُولُ ٱلۡإِنسَـٰنُ یَوۡمَىِٕذٍ أَیۡنَ ٱلۡمَفَرُّ",
   "tc": "يقول الانسن يوميذ اين المفر"
  },
  {
   "n": 11,
   "t": "كَلَّا لَا وَزَرَ",
   "tc": "كلا لا وزر"
  },
  {
   "n": 12,
   "t": "إِلَىٰ رَبِّكَ یَوۡمَىِٕذٍ ٱلۡمُسۡتَقَرُّ",
   "tc": "الي ربك يوميذ المستقر"
  },
  {
   "n": 13,
   "t": "یُنَبَّؤُا۟ ٱلۡإِنسَـٰنُ یَوۡمَىِٕذِۭ بِمَا قَدَّمَ وَأَخَّرَ",
   "tc": "ينبؤا الانسن يوميذ بما قدم واخر"
  },
  {
   "n": 14,
   "t": "بَلِ ٱلۡإِنسَـٰنُ عَلَىٰ نَفۡسِهِۦ بَصِیرَةࣱ",
   "tc": "بل الانسن علي نفسه بصيرهࣱ"
  },
  {
   "n": 15,
   "t": "وَلَوۡ أَلۡقَىٰ مَعَاذِیرَهُۥ",
   "tc": "ولو القي معاذيره"
  },
  {
   "n": 16,
   "t": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦۤ",
   "tc": "لا تحرك به لسانك لتعجل به"
  },
  {
   "n": 17,
   "t": "إِنَّ عَلَیۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ",
   "tc": "ان علينا جمعه وقرءانه"
  },
  {
   "n": 18,
   "t": "فَإِذَا قَرَأۡنَـٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ",
   "tc": "فاذا قرانه فاتبع قرءانه"
  },
  {
   "n": 19,
   "t": "ثُمَّ إِنَّ عَلَیۡنَا بَیَانَهُۥ",
   "tc": "ثم ان علينا بيانه"
  },
  {
   "n": 20,
   "t": "كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ",
   "tc": "كلا بل تحبون العاجله"
  },
  {
   "n": 21,
   "t": "وَتَذَرُونَ ٱلۡـَٔاخِرَةَ",
   "tc": "وتذرون الاخره"
  },
  {
   "n": 22,
   "t": "وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاضِرَةٌ",
   "tc": "وجوهࣱ يوميذࣲ ناضره"
  },
  {
   "n": 23,
   "t": "إِلَىٰ رَبِّهَا نَاظِرَةࣱ",
   "tc": "الي ربها ناظرهࣱ"
  },
  {
   "n": 24,
   "t": "وَوُجُوهࣱ یَوۡمَىِٕذِۭ بَاسِرَةࣱ",
   "tc": "ووجوهࣱ يوميذ باسرهࣱ"
  },
  {
   "n": 25,
   "t": "تَظُنُّ أَن یُفۡعَلَ بِهَا فَاقِرَةࣱ",
   "tc": "تظن ان يفعل بها فاقرهࣱ"
  },
  {
   "n": 26,
   "t": "كَلَّاۤ إِذَا بَلَغَتِ ٱلتَّرَاقِیَ",
   "tc": "كلا اذا بلغت التراقي"
  },
  {
   "n": 27,
   "t": "وَقِیلَ مَنۡۜ رَاقࣲ",
   "tc": "وقيل من راقࣲ"
  },
  {
   "n": 28,
   "t": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ",
   "tc": "وظن انه الفراق"
  },
  {
   "n": 29,
   "t": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
   "tc": "والتفت الساق بالساق"
  },
  {
   "n": 30,
   "t": "إِلَىٰ رَبِّكَ یَوۡمَىِٕذٍ ٱلۡمَسَاقُ",
   "tc": "الي ربك يوميذ المساق"
  },
  {
   "n": 31,
   "t": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
   "tc": "فلا صدق ولا صلي"
  },
  {
   "n": 32,
   "t": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ",
   "tc": "ولكن كذب وتولي"
  },
  {
   "n": 33,
   "t": "ثُمَّ ذَهَبَ إِلَىٰۤ أَهۡلِهِۦ یَتَمَطَّىٰۤ",
   "tc": "ثم ذهب الي اهله يتمطي"
  },
  {
   "n": 34,
   "t": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ",
   "tc": "اولي لك فاولي"
  },
  {
   "n": 35,
   "t": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰۤ",
   "tc": "ثم اولي لك فاولي"
  },
  {
   "n": 36,
   "t": "أَیَحۡسَبُ ٱلۡإِنسَـٰنُ أَن یُتۡرَكَ سُدًى",
   "tc": "ايحسب الانسن ان يترك سدي"
  },
  {
   "n": 37,
   "t": "أَلَمۡ یَكُ نُطۡفَةࣰ مِّن مَّنِیࣲّ یُمۡنَىٰ",
   "tc": "الم يك نطفهࣰ من منيࣲ يمني"
  },
  {
   "n": 38,
   "t": "ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ",
   "tc": "ثم كان علقهࣰ فخلق فسوي"
  },
  {
   "n": 39,
   "t": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَیۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰۤ",
   "tc": "فجعل منه الزوجين الذكر والانثي"
  },
  {
   "n": 40,
   "t": "أَلَیۡسَ ذَ ٰ⁠لِكَ بِقَـٰدِرٍ عَلَىٰۤ أَن یُحۡـِۧیَ ٱلۡمَوۡتَىٰ",
   "tc": "اليس ذ لك بقدر علي ان يحي الموتي"
  }
 ]
}