{
 "surah": 79,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلنَّـٰزِعَـٰتِ غَرۡقࣰا",
   "tc": "والنزعت غرقࣰا"
  },
  {
   "n": 2,
   "t": "وَٱلنَّـٰشِطَـٰتِ نَشۡطࣰا",
   "tc": "والنشطت نشطࣰا"
  },
  {
   "n": 3,
   "t": "وَٱلسَّـٰبِحَـٰتِ سَبۡحࣰا",
   "tc": "والسبحت سبحࣰا"
  },
  {
   "n": 4,
   "t": "فَٱلسَّـٰبِقَـٰتِ سَبۡقࣰا",
   "tc": "فالسبقت سبقࣰا"
  },
  {
   "n": 5,
   "t": "فَٱلۡمُدَبِّرَ ٰ⁠تِ أَمۡرࣰا",
   "tc": "فالمدبر ت امرࣰا"
  },
  {
   "n": 6,
   "t": "یَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ",
   "tc": "يوم ترجف الراجفه"
  },
  {
   "n": 7,
   "t": "تَتۡبَعُهَا ٱلرَّادِفَةُ",
   "tc": "تتبعها الرادفه"
  },
  {
   "n": 8,
   "t": "قُلُوبࣱ یَوۡمَىِٕذࣲ وَاجِفَةٌ",
   "tc": "قلوبࣱ يوميذࣲ واجفه"
  },
  {
   "n": 9,
   "t": "أَبۡصَـٰرُهَا خَـٰشِعَةࣱ",
   "tc": "ابصرها خشعهࣱ"
  },
  {
   "n": 10,
   "t": "یَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِی ٱلۡحَافِرَةِ",
   "tc": "يقولون اءنا لمردودون في الحافره"
  },
  {
   "n": 11,
   "t": "أَءِذَا كُنَّا عِظَـٰمࣰا نَّخِرَةࣰ",
   "tc": "اءذا كنا عظمࣰا نخرهࣰ"
  },
  {
   "n": 12,
   "t": "قَالُوا۟ تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ",
   "tc": "قالوا تلك اذࣰا كره خاسرهࣱ"
  },
  {
   "n": 13,
   "t": "فَإِنَّمَا هِیَ زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ",
   "tc": "فانما هي زجرهࣱ و حدهࣱ"
  },
  {
   "n": 14,
   "t": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
   "tc": "فاذا هم بالساهره"
  },
  {
   "n": 15,
   "t": "هَلۡ أَتَىٰكَ حَدِیثُ مُوسَىٰۤ",
   "tc": "هل اتيك حديث موسي"
  },
  {
   "n": 16,
   "t": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى",
   "tc": "اذ ناديه ربه بالواد المقدس طوي"
  },
  {
   "n": 17,
   "t": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",
   "tc": "اذهب الي فرعون انه طغي"
  },
  {
   "n": 18,
   "t": "فَقُلۡ هَل لَّكَ إِلَىٰۤ أَن تَزَكَّىٰ",
   "tc": "فقل هل لك الي ان تزكي"
  },
  {
   "n": 19,
   "t": "وَأَهۡدِیَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ",
   "tc": "واهديك الي ربك فتخشي"
  },
  {
   "n": 20,
   "t": "فَأَرَىٰهُ ٱلۡـَٔایَةَ ٱلۡكُبۡرَىٰ",
   "tc": "فاريه الايه الكبري"
  },
  {
   "n": 21,
   "t": "فَكَذَّبَ وَعَصَىٰ",
   "tc": "فكذب وعصي"
  },
  {
   "n": 22,
   "t": "ثُمَّ أَدۡبَرَ یَسۡعَىٰ",
   "tc": "ثم ادبر يسعي"
  },
  {
   "n": 23,
   "t": "فَحَشَرَ فَنَادَىٰ",
   "tc": "فحشر فنادي"
  },
  {
   "n": 24,
   "t": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ",
   "tc": "فقال انا ربكم الاعلي"
  },
  {
   "n": 25,
   "t": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡـَٔاخِرَةِ وَٱلۡأُولَىٰۤ",
   "tc": "فاخذه الله نكال الاخره والاولي"
  },
  {
   "n": 26,
   "t": "إِنَّ فِی ذَ ٰ⁠لِكَ لَعِبۡرَةࣰ لِّمَن یَخۡشَىٰۤ",
   "tc": "ان في ذ لك لعبرهࣰ لمن يخشي"
  },
  {
   "n": 27,
   "t": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَاۤءُۚ بَنَىٰهَا",
   "tc": "ءانتم اشد خلقا ام السماء بنيها"
  },
  {
   "n": 28,
   "t": "رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا",
   "tc": "رفع سمكها فسويها"
  },
  {
   "n": 29,
   "t": "وَأَغۡطَشَ لَیۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا",
   "tc": "واغطش ليلها واخرج ضحيها"
  },
  {
   "n": 30,
   "t": "وَٱلۡأَرۡضَ بَعۡدَ ذَ ٰ⁠لِكَ دَحَىٰهَاۤ",
   "tc": "والارض بعد ذ لك دحيها"
  },
  {
   "n": 31,
   "t": "أَخۡرَجَ مِنۡهَا مَاۤءَهَا وَمَرۡعَىٰهَا",
   "tc": "اخرج منها ماءها ومرعيها"
  },
  {
   "n": 32,
   "t": "وَٱلۡجِبَالَ أَرۡسَىٰهَا",
   "tc": "والجبال ارسيها"
  },
  {
   "n": 33,
   "t": "مَتَـٰعࣰا لَّكُمۡ وَلِأَنۡعَـٰمِكُمۡ",
   "tc": "متعࣰا لكم ولانعمكم"
  },
  {
   "n": 34,
   "t": "فَإِذَا جَاۤءَتِ ٱلطَّاۤمَّةُ ٱلۡكُبۡرَىٰ",
   "tc": "فاذا جاءت الطامه الكبري"
  },
  {
   "n": 35,
   "t": "یَوۡمَ یَتَذَكَّرُ ٱلۡإِنسَـٰنُ مَا سَعَىٰ",
   "tc": "يوم يتذكر الانسن ما سعي"
  },
  {
   "n": 36,
   "t": "وَبُرِّزَتِ ٱلۡجَحِیمُ لِمَن یَرَىٰ",
   "tc": "وبرزت الجحيم لمن يري"
  },
  {
   "n": 37,
   "t": "فَأَمَّا مَن طَغَىٰ",
   "tc": "فاما من طغي"
  },
  {
   "n": 38,
   "t": "وَءَاثَرَ ٱلۡحَیَوٰةَ ٱلدُّنۡیَا",
   "tc": "وءاثر الحيوه الدنيا"
  },
  {
   "n": 39,
   "t": "فَإِنَّ ٱلۡجَحِیمَ هِیَ ٱلۡمَأۡوَىٰ",
   "tc": "فان الجحيم هي الماوي"
  },
  {
   "n": 40,
   "t": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ",
   "tc": "واما من خاف مقام ربه ونهي النفس عن الهوي"
  },
  {
   "n": 41,
   "t": "فَإِنَّ ٱلۡجَنَّةَ هِیَ ٱلۡمَأۡوَىٰ",
   "tc": "فان الجنه هي الماوي"
  },
  {
   "n": 42,
   "t": "یَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَیَّانَ مُرۡسَىٰهَا",
   "tc": "يسلونك عن الساعه ايان مرسيها"
  },
  {
   "n": 43,
   "t": "فِیمَ أَنتَ مِن ذِكۡرَىٰهَاۤ",
   "tc": "فيم انت من ذكريها"
  },
  {
   "n": 44,
   "t": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَاۤ",
   "tc": "الي ربك منتهيها"
  },
  {
   "n": 45,
   "t": "إِنَّمَاۤ أَنتَ مُنذِرُ مَن یَخۡشَىٰهَا",
   "tc": "انما انت منذر من يخشيها"
  },
  {
   "n": 46,
   "t": "كَأَنَّهُمۡ یَوۡمَ یَرَوۡنَهَا لَمۡ یَلۡبَثُوۤا۟ إِلَّا عَشِیَّةً أَوۡ ضُحَىٰهَا",
   "tc": "كانهم يوم يرونها لم يلبثوا الا عشيه او ضحيها"
  }
 ]
}