  },
  {
   "n": 180,
   "t": "سُبۡحَـٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا یَصِفُونَ",
   "tc": "سبحن ربك رب العزه عما يصفون"
  },
  {
   "n": 181,
   "t": "وَسَلَـٰمٌ عَلَى ٱلۡمُرۡسَلِینَ",
   "tc": "وسلم علي المرسلين"
  },
  {
   "n": 182,
   "t": "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَـٰلَمِینَ",
   "tc": "والحمد لله رب العلمين"
  }
 ]
