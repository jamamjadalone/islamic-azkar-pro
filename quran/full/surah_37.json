{
 "surah": 37,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلصَّـٰۤفَّـٰتِ صَفࣰّا",
   "tc": "والصفت صفࣰا"
  },
  {
   "n": 2,
   "t": "فَٱلزَّ ٰ⁠جِرَ ٰ⁠تِ زَجۡرࣰا",
   "tc": "فالز جر ت زجرࣰا"
  },
  {
   "n": 3,
   "t": "فَٱلتَّـٰلِیَـٰتِ ذِكۡرًا",
   "tc": "فالتليت ذكرا"
  },
  {
   "n": 4,
   "t": "إِنَّ إِلَـٰهَكُمۡ لَوَ ٰ⁠حِدࣱ",
   "tc": "ان الهكم لو حدࣱ"
  },
  {
   "n": 5,
   "t": "رَّبُّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَا وَرَبُّ ٱلۡمَشَـٰرِقِ",
   "tc": "رب السمو ت والارض وما بينهما ورب المشرق"
  },
  {
   "n": 6,
   "t": "إِنَّا زَیَّنَّا ٱلسَّمَاۤءَ ٱلدُّنۡیَا بِزِینَةٍ ٱلۡكَوَاكِبِ",
   "tc": "انا زينا السماء الدنيا بزينه الكواكب"
  },
  {
   "n": 7,
   "t": "وَحِفۡظࣰا مِّن كُلِّ شَیۡطَـٰنࣲ مَّارِدࣲ",
   "tc": "وحفظࣰا من كل شيطنࣲ ماردࣲ"
  },
  {
   "n": 8,
   "t": "لَّا یَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَیُقۡذَفُونَ مِن كُلِّ جَانِبࣲ",
   "tc": "لا يسمعون الي الملا الاعلي ويقذفون من كل جانبࣲ"
  },
  {
   "n": 9,
   "t": "دُحُورࣰاۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ",
   "tc": "دحورࣰا ولهم عذابࣱ واصب"
  },
  {
   "n": 10,
   "t": "إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ",
   "tc": "الا من خطف الخطفه فاتبعه شهابࣱ ثاقبࣱ"
  },
  {
   "n": 11,
   "t": "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَاۤۚ إِنَّا خَلَقۡنَـٰهُم مِّن طِینࣲ لَّازِبِۭ",
   "tc": "فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقنهم من طينࣲ لازب"
  },
  {
   "n": 12,
   "t": "بَلۡ عَجِبۡتَ وَیَسۡخَرُونَ",
   "tc": "بل عجبت ويسخرون"
  },
  {
   "n": 13,
   "t": "وَإِذَا ذُكِّرُوا۟ لَا یَذۡكُرُونَ",
   "tc": "واذا ذكروا لا يذكرون"
  },
  {
   "n": 14,
   "t": "وَإِذَا رَأَوۡا۟ ءَایَةࣰ یَسۡتَسۡخِرُونَ",
   "tc": "واذا راوا ءايهࣰ يستسخرون"
  },
  {
   "n": 15,
   "t": "وَقَالُوۤا۟ إِنۡ هَـٰذَاۤ إِلَّا سِحۡرࣱ مُّبِینٌ",
   "tc": "وقالوا ان هذا الا سحرࣱ مبين"
  },
  {
   "n": 16,
   "t": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
   "tc": "اءذا متنا وكنا ترابࣰا وعظما اءنا لمبعوثون"
  },
  {
   "n": 17,
   "t": "أَوَءَابَاۤؤُنَا ٱلۡأَوَّلُونَ",
   "tc": "اوءاباؤنا الاولون"
  },
  {
   "n": 18,
   "t": "قُلۡ نَعَمۡ وَأَنتُمۡ دَ ٰ⁠خِرُونَ",
   "tc": "قل نعم وانتم د خرون"
  },
  {
   "n": 19,
   "t": "فَإِنَّمَا هِیَ زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ فَإِذَا هُمۡ یَنظُرُونَ",
   "tc": "فانما هي زجرهࣱ و حدهࣱ فاذا هم ينظرون"
  },
  {
   "n": 20,
   "t": "وَقَالُوا۟ یَـٰوَیۡلَنَا هَـٰذَا یَوۡمُ ٱلدِّینِ",
   "tc": "وقالوا يويلنا هذا يوم الدين"
  },
  {
   "n": 21,
   "t": "هَـٰذَا یَوۡمُ ٱلۡفَصۡلِ ٱلَّذِی كُنتُم بِهِۦ تُكَذِّبُونَ",
   "tc": "هذا يوم الفصل الذي كنتم به تكذبون"
  },
  {
   "n": 22,
   "t": "۞ ٱحۡشُرُوا۟ ٱلَّذِینَ ظَلَمُوا۟ وَأَزۡوَ ٰ⁠جَهُمۡ وَمَا كَانُوا۟ یَعۡبُدُونَ",
   "tc": "احشروا الذين ظلموا وازو جهم وما كانوا يعبدون"
  },
  {
   "n": 23,
   "t": "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَ ٰ⁠طِ ٱلۡجَحِیمِ",
   "tc": "من دون الله فاهدوهم الي صر ط الجحيم"
  },
  {
   "n": 24,
   "t": "وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ",
   "tc": "وقفوهم انهم مسولون"
  },
  {
   "n": 25,
   "t": "مَا لَكُمۡ لَا تَنَاصَرُونَ",
   "tc": "ما لكم لا تناصرون"
  },
  {
   "n": 26,
   "t": "بَلۡ هُمُ ٱلۡیَوۡمَ مُسۡتَسۡلِمُونَ",
   "tc": "بل هم اليوم مستسلمون"
  },
  {
   "n": 27,
   "t": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ یَتَسَاۤءَلُونَ",
   "tc": "واقبل بعضهم علي بعضࣲ يتساءلون"
  },
  {
   "n": 28,
   "t": "قَالُوۤا۟ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡیَمِینِ",
   "tc": "قالوا انكم كنتم تاتوننا عن اليمين"
  },
  {
   "n": 29,
   "t": "قَالُوا۟ بَل لَّمۡ تَكُونُوا۟ مُؤۡمِنِینَ",
   "tc": "قالوا بل لم تكونوا مؤمنين"
  },
  {
   "n": 30,
   "t": "وَمَا كَانَ لَنَا عَلَیۡكُم مِّن سُلۡطَـٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰا طَـٰغِینَ",
   "tc": "وما كان لنا عليكم من سلطن بل كنتم قومࣰا طغين"
  },
  {
   "n": 31,
   "t": "فَحَقَّ عَلَیۡنَا قَوۡلُ رَبِّنَاۤۖ إِنَّا لَذَاۤىِٕقُونَ",
   "tc": "فحق علينا قول ربنا انا لذايقون"
  },
  {
   "n": 32,
   "t": "فَأَغۡوَیۡنَـٰكُمۡ إِنَّا كُنَّا غَـٰوِینَ",
   "tc": "فاغوينكم انا كنا غوين"
  },
  {
   "n": 33,
   "t": "فَإِنَّهُمۡ یَوۡمَىِٕذࣲ فِی ٱلۡعَذَابِ مُشۡتَرِكُونَ",
   "tc": "فانهم يوميذࣲ في العذاب مشتركون"
  },
  {
   "n": 34,
   "t": "إِنَّا كَذَ ٰ⁠لِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِینَ",
   "tc": "انا كذ لك نفعل بالمجرمين"
  },
  {
   "n": 35,
   "t": "إِنَّهُمۡ كَانُوۤا۟ إِذَا قِیلَ لَهُمۡ لَاۤ إِلَـٰهَ إِلَّا ٱللَّهُ یَسۡتَكۡبِرُونَ",
   "tc": "انهم كانوا اذا قيل لهم لا اله الا الله يستكبرون"
  },
  {
   "n": 36,
   "t": "وَیَقُولُونَ أَىِٕنَّا لَتَارِكُوۤا۟ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ",
   "tc": "ويقولون اينا لتاركوا ءالهتنا لشاعرࣲ مجنون"
  },
  {
   "n": 37,
   "t": "بَلۡ جَاۤءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِینَ",
   "tc": "بل جاء بالحق وصدق المرسلين"
  },
  {
   "n": 38,
   "t": "إِنَّكُمۡ لَذَاۤىِٕقُوا۟ ٱلۡعَذَابِ ٱلۡأَلِیمِ",
   "tc": "انكم لذايقوا العذاب الاليم"
  },
  {
   "n": 39,
   "t": "وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ",
   "tc": "وما تجزون الا ما كنتم تعملون"
  },
  {
   "n": 40,
   "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ",
   "tc": "الا عباد الله المخلصين"
  },
  {
   "n": 41,
   "t": "أُو۟لَـٰۤىِٕكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ",
   "tc": "اوليك لهم رزقࣱ معلومࣱ"
  },
  {
   "n": 42,
   "t": "فَوَ ٰ⁠كِهُ وَهُم مُّكۡرَمُونَ",
   "tc": "فو كه وهم مكرمون"
  },
  {
   "n": 43,
   "t": "فِی جَنَّـٰتِ ٱلنَّعِیمِ",
   "tc": "في جنت النعيم"
  },
  {
   "n": 44,
   "t": "عَلَىٰ سُرُرࣲ مُّتَقَـٰبِلِینَ",
   "tc": "علي سررࣲ متقبلين"
  },
  {
   "n": 45,
   "t": "یُطَافُ عَلَیۡهِم بِكَأۡسࣲ مِّن مَّعِینِۭ",
   "tc": "يطاف عليهم بكاسࣲ من معين"
  },
  {
   "n": 46,
   "t": "بَیۡضَاۤءَ لَذَّةࣲ لِّلشَّـٰرِبِینَ",
   "tc": "بيضاء لذهࣲ للشربين"
  },
  {
   "n": 47,
   "t": "لَا فِیهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا یُنزَفُونَ",
   "tc": "لا فيها غولࣱ ولا هم عنها ينزفون"
  },
  {
   "n": 48,
   "t": "وَعِندَهُمۡ قَـٰصِرَ ٰ⁠تُ ٱلطَّرۡفِ عِینࣱ",
   "tc": "وعندهم قصر ت الطرف عينࣱ"
  },
  {
   "n": 49,
   "t": "كَأَنَّهُنَّ بَیۡضࣱ مَّكۡنُونࣱ",
   "tc": "كانهن بيضࣱ مكنونࣱ"
  },
  {
   "n": 50,
   "t": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ یَتَسَاۤءَلُونَ",
   "tc": "فاقبل بعضهم علي بعضࣲ يتساءلون"
  },
  {
   "n": 51,
   "t": "قَالَ قَاۤىِٕلࣱ مِّنۡهُمۡ إِنِّی كَانَ لِی قَرِینࣱ",
   "tc": "قال قايلࣱ منهم اني كان لي قرينࣱ"
  },
  {
   "n": 52,
   "t": "یَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِینَ",
   "tc": "يقول اءنك لمن المصدقين"
  },
  {
   "n": 53,
   "t": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَدِینُونَ",
   "tc": "اءذا متنا وكنا ترابࣰا وعظما اءنا لمدينون"
  },
  {
   "n": 54,
   "t": "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ",
   "tc": "قال هل انتم مطلعون"
  },
  {
   "n": 55,
   "t": "فَٱطَّلَعَ فَرَءَاهُ فِی سَوَاۤءِ ٱلۡجَحِیمِ",
   "tc": "فاطلع فرءاه في سواء الجحيم"
  },
  {
   "n": 56,
   "t": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِینِ",
   "tc": "قال تالله ان كدت لتردين"
  },
  {
   "n": 57,
   "t": "وَلَوۡلَا نِعۡمَةُ رَبِّی لَكُنتُ مِنَ ٱلۡمُحۡضَرِینَ",
   "tc": "ولولا نعمه ربي لكنت من المحضرين"
  },
  {
   "n": 58,
   "t": "أَفَمَا نَحۡنُ بِمَیِّتِینَ",
   "tc": "افما نحن بميتين"
  },
  {
   "n": 59,
   "t": "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِینَ",
   "tc": "الا موتتنا الاولي وما نحن بمعذبين"
  },
  {
   "n": 60,
   "t": "إِنَّ هَـٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِیمُ",
   "tc": "ان هذا لهو الفوز العظيم"
  },
  {
   "n": 61,
   "t": "لِمِثۡلِ هَـٰذَا فَلۡیَعۡمَلِ ٱلۡعَـٰمِلُونَ",
   "tc": "لمثل هذا فليعمل العملون"
  },
  {
   "n": 62,
   "t": "أَذَ ٰ⁠لِكَ خَیۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ",
   "tc": "اذ لك خيرࣱ نزلا ام شجره الزقوم"
  },
  {
   "n": 63,
   "t": "إِنَّا جَعَلۡنَـٰهَا فِتۡنَةࣰ لِّلظَّـٰلِمِینَ",
   "tc": "انا جعلنها فتنهࣰ للظلمين"
  },
  {
   "n": 64,
   "t": "إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِیۤ أَصۡلِ ٱلۡجَحِیمِ",
   "tc": "انها شجرهࣱ تخرج في اصل الجحيم"
  },
  {
   "n": 65,
   "t": "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّیَـٰطِینِ",
   "tc": "طلعها كانه رءوس الشيطين"
  },
  {
   "n": 66,
   "t": "فَإِنَّهُمۡ لَـَٔاكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
   "tc": "فانهم لاكلون منها فمالون منها البطون"
  },
  {
   "n": 67,
   "t": "ثُمَّ إِنَّ لَهُمۡ عَلَیۡهَا لَشَوۡبࣰا مِّنۡ حَمِیمࣲ",
   "tc": "ثم ان لهم عليها لشوبࣰا من حميمࣲ"
  },
  {
   "n": 68,
   "t": "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِیمِ",
   "tc": "ثم ان مرجعهم لالي الجحيم"
  },
  {
   "n": 69,
   "t": "إِنَّهُمۡ أَلۡفَوۡا۟ ءَابَاۤءَهُمۡ ضَاۤلِّینَ",
   "tc": "انهم الفوا ءاباءهم ضالين"
  },
  {
   "n": 70,
   "t": "فَهُمۡ عَلَىٰۤ ءَاثَـٰرِهِمۡ یُهۡرَعُونَ",
   "tc": "فهم علي ءاثرهم يهرعون"
  },
  {
   "n": 71,
   "t": "وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِینَ",
   "tc": "ولقد ضل قبلهم اكثر الاولين"
  },
  {
   "n": 72,
   "t": "وَلَقَدۡ أَرۡسَلۡنَا فِیهِم مُّنذِرِینَ",
   "tc": "ولقد ارسلنا فيهم منذرين"
  },
  {
   "n": 73,
   "t": "فَٱنظُرۡ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلۡمُنذَرِینَ",
   "tc": "فانظر كيف كان عقبه المنذرين"
  },
  {
   "n": 74,
   "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ",
   "tc": "الا عباد الله المخلصين"
  },
  {
