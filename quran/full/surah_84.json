{
 "surah": 84,
 "ayahs": [
  {
   "n": 1,
   "t": "إِذَا ٱلسَّمَاۤءُ ٱنشَقَّتۡ",
   "tc": "اذا السماء انشقت"
  },
  {
   "n": 2,
   "t": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
   "tc": "واذنت لربها وحقت"
  },
  {
   "n": 3,
   "t": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ",
   "tc": "واذا الارض مدت"
  },
  {
   "n": 4,
   "t": "وَأَلۡقَتۡ مَا فِیهَا وَتَخَلَّتۡ",
   "tc": "والقت ما فيها وتخلت"
  },
  {
   "n": 5,
   "t": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
   "tc": "واذنت لربها وحقت"
  },
  {
   "n": 6,
   "t": "یَـٰۤأَیُّهَا ٱلۡإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰا فَمُلَـٰقِیهِ",
   "tc": "يايها الانسن انك كادح الي ربك كدحࣰا فملقيه"
  },
  {
   "n": 7,
   "t": "فَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِیَمِینِهِۦ",
   "tc": "فاما من اوتي كتبه بيمينه"
  },
  {
   "n": 8,
   "t": "فَسَوۡفَ یُحَاسَبُ حِسَابࣰا یَسِیرࣰا",
   "tc": "فسوف يحاسب حسابࣰا يسيرࣰا"
  },
  {
   "n": 9,
   "t": "وَیَنقَلِبُ إِلَىٰۤ أَهۡلِهِۦ مَسۡرُورࣰا",
   "tc": "وينقلب الي اهله مسرورࣰا"
  },
  {
   "n": 10,
   "t": "وَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ وَرَاۤءَ ظَهۡرِهِۦ",
   "tc": "واما من اوتي كتبه وراء ظهره"
  },
  {
   "n": 11,
   "t": "فَسَوۡفَ یَدۡعُوا۟ ثُبُورࣰا",
   "tc": "فسوف يدعوا ثبورࣰا"
  },
  {
   "n": 12,
   "t": "وَیَصۡلَىٰ سَعِیرًا",
   "tc": "ويصلي سعيرا"
  },
  {
   "n": 13,
   "t": "إِنَّهُۥ كَانَ فِیۤ أَهۡلِهِۦ مَسۡرُورًا",
   "tc": "انه كان في اهله مسرورا"
  },
  {
   "n": 14,
   "t": "إِنَّهُۥ ظَنَّ أَن لَّن یَحُورَ",
   "tc": "انه ظن ان لن يحور"
  },
  {
   "n": 15,
   "t": "بَلَىٰۤۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِیرࣰا",
   "tc": "بلي ان ربه كان به بصيرࣰا"
  },
  {
   "n": 16,
   "t": "فَلَاۤ أُقۡسِمُ بِٱلشَّفَقِ",
   "tc": "فلا اقسم بالشفق"
  },
  {
   "n": 17,
   "t": "وَٱلَّیۡلِ وَمَا وَسَقَ",
   "tc": "واليل وما وسق"
  },
  {
   "n": 18,
   "t": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ",
   "tc": "والقمر اذا اتسق"
  },
  {
   "n": 19,
   "t": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ",
   "tc": "لتركبن طبقا عن طبقࣲ"
  },
  {
   "n": 20,
   "t": "فَمَا لَهُمۡ لَا یُؤۡمِنُونَ",
   "tc": "فما لهم لا يؤمنون"
  },
  {
   "n": 21,
   "t": "وَإِذَا قُرِئَ عَلَیۡهِمُ ٱلۡقُرۡءَانُ لَا یَسۡجُدُونَ ۩",
   "tc": "واذا قرئ عليهم القرءان لا يسجدون"
  },
  {
   "n": 22,
   "t": "بَلِ ٱلَّذِینَ كَفَرُوا۟ یُكَذِّبُونَ",
   "tc": "بل الذين كفروا يكذبون"
  },
  {
   "n": 23,
   "t": "وَٱللَّهُ أَعۡلَمُ بِمَا یُوعُونَ",
   "tc": "والله اعلم بما يوعون"
  },
  {
   "n": 24,
   "t": "فَبَشِّرۡهُم بِعَذَابٍ أَلِیمٍ",
   "tc": "فبشرهم بعذاب اليم"
  },
  {
   "n": 25,
   "t": "إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمۡ أَجۡرٌ غَیۡرُ مَمۡنُونِۭ",
   "tc": "الا الذين ءامنوا وعملوا الصلحت لهم اجر غير ممنون"
  }
 ]
}