{
 "surah": 105,
 "ayahs": [
  {
   "n": 1,
   "t": "أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِأَصۡحَـٰبِ ٱلۡفِیلِ",
   "tc": "الم تر كيف فعل ربك باصحب الفيل"
  },
  {
   "n": 2,
   "t": "أَلَمۡ یَجۡعَلۡ كَیۡدَهُمۡ فِی تَضۡلِیلࣲ",
   "tc": "الم يجعل كيدهم في تضليلࣲ"
  },
  {
   "n": 3,
   "t": "وَأَرۡسَلَ عَلَیۡهِمۡ طَیۡرًا أَبَابِیلَ",
   "tc": "وارسل عليهم طيرا ابابيل"
  },
  {
   "n": 4,
   "t": "تَرۡمِیهِم بِحِجَارَةࣲ مِّن سِجِّیلࣲ",
   "tc": "ترميهم بحجارهࣲ من سجيلࣲ"
  },
  {
   "n": 5,
   "t": "فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ",
   "tc": "فجعلهم كعصفࣲ ماكول"
  }
 ]
}