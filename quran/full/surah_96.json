{
 "surah": 96,
 "ayahs": [
  {
   "n": 1,
   "t": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِی خَلَقَ",
   "tc": "اقرا باسم ربك الذي خلق"
  },
  {
   "n": 2,
   "t": "خَلَقَ ٱلۡإِنسَـٰنَ مِنۡ عَلَقٍ",
   "tc": "خلق الانسن من علق"
  },
  {
   "n": 3,
   "t": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ",
   "tc": "اقرا وربك الاكرم"
  },
  {
   "n": 4,
   "t": "ٱلَّذِی عَلَّمَ بِٱلۡقَلَمِ",
   "tc": "الذي علم بالقلم"
  },
  {
   "n": 5,
   "t": "عَلَّمَ ٱلۡإِنسَـٰنَ مَا لَمۡ یَعۡلَمۡ",
   "tc": "علم الانسن ما لم يعلم"
  },
  {
   "n": 6,
   "t": "كَلَّاۤ إِنَّ ٱلۡإِنسَـٰنَ لَیَطۡغَىٰۤ",
   "tc": "كلا ان الانسن ليطغي"
  },
  {
   "n": 7,
   "t": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰۤ",
   "tc": "ان رءاه استغني"
  },
  {
   "n": 8,
   "t": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰۤ",
   "tc": "ان الي ربك الرجعي"
  },
  {
   "n": 9,
   "t": "أَرَءَیۡتَ ٱلَّذِی یَنۡهَىٰ",
   "tc": "ارءيت الذي ينهي"
  },
  {
   "n": 10,
   "t": "عَبۡدًا إِذَا صَلَّىٰۤ",
   "tc": "عبدا اذا صلي"
  },
  {
   "n": 11,
   "t": "أَرَءَیۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰۤ",
   "tc": "ارءيت ان كان علي الهدي"
  },
  {
   "n": 12,
   "t": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰۤ",
   "tc": "او امر بالتقوي"
  },
  {
   "n": 13,
   "t": "أَرَءَیۡتَ إِن كَذَّبَ وَتَوَلَّىٰۤ",
   "tc": "ارءيت ان كذب وتولي"
  },
  {
   "n": 14,
   "t": "أَلَمۡ یَعۡلَم بِأَنَّ ٱللَّهَ یَرَىٰ",
   "tc": "الم يعلم بان الله يري"
  },
  {
   "n": 15,
   "t": "كَلَّا لَىِٕن لَّمۡ یَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِیَةِ",
   "tc": "كلا لين لم ينته لنسفعا بالناصيه"
  },
  {
   "n": 16,
   "t": "نَاصِیَةࣲ كَـٰذِبَةٍ خَاطِئَةࣲ",
   "tc": "ناصيهࣲ كذبه خاطئهࣲ"
  },
  {
   "n": 17,
   "t": "فَلۡیَدۡعُ نَادِیَهُۥ",
   "tc": "فليدع ناديه"
  },
  {
   "n": 18,
   "t": "سَنَدۡعُ ٱلزَّبَانِیَةَ",
   "tc": "سندع الزبانيه"
  },
  {
   "n": 19,
   "t": "كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡ وَٱقۡتَرِب ۩",
   "tc": "كلا لا تطعه واسجد واقترب"
  }
 ]
}