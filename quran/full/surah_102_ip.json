{"surah":102,"ayahs":[{"n":1,"t":"اَلْهٰىكُمُ التَّكَاثُرُ ۟ۙ"},{"n":2,"t":"حَتّٰی زُرْتُمُ الْمَقَابِرَ ۟ؕ"},{"n":3,"t":"كَلَّا سَوْفَ تَعْلَمُوْنَ ۟ۙ"},{"n":4,"t":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُوْنَ ۟ؕ"},{"n":5,"t":"كَلَّا لَوْ تَعْلَمُوْنَ عِلْمَ الْیَقِیْنِ ۟ؕ"},{"n":6,"t":"لَتَرَوُنَّ الْجَحِیْمَ ۟ۙ"},{"n":7,"t":"ثُمَّ لَتَرَوُنَّهَا عَیْنَ الْیَقِیْنِ ۟ۙ"},{"n":8,"t":"ثُمَّ لَتُسْـَٔلُنَّ یَوْمَىِٕذٍ عَنِ النَّعِیْمِ ۟۠"}]}