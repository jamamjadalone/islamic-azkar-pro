{"surah":92,"ayahs":[{"n":1,"t":"وَالَّیْلِ اِذَا یَغْشٰی ۟ۙ"},{"n":2,"t":"وَالنَّهَارِ اِذَا تَجَلّٰی ۟ۙ"},{"n":3,"t":"وَمَا خَلَقَ الذَّكَرَ وَالْاُ ۟ۙ"},{"n":4,"t":"اِنَّ سَعْیَكُمْ لَشَتّٰی ۟ؕ"},{"n":5,"t":"فَاَمَّا مَنْ اَعْطٰی وَاتَّقٰی ۟ۙ"},{"n":6,"t":"وَصَدَّقَ بِالْحُسْنٰی ۟ۙ"},{"n":7,"t":"فَسَنُیَسِّرُهٗ لِلْیُسْرٰی ۟ؕ"},{"n":8,"t":"وَاَمَّا مَنْ بَخِلَ وَاسْتَغْنٰی ۟ۙ"},{"n":9,"t":"وَكَذَّبَ بِالْحُسْنٰی ۟ۙ"},{"n":10,"t":"فَسَنُیَسِّرُهٗ لِلْعُسْرٰی ۟ؕ"},{"n":11,"t":"وَمَا یُغْنِیْ عَنْهُ مَالُهٗۤ اِذَا تَرَدّٰی ۟ؕ"},{"n":12,"t":"اِنَّ عَلَیْنَا لَلْهُدٰی ۟ؗۖ"},{"n":13,"t":"وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُوْلٰی ۟"},{"n":14,"t":"فَاَنْذَرْتُكُمْ نَارًا تَلَظّٰی ۟ۚ"},{"n":15,"t":"لَا یَصْلٰىهَاۤ اِلَّا الْاَشْقَی ۟ۙ"},{"n":16,"t":"الَّذِیْ كَذَّبَ وَتَوَلّٰی ۟ؕ"},{"n":17,"t":"وَسَیُجَنَّبُهَا الْاَتْقَی ۟ۙ"},{"n":18,"t":"الَّذِیْ یُؤْتِیْ مَالَهٗ یَتَزَكّٰی ۟ۚ"},{"n":19,"t":"وَمَا لِاَحَدٍ عِنْدَهٗ مِنْ نِّعْمَةٍ تُجْزٰۤی ۟ۙ"},{"n":20,"t":"اِلَّا ابْتِغَآءَ وَجْهِ رَبِّهِ الْاَعْلٰی ۟ۚ"},{"n":21,"t":"وَلَسَوْفَ یَرْضٰی ۟۠"}]}