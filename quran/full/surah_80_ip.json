{"surah":80,"ayahs":[{"n":1,"t":"عَبَسَ وَتَوَلّٰۤی ۟ۙ"},{"n":2,"t":"اَنْ جَآءَهُ الْاَعْمٰى ۟ؕ"},{"n":3,"t":"وَمَا یُدْرِیْكَ لَعَلَّهٗ یَزَّ ۟ۙ"},{"n":4,"t":"اَوْ یَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰى ۟ؕ"},{"n":5,"t":"اَمَّا مَنِ اسْتَغْنٰى ۟ۙ"},{"n":6,"t":"فَاَنْتَ لَهٗ تَصَدّٰى ۟ؕ"},{"n":7,"t":"وَمَا عَلَیْكَ اَلَّا یَزَّكّٰى ۟ؕ"},{"n":8,"t":"وَاَمَّا مَنْ جَآءَكَ یَسْعٰى ۟ۙ"},{"n":9,"t":"وَهُوَ یَخْشٰى ۟ۙ"},{"n":10,"t":"فَاَنْتَ عَنْهُ تَلَهّٰى ۟ۚ"},{"n":11,"t":"كَلَّاۤ اِنَّهَا تَذْكِرَةٌ ۟ۚ"},{"n":12,"t":"فَمَنْ شَآءَ ذَكَرَهٗ ۟ۘ"},{"n":13,"t":"فِیْ صُحُفٍ مُّكَرَّمَةٍ ۟ۙ"},{"n":14,"t":"مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۟ۙ"},{"n":15,"t":"بِاَیْدِیْ سَفَرَةٍ ۟ۙ"},{"n":16,"t":"كِرَامٍ بَرَرَةٍ ۟ؕ"},{"n":17,"t":"قُتِلَ الْاِنْسَانُ مَاۤ اَكْفَرَهٗ ۟ؕ"},{"n":18,"t":"مِنْ اَیِّ شَیْءٍ خَلَقَهٗ ۟ؕ"},{"n":19,"t":"مِنْ نُّطْفَةٍ ؕ— خَلَقَهٗ فَقَدَّرَهٗ ۟ۙ"},{"n":20,"t":"ثُمَّ السَّبِیْلَ یَسَّرَهٗ ۟ۙ"},{"n":21,"t":"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۟ۙ"},{"n":22,"t":"ثُمَّ اِذَا شَآءَ اَنْشَرَهٗ ۟ؕ"},{"n":23,"t":"كَلَّا لَمَّا یَقْضِ مَاۤ اَمَرَهٗ ۟ؕ"},{"n":24,"t":"فَلْیَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖۤ ۟ۙ"},{"n":25,"t":"اَنَّا صَبَبْنَا الْمَآءَ صَبًّا ۟ۙ"},{"n":26,"t":"ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّا ۟ۙ"},{"n":27,"t":"فَاَنْۢبَتْنَا فِیْهَا حَبًّا ۟ۙ"},{"n":28,"t":"وَّعِنَبًا وَّقَضْبًا ۟ۙ"},{"n":29,"t":"وَّزَیْتُوْنًا وَّنَخْلًا ۟ۙ"},{"n":30,"t":"وَّحَدَآىِٕقَ غُلْبًا ۟ۙ"},{"n":31,"t":"وَّفَاكِهَةً وَّاَبًّا ۟ۙ"},{"n":32,"t":"مَّتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۟ؕ"},{"n":33,"t":"فَاِذَا جَآءَتِ الصَّآخَّةُ ۟ؗ"},{"n":34,"t":"یَوْمَ یَفِرُّ الْمَرْءُ مِنْ اَخِیْهِ ۟ۙ"},{"n":35,"t":"وَاُمِّهٖ وَاَبِیْهِ ۟ۙ"},{"n":36,"t":"وَصَاحِبَتِهٖ وَبَنِیْهِ ۟ؕ"},{"n":37,"t":"لِكُلِّ امْرِئٍ مِّنْهُمْ یَوْمَىِٕذٍ شَاْنٌ یُّغْنِیْهِ ۟ؕ"},{"n":38,"t":"وُجُوْهٌ یَّوْمَىِٕذٍ مُّسْفِرَةٌ ۟ۙ"},{"n":39,"t":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۟ۚ"},{"n":40,"t":"وَوُجُوْهٌ یَّوْمَىِٕذٍ عَلَیْهَا غَبَرَةٌ ۟ۙ"},{"n":41,"t":"تَرْهَقُهَا قَتَرَةٌ ۟ؕ"},{"n":42,"t":"اُولٰٓىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ۟۠"}]}