{
 "surah": 87,
 "ayahs": [
  {
   "n": 1,
   "t": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
   "tc": "سبح اسم ربك الاعلي"
  },
  {
   "n": 2,
   "t": "ٱلَّذِی خَلَقَ فَسَوَّىٰ",
   "tc": "الذي خلق فسوي"
  },
  {
   "n": 3,
   "t": "وَٱلَّذِی قَدَّرَ فَهَدَىٰ",
   "tc": "والذي قدر فهدي"
  },
  {
   "n": 4,
   "t": "وَٱلَّذِیۤ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
   "tc": "والذي اخرج المرعي"
  },
  {
   "n": 5,
   "t": "فَجَعَلَهُۥ غُثَاۤءً أَحۡوَىٰ",
   "tc": "فجعله غثاء احوي"
  },
  {
   "n": 6,
   "t": "سَنُقۡرِئُكَ فَلَا تَنسَىٰۤ",
   "tc": "سنقرئك فلا تنسي"
  },
  {
   "n": 7,
   "t": "إِلَّا مَا شَاۤءَ ٱللَّهُۚ إِنَّهُۥ یَعۡلَمُ ٱلۡجَهۡرَ وَمَا یَخۡفَىٰ",
   "tc": "الا ما شاء الله انه يعلم الجهر وما يخفي"
  },
  {
   "n": 8,
   "t": "وَنُیَسِّرُكَ لِلۡیُسۡرَىٰ",
   "tc": "ونيسرك لليسري"
  },
  {
   "n": 9,
   "t": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
   "tc": "فذكر ان نفعت الذكري"
  },
  {
   "n": 10,
   "t": "سَیَذَّكَّرُ مَن یَخۡشَىٰ",
   "tc": "سيذكر من يخشي"
  },
  {
   "n": 11,
   "t": "وَیَتَجَنَّبُهَا ٱلۡأَشۡقَى",
   "tc": "ويتجنبها الاشقي"
  },
  {
   "n": 12,
   "t": "ٱلَّذِی یَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
   "tc": "الذي يصلي النار الكبري"
  },
  {
   "n": 13,
   "t": "ثُمَّ لَا یَمُوتُ فِیهَا وَلَا یَحۡیَىٰ",
   "tc": "ثم لا يموت فيها ولا يحيي"
  },
  {
   "n": 14,
   "t": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
   "tc": "قد افلح من تزكي"
  },
  {
   "n": 15,
   "t": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
   "tc": "وذكر اسم ربه فصلي"
  },
  {
   "n": 16,
   "t": "بَلۡ تُؤۡثِرُونَ ٱلۡحَیَوٰةَ ٱلدُّنۡیَا",
   "tc": "بل تؤثرون الحيوه الدنيا"
  },
  {
   "n": 17,
   "t": "وَٱلۡـَٔاخِرَةُ خَیۡرࣱ وَأَبۡقَىٰۤ",
   "tc": "والاخره خيرࣱ وابقي"
  },
  {
   "n": 18,
   "t": "إِنَّ هَـٰذَا لَفِی ٱلصُّحُفِ ٱلۡأُولَىٰ",
   "tc": "ان هذا لفي الصحف الاولي"
  },
  {
   "n": 19,
   "t": "صُحُفِ إِبۡرَ ٰ⁠هِیمَ وَمُوسَىٰ",
   "tc": "صحف ابر هيم وموسي"
  }
 ]
}