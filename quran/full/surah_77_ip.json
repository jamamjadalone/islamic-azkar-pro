{"surah":77,"ayahs":[{"n":1,"t":"وَالْمُرْسَلٰتِ عُرْفًا ۟ۙ"},{"n":2,"t":"فَالْعٰصِفٰتِ عَصْفًا ۟ۙ"},{"n":3,"t":"وَّالنّٰشِرٰتِ نَشْرًا ۟ۙ"},{"n":4,"t":"فَالْفٰرِقٰتِ فَرْقًا ۟ۙ"},{"n":5,"t":"فَالْمُلْقِیٰتِ ذِكْرًا ۟ۙ"},{"n":6,"t":"عُذْرًا اَوْ نُذْرًا ۟ۙ"},{"n":7,"t":"اِنَّمَا تُوْعَدُوْنَ لَوَاقِعٌ ۟ؕ"},{"n":8,"t":"فَاِذَا النُّجُوْمُ طُمِسَتْ ۟ۙ"},{"n":9,"t":"وَاِذَا السَّمَآءُ فُرِجَتْ ۟ۙ"},{"n":10,"t":"وَاِذَا الْجِبَالُ نُسِفَتْ ۟ۙ"},{"n":11,"t":"وَاِذَا الرُّسُلُ اُقِّتَتْ ۟ؕ"},{"n":12,"t":"لِاَیِّ یَوْمٍ اُجِّلَتْ ۟ؕ"},{"n":13,"t":"لِیَوْمِ الْفَصْلِ ۟ۚ"},{"n":14,"t":"وَمَاۤ اَدْرٰىكَ مَا یَوْمُ الْفَصْلِ ۟ؕ"},{"n":15,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":16,"t":"اَلَمْ نُهْلِكِ الْاَوَّلِیْنَ ۟ؕ"},{"n":17,"t":"ثُمَّ نُتْبِعُهُمُ الْاٰخِرِیْنَ ۟"},{"n":18,"t":"كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمِیْنَ ۟"},{"n":19,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":20,"t":"اَلَمْ نَخْلُقْكُّمْ مِّنْ مَّآءٍ مَّهِیْنٍ ۟ۙ"},{"n":21,"t":"فَجَعَلْنٰهُ فِیْ قَرَارٍ مَّكِیْنٍ ۟ۙ"},{"n":22,"t":"اِلٰی قَدَرٍ مَّعْلُوْمٍ ۟ۙ"},{"n":23,"t":"فَقَدَرْنَا ۖۗ— فَنِعْمَ الْقٰدِرُوْنَ ۟"},{"n":24,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":25,"t":"اَلَمْ نَجْعَلِ الْاَرْضَ كِفَاتًا ۟ۙ"},{"n":26,"t":"اَحْیَآءً وَّاَمْوَاتًا ۟ۙ"},{"n":27,"t":"وَّجَعَلْنَا فِیْهَا رَوَاسِیَ شٰمِخٰتٍ وَّاَسْقَیْنٰكُمْ مَّآءً فُرَاتًا ۟ؕ"},{"n":28,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":29,"t":"اِنْطَلِقُوْۤا اِلٰی مَا كُنْتُمْ بِهٖ تُكَذِّبُوْنَ ۟ۚ"},{"n":30,"t":"اِنْطَلِقُوْۤا اِلٰی ظِلٍّ ذِیْ ثَلٰثِ شُعَبٍ ۟ۙ"},{"n":31,"t":"لَّا ظَلِیْلٍ وَّلَا یُغْنِیْ مِنَ اللَّهَبِ ۟ؕ"},{"n":32,"t":"اِنَّهَا تَرْمِیْ بِشَرَرٍ كَالْقَصْرِ ۟ۚ"},{"n":33,"t":"كَاَنَّهٗ جِمٰلَتٌ صُفْرٌ ۟ؕ"},{"n":34,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":35,"t":"هٰذَا یَوْمُ لَا یَنْطِقُوْنَ ۟ۙ"},{"n":36,"t":"وَلَا یُؤْذَنُ لَهُمْ فَیَعْتَذِرُوْنَ ۟"},{"n":37,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":38,"t":"هٰذَا یَوْمُ الْفَصْلِ ۚ— جَمَعْنٰكُمْ وَالْاَوَّلِیْنَ ۟"},{"n":39,"t":"فَاِنْ كَانَ لَكُمْ كَیْدٌ فَكِیْدُوْنِ ۟"},{"n":40,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟۠"},{"n":41,"t":"اِنَّ الْمُتَّقِیْنَ فِیْ ظِلٰلٍ وَّعُیُوْنٍ ۟ۙ"},{"n":42,"t":"وَّفَوَاكِهَ مِمَّا یَشْتَهُوْنَ ۟ؕ"},{"n":43,"t":"كُلُوْا وَاشْرَبُوْا هَنِیْٓـًٔا بِمَا كُنْتُمْ تَعْمَلُوْنَ ۟"},{"n":44,"t":"اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنِیْنَ ۟"},{"n":45,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":46,"t":"كُلُوْا وَتَمَتَّعُوْا قَلِیْلًا اِنَّكُمْ مُّجْرِمُوْنَ ۟"},{"n":47,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":48,"t":"وَاِذَا قِیْلَ لَهُمُ ارْكَعُوْا لَا یَرْكَعُوْنَ ۟"},{"n":49,"t":"وَیْلٌ یَّوْمَىِٕذٍ لِّلْمُكَذِّبِیْنَ ۟"},{"n":50,"t":"فَبِاَیِّ حَدِیْثٍ بَعْدَهٗ یُؤْمِنُوْنَ ۟۠"}]}