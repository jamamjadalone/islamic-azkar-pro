{
 "surah": 109,
 "ayahs": [
  {
   "n": 1,
   "t": "قُلۡ یَـٰۤأَیُّهَا ٱلۡكَـٰفِرُونَ",
   "tc": "قل يايها الكفرون"
  },
  {
   "n": 2,
   "t": "لَاۤ أَعۡبُدُ مَا تَعۡبُدُونَ",
   "tc": "لا اعبد ما تعبدون"
  },
  {
   "n": 3,
   "t": "وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ",
   "tc": "ولا انتم عبدون ما اعبد"
  },
  {
   "n": 4,
   "t": "وَلَاۤ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ",
   "tc": "ولا انا عابدࣱ ما عبدتم"
  },
  {
   "n": 5,
   "t": "وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ",
   "tc": "ولا انتم عبدون ما اعبد"
  },
  {
   "n": 6,
   "t": "لَكُمۡ دِینُكُمۡ وَلِیَ دِینِ",
   "tc": "لكم دينكم ولي دين"
  }
 ]
}