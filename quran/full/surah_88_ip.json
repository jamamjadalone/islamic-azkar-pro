{"surah":88,"ayahs":[{"n":1,"t":"هَلْ اَتٰىكَ حَدِیْثُ الْغَاشِیَةِ ۟ؕ"},{"n":2,"t":"وُجُوْهٌ یَّوْمَىِٕذٍ خَاشِعَةٌ ۟ۙ"},{"n":3,"t":"عَامِلَةٌ نَّاصِبَةٌ ۟ۙ"},{"n":4,"t":"تَصْلٰی نَارًا حَامِیَةً ۟ۙ"},{"n":5,"t":"تُسْقٰی مِنْ عَیْنٍ اٰنِیَةٍ ۟ؕ"},{"n":6,"t":"لَیْسَ لَهُمْ طَعَامٌ اِلَّا مِنْ ضَرِیْعٍ ۟ۙ"},{"n":7,"t":"لَّا یُسْمِنُ وَلَا یُغْنِیْ مِنْ جُوْعٍ ۟ؕ"},{"n":8,"t":"وُجُوْهٌ یَّوْمَىِٕذٍ نَّاعِمَةٌ ۟ۙ"},{"n":9,"t":"لِّسَعْیِهَا رَاضِیَةٌ ۟ۙ"},{"n":10,"t":"فِیْ جَنَّةٍ عَالِیَةٍ ۟ۙ"},{"n":11,"t":"لَّا تَسْمَعُ فِیْهَا لَاغِیَةً ۟ؕ"},{"n":12,"t":"فِیْهَا عَیْنٌ جَارِیَةٌ ۟ۘ"},{"n":13,"t":"فِیْهَا سُرُرٌ مَّرْفُوْعَةٌ ۟ۙ"},{"n":14,"t":"وَّاَكْوَابٌ مَّوْضُوْعَةٌ ۟ۙ"},{"n":15,"t":"وَّنَمَارِقُ مَصْفُوْفَةٌ ۟ۙ"},{"n":16,"t":"وَّزَرَابِیُّ مَبْثُوْثَةٌ ۟ؕ"},{"n":17,"t":"اَفَلَا یَنْظُرُوْنَ اِلَی الْاِبِلِ كَیْفَ خُلِقَتْ ۟ۥ"},{"n":18,"t":"وَاِلَی السَّمَآءِ كَیْفَ رُفِعَتْ ۟ۥ"},{"n":19,"t":"وَاِلَی الْجِبَالِ كَیْفَ نُصِبَتْ ۟ۥ"},{"n":20,"t":"وَاِلَی الْاَرْضِ كَیْفَ سُطِحَتْ ۟"},{"n":21,"t":"فَذَكِّرْ ۫— اِنَّمَاۤ اَنْتَ مُذَكِّرٌ ۟ؕ"},{"n":22,"t":"لَسْتَ عَلَیْهِمْ بِمُصَۜیْطِرٍ ۟ۙ"},{"n":23,"t":"اِلَّا مَنْ تَوَلّٰی وَكَفَرَ ۟ۙ"},{"n":24,"t":"فَیُعَذِّبُهُ اللّٰهُ الْعَذَابَ الْاَكْبَرَ ۟ؕ"},{"n":25,"t":"اِنَّ اِلَیْنَاۤ اِیَابَهُمْ ۟ۙ"},{"n":26,"t":"ثُمَّ اِنَّ عَلَیْنَا حِسَابَهُمْ ۟۠"}]}