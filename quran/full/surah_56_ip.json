{"surah":56,"ayahs":[{"n":1,"t":"اِذَا وَقَعَتِ الْوَاقِعَةُ ۟ۙ"},{"n":2,"t":"لَیْسَ لِوَقْعَتِهَا كَاذِبَةٌ ۟ۘ"},{"n":3,"t":"خَافِضَةٌ رَّافِعَةٌ ۟ۙ"},{"n":4,"t":"اِذَا رُجَّتِ الْاَرْضُ رَجًّا ۟ۙ"},{"n":5,"t":"وَّبُسَّتِ الْجِبَالُ بَسًّا ۟ۙ"},{"n":6,"t":"فَكَانَتْ هَبَآءً مُّنْۢبَثًّا ۟ۙ"},{"n":7,"t":"وَّكُنْتُمْ اَزْوَاجًا ثَلٰثَةً ۟ؕ"},{"n":8,"t":"فَاَصْحٰبُ الْمَیْمَنَةِ ۙ۬— مَاۤ اَصْحٰبُ الْمَیْمَنَةِ ۟ؕ"},{"n":9,"t":"وَاَصْحٰبُ الْمَشْـَٔمَةِ ۙ۬— مَاۤ اَصْحٰبُ الْمَشْـَٔمَةِ ۟ؕ"},{"n":10,"t":"وَالسّٰبِقُوْنَ السّٰبِقُوْنَ ۟ۙ"},{"n":11,"t":"اُولٰٓىِٕكَ الْمُقَرَّبُوْنَ ۟ۚ"},{"n":12,"t":"فِیْ جَنّٰتِ النَّعِیْمِ ۟"},{"n":13,"t":"ثُلَّةٌ مِّنَ الْاَوَّلِیْنَ ۟ۙ"},{"n":14,"t":"وَقَلِیْلٌ مِّنَ الْاٰخِرِیْنَ ۟ؕ"},{"n":15,"t":"عَلٰی سُرُرٍ مَّوْضُوْنَةٍ ۟ۙ"},{"n":16,"t":"مُّتَّكِـِٕیْنَ عَلَیْهَا مُتَقٰبِلِیْنَ ۟"},{"n":17,"t":"یَطُوْفُ عَلَیْهِمْ وِلْدَانٌ مُّخَلَّدُوْنَ ۟ۙ"},{"n":18,"t":"بِاَكْوَابٍ وَّاَبَارِیْقَ ۙ۬— وَكَاْسٍ مِّنْ مَّعِیْنٍ ۟ۙ"},{"n":19,"t":"لَّا یُصَدَّعُوْنَ عَنْهَا وَلَا یُنْزِفُوْنَ ۟ۙ"},{"n":20,"t":"وَفَاكِهَةٍ مِّمَّا یَتَخَیَّرُوْنَ ۟ۙ"},{"n":21,"t":"وَلَحْمِ طَیْرٍ مِّمَّا یَشْتَهُوْنَ ۟ؕ"},{"n":22,"t":"وَحُوْرٌ عِیْنٌ ۟ۙ"},{"n":23,"t":"كَاَمْثَالِ اللُّؤْلُو الْمَكْنُوْنِ ۟ۚ"},{"n":24,"t":"جَزَآءً بِمَا كَانُوْا یَعْمَلُوْنَ ۟"},{"n":25,"t":"لَا یَسْمَعُوْنَ فِیْهَا لَغْوًا وَّلَا تَاْثِیْمًا ۟ۙ"},{"n":26,"t":"اِلَّا قِیْلًا سَلٰمًا سَلٰمًا ۟"},{"n":27,"t":"وَاَصْحٰبُ الْیَمِیْنِ ۙ۬— مَاۤ اَصْحٰبُ الْیَمِیْنِ ۟ؕ"},{"n":28,"t":"فِیْ سِدْرٍ مَّخْضُوْدٍ ۟ۙ"},{"n":29,"t":"وَّطَلْحٍ مَّنْضُوْدٍ ۟ۙ"},{"n":30,"t":"وَّظِلٍّ مَّمْدُوْدٍ ۟ۙ"},{"n":31,"t":"وَّمَآءٍ مَّسْكُوْبٍ ۟ۙ"},{"n":32,"t":"وَّفَاكِهَةٍ كَثِیْرَةٍ ۟ۙ"},{"n":33,"t":"لَّا مَقْطُوْعَةٍ وَّلَا مَمْنُوْعَةٍ ۟ۙ"},{"n":34,"t":"وَّفُرُشٍ مَّرْفُوْعَةٍ ۟ؕ"},{"n":35,"t":"اِنَّاۤ اَنْشَاْنٰهُنَّ اِنْشَآءً ۟ۙ"},{"n":36,"t":"فَجَعَلْنٰهُنَّ اَبْكَارًا ۟ۙ"},{"n":37,"t":"عُرُبًا اَتْرَابًا ۟ۙ"},{"n":38,"t":"لِّاَصْحٰبِ الْیَمِیْنِ ۟ؕ۠"},{"n":39,"t":"ثُلَّةٌ مِّنَ الْاَوَّلِیْنَ ۟ۙ"},{"n":40,"t":"وَثُلَّةٌ مِّنَ الْاٰخِرِیْنَ ۟ؕ"},{"n":41,"t":"وَاَصْحٰبُ الشِّمَالِ ۙ۬— مَاۤ اَصْحٰبُ الشِّمَالِ ۟ؕ"},{"n":42,"t":"فِیْ سَمُوْمٍ وَّحَمِیْمٍ ۟ۙ"},{"n":43,"t":"وَّظِلٍّ مِّنْ یَّحْمُوْمٍ ۟ۙ"},{"n":44,"t":"لَّا بَارِدٍ وَّلَا كَرِیْمٍ ۟"},{"n":45,"t":"اِنَّهُمْ كَانُوْا قَبْلَ ذٰلِكَ مُتْرَفِیْنَ ۟ۚۖ"},{"n":46,"t":"وَكَانُوْا یُصِرُّوْنَ عَلَی الْحِنْثِ الْعَظِیْمِ ۟ۚ"},{"n":47,"t":"وَكَانُوْا یَقُوْلُوْنَ ۙ۬— اَىِٕذَا مِتْنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبْعُوْثُوْنَ ۟ۙ"},{"n":48,"t":"اَوَاٰبَآؤُنَا الْاَوَّلُوْنَ ۟"},{"n":49,"t":"قُلْ اِنَّ الْاَوَّلِیْنَ وَالْاٰخِرِیْنَ ۟ۙ"},{"n":50,"t":"لَمَجْمُوْعُوْنَ ۙ۬— اِلٰی مِیْقَاتِ یَوْمٍ مَّعْلُوْمٍ ۟"},{"n":51,"t":"ثُمَّ اِنَّكُمْ اَیُّهَا الضَّآلُّوْنَ الْمُكَذِّبُوْنَ ۟ۙ"},{"n":52,"t":"لَاٰكِلُوْنَ مِنْ شَجَرٍ مِّنْ زَقُّوْمٍ ۟ۙ"},{"n":53,"t":"فَمَالِـُٔوْنَ مِنْهَا الْبُطُوْنَ ۟ۚ"},{"n":54,"t":"فَشٰرِبُوْنَ عَلَیْهِ مِنَ الْحَمِیْمِ ۟ۚ"},{"n":55,"t":"فَشٰرِبُوْنَ شُرْبَ الْهِیْمِ ۟ؕ"},{"n":56,"t":"هٰذَا نُزُلُهُمْ یَوْمَ الدِّیْنِ ۟ؕ"},{"n":57,"t":"نَحْنُ خَلَقْنٰكُمْ فَلَوْلَا تُصَدِّقُوْنَ ۟"},{"n":58,"t":"اَفَرَءَیْتُمْ مَّا تُمْنُوْنَ ۟ؕ"},{"n":59,"t":"ءَاَنْتُمْ تَخْلُقُوْنَهٗۤ اَمْ نَحْنُ الْخٰلِقُوْنَ ۟"},{"n":60,"t":"نَحْنُ قَدَّرْنَا بَیْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوْقِیْنَ ۟ۙ"},{"n":61,"t":"عَلٰۤی اَنْ نُّبَدِّلَ اَمْثَالَكُمْ وَنُنْشِئَكُمْ فِیْ مَا لَا تَعْلَمُوْنَ ۟"},{"n":62,"t":"وَلَقَدْ عَلِمْتُمُ النَّشْاَةَ الْاُوْلٰی فَلَوْلَا تَذَكَّرُوْنَ ۟"},{"n":63,"t":"اَفَرَءَیْتُمْ مَّا تَحْرُثُوْنَ ۟ؕ"},{"n":64,"t":"ءَاَنْتُمْ تَزْرَعُوْنَهٗۤ اَمْ نَحْنُ الزّٰرِعُوْنَ ۟"},{"n":65,"t":"لَوْ نَشَآءُ لَجَعَلْنٰهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُوْنَ ۟"},{"n":66,"t":"اِنَّا لَمُغْرَمُوْنَ ۟ۙ"},{"n":67,"t":"بَلْ نَحْنُ مَحْرُوْمُوْنَ ۟"},{"n":68,"t":"اَفَرَءَیْتُمُ الْمَآءَ الَّذِیْ تَشْرَبُوْنَ ۟ؕ"},{"n":69,"t":"ءَاَنْتُمْ اَنْزَلْتُمُوْهُ مِنَ الْمُزْنِ اَمْ نَحْنُ الْمُنْزِلُوْنَ ۟"},{"n":70,"t":"لَوْ نَشَآءُ جَعَلْنٰهُ اُجَاجًا فَلَوْلَا تَشْكُرُوْنَ ۟"},{"n":71,"t":"اَف