{
 "surah": 80,
 "ayahs": [
  {
   "n": 1,
   "t": "عَبَسَ وَتَوَلَّىٰۤ",
   "tc": "عبس وتولي"
  },
  {
   "n": 2,
   "t": "أَن جَاۤءَهُ ٱلۡأَعۡمَىٰ",
   "tc": "ان جاءه الاعمي"
  },
  {
   "n": 3,
   "t": "وَمَا یُدۡرِیكَ لَعَلَّهُۥ یَزَّكَّىٰۤ",
   "tc": "وما يدريك لعله يزكي"
  },
  {
   "n": 4,
   "t": "أَوۡ یَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰۤ",
   "tc": "او يذكر فتنفعه الذكري"
  },
  {
   "n": 5,
   "t": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
   "tc": "اما من استغني"
  },
  {
   "n": 6,
   "t": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
   "tc": "فانت له تصدي"
  },
  {
   "n": 7,
   "t": "وَمَا عَلَیۡكَ أَلَّا یَزَّكَّىٰ",
   "tc": "وما عليك الا يزكي"
  },
  {
   "n": 8,
   "t": "وَأَمَّا مَن جَاۤءَكَ یَسۡعَىٰ",
   "tc": "واما من جاءك يسعي"
  },
  {
   "n": 9,
   "t": "وَهُوَ یَخۡشَىٰ",
   "tc": "وهو يخشي"
  },
  {
   "n": 10,
   "t": "فَأَنتَ عَنۡهُ تَلَهَّىٰ",
   "tc": "فانت عنه تلهي"
  },
  {
   "n": 11,
   "t": "كَلَّاۤ إِنَّهَا تَذۡكِرَةࣱ",
   "tc": "كلا انها تذكرهࣱ"
  },
  {
   "n": 12,
   "t": "فَمَن شَاۤءَ ذَكَرَهُۥ",
   "tc": "فمن شاء ذكره"
  },
  {
   "n": 13,
   "t": "فِی صُحُفࣲ مُّكَرَّمَةࣲ",
   "tc": "في صحفࣲ مكرمهࣲ"
  },
  {
   "n": 14,
   "t": "مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ",
   "tc": "مرفوعهࣲ مطهره"
  },
  {
   "n": 15,
   "t": "بِأَیۡدِی سَفَرَةࣲ",
   "tc": "بايدي سفرهࣲ"
  },
  {
   "n": 16,
   "t": "كِرَامِۭ بَرَرَةࣲ",
   "tc": "كرام بررهࣲ"
  },
  {
   "n": 17,
   "t": "قُتِلَ ٱلۡإِنسَـٰنُ مَاۤ أَكۡفَرَهُۥ",
   "tc": "قتل الانسن ما اكفره"
  },
  {
   "n": 18,
   "t": "مِنۡ أَیِّ شَیۡءٍ خَلَقَهُۥ",
   "tc": "من اي شيء خلقه"
  },
  {
   "n": 19,
   "t": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
   "tc": "من نطفه خلقه فقدره"
  },
  {
   "n": 20,
   "t": "ثُمَّ ٱلسَّبِیلَ یَسَّرَهُۥ",
   "tc": "ثم السبيل يسره"
  },
  {
   "n": 21,
   "t": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
   "tc": "ثم اماته فاقبره"
  },
  {
   "n": 22,
   "t": "ثُمَّ إِذَا شَاۤءَ أَنشَرَهُۥ",
   "tc": "ثم اذا شاء انشره"
  },
  {
   "n": 23,
   "t": "كَلَّا لَمَّا یَقۡضِ مَاۤ أَمَرَهُۥ",
   "tc": "كلا لما يقض ما امره"
  },
  {
   "n": 24,
   "t": "فَلۡیَنظُرِ ٱلۡإِنسَـٰنُ إِلَىٰ طَعَامِهِۦۤ",
   "tc": "فلينظر الانسن الي طعامه"
  },
  {
   "n": 25,
   "t": "أَنَّا صَبَبۡنَا ٱلۡمَاۤءَ صَبࣰّا",
   "tc": "انا صببنا الماء صبࣰا"
  },
  {
   "n": 26,
   "t": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّا",
   "tc": "ثم شققنا الارض شقࣰا"
  },
  {
   "n": 27,
   "t": "فَأَنۢبَتۡنَا فِیهَا حَبࣰّا",
   "tc": "فانبتنا فيها حبࣰا"
  },
  {
   "n": 28,
   "t": "وَعِنَبࣰا وَقَضۡبࣰا",
   "tc": "وعنبࣰا وقضبࣰا"
  },
  {
   "n": 29,
   "t": "وَزَیۡتُونࣰا وَنَخۡلࣰا",
   "tc": "وزيتونࣰا ونخلࣰا"
  },
  {
   "n": 30,
   "t": "وَحَدَاۤىِٕقَ غُلۡبࣰا",
   "tc": "وحدايق غلبࣰا"
  },
  {
   "n": 31,
   "t": "وَفَـٰكِهَةࣰ وَأَبࣰّا",
   "tc": "وفكههࣰ وابࣰا"
  },
  {
   "n": 32,
   "t": "مَّتَـٰعࣰا لَّكُمۡ وَلِأَنۡعَـٰمِكُمۡ",
   "tc": "متعࣰا لكم ولانعمكم"
  },
  {
   "n": 33,
   "t": "فَإِذَا جَاۤءَتِ ٱلصَّاۤخَّةُ",
   "tc": "فاذا جاءت الصاخه"
  },
  {
   "n": 34,
   "t": "یَوۡمَ یَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِیهِ",
   "tc": "يوم يفر المرء من اخيه"
  },
  {
   "n": 35,
   "t": "وَأُمِّهِۦ وَأَبِیهِ",
   "tc": "وامه وابيه"
  },
  {
   "n": 36,
   "t": "وَصَـٰحِبَتِهِۦ وَبَنِیهِ",
   "tc": "وصحبته وبنيه"
  },
  {
   "n": 37,
   "t": "لِكُلِّ ٱمۡرِئࣲ مِّنۡهُمۡ یَوۡمَىِٕذࣲ شَأۡنࣱ یُغۡنِیهِ",
   "tc": "لكل امرئࣲ منهم يوميذࣲ شانࣱ يغنيه"
  },
  {
   "n": 38,
   "t": "وُجُوهࣱ یَوۡمَىِٕذࣲ مُّسۡفِرَةࣱ",
   "tc": "وجوهࣱ يوميذࣲ مسفرهࣱ"
  },
  {
   "n": 39,
   "t": "ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ",
   "tc": "ضاحكهࣱ مستبشرهࣱ"
  },
  {
   "n": 40,
   "t": "وَوُجُوهࣱ یَوۡمَىِٕذٍ عَلَیۡهَا غَبَرَةࣱ",
   "tc": "ووجوهࣱ يوميذ عليها غبرهࣱ"
  },
  {
   "n": 41,
   "t": "تَرۡهَقُهَا قَتَرَةٌ",
   "tc": "ترهقها قتره"
  },
  {
   "n": 42,
   "t": "أُو۟لَـٰۤىِٕكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",
   "tc": "اوليك هم الكفره الفجره"
  }
 ]
}