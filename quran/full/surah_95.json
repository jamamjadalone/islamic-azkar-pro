{
 "surah": 95,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلتِّینِ وَٱلزَّیۡتُونِ",
   "tc": "والتين والزيتون"
  },
  {
   "n": 2,
   "t": "وَطُورِ سِینِینَ",
   "tc": "وطور سينين"
  },
  {
   "n": 3,
   "t": "وَهَـٰذَا ٱلۡبَلَدِ ٱلۡأَمِینِ",
   "tc": "وهذا البلد الامين"
  },
  {
   "n": 4,
   "t": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَـٰنَ فِیۤ أَحۡسَنِ تَقۡوِیمࣲ",
   "tc": "لقد خلقنا الانسن في احسن تقويمࣲ"
  },
  {
   "n": 5,
   "t": "ثُمَّ رَدَدۡنَـٰهُ أَسۡفَلَ سَـٰفِلِینَ",
   "tc": "ثم رددنه اسفل سفلين"
  },
  {
   "n": 6,
   "t": "إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمۡ أَجۡرٌ غَیۡرُ مَمۡنُونࣲ",
   "tc": "الا الذين ءامنوا وعملوا الصلحت فلهم اجر غير ممنونࣲ"
  },
  {
   "n": 7,
   "t": "فَمَا یُكَذِّبُكَ بَعۡدُ بِٱلدِّینِ",
   "tc": "فما يكذبك بعد بالدين"
  },
  {
   "n": 8,
   "t": "أَلَیۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَـٰكِمِینَ",
   "tc": "اليس الله باحكم الحكمين"
  }
 ]
}