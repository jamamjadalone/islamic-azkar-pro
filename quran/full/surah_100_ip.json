{"surah":100,"ayahs":[{"n":1,"t":"وَالْعٰدِیٰتِ ضَبْحًا ۟ۙ"},{"n":2,"t":"فَالْمُوْرِیٰتِ قَدْحًا ۟ۙ"},{"n":3,"t":"فَالْمُغِیْرٰتِ صُبْحًا ۟ۙ"},{"n":4,"t":"فَاَثَرْنَ بِهٖ نَقْعًا ۟ۙ"},{"n":5,"t":"فَوَسَطْنَ بِهٖ جَمْعًا ۟ۙ"},{"n":6,"t":"اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُوْدٌ ۟ۚ"},{"n":7,"t":"وَاِنَّهٗ عَلٰی ذٰلِكَ لَشَهِیْدٌ ۟ۚ"},{"n":8,"t":"وَاِنَّهٗ لِحُبِّ الْخَیْرِ لَشَدِیْدٌ ۟ؕ"},{"n":9,"t":"اَفَلَا یَعْلَمُ اِذَا بُعْثِرَ مَا فِی الْقُبُوْرِ ۟ۙ"},{"n":10,"t":"وَحُصِّلَ مَا فِی الصُّدُوْرِ ۟ۙ"},{"n":11,"t":"اِنَّ رَبَّهُمْ بِهِمْ یَوْمَىِٕذٍ لَّخَبِیْرٌ ۟۠"}]}