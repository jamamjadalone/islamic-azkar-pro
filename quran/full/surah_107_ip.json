{"surah":107,"ayahs":[{"n":1,"t":"اَرَءَیْتَ الَّذِیْ یُكَذِّبُ بِالدِّیْنِ ۟ؕ"},{"n":2,"t":"فَذٰلِكَ الَّذِیْ یَدُعُّ الْیَتِیْمَ ۟ۙ"},{"n":3,"t":"وَلَا یَحُضُّ عَلٰی طَعَامِ الْمِسْكِیْنِ ۟ؕ"},{"n":4,"t":"فَوَیْلٌ لِّلْمُصَلِّیْنَ ۟ۙ"},{"n":5,"t":"الَّذِیْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَ ۟ۙ"},{"n":6,"t":"الَّذِیْنَ هُمْ یُرَآءُوْنَ ۟ۙ"},{"n":7,"t":"وَیَمْنَعُوْنَ الْمَاعُوْنَ ۟۠"}]}