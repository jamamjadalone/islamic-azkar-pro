{
 "surah": 101,
 "ayahs": [
  {
   "n": 1,
   "t": "ٱلۡقَارِعَةُ",
   "tc": "القارعه"
  },
  {
   "n": 2,
   "t": "مَا ٱلۡقَارِعَةُ",
   "tc": "ما القارعه"
  },
  {
   "n": 3,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
   "tc": "وما ادريك ما القارعه"
  },
  {
   "n": 4,
   "t": "یَوۡمَ یَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
   "tc": "يوم يكون الناس كالفراش المبثوث"
  },
  {
   "n": 5,
   "t": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
   "tc": "وتكون الجبال كالعهن المنفوش"
  },
  {
   "n": 6,
   "t": "فَأَمَّا مَن ثَقُلَتۡ مَوَ ٰ⁠زِینُهُۥ",
   "tc": "فاما من ثقلت مو زينه"
  },
  {
   "n": 7,
   "t": "فَهُوَ فِی عِیشَةࣲ رَّاضِیَةࣲ",
   "tc": "فهو في عيشهࣲ راضيهࣲ"
  },
  {
   "n": 8,
   "t": "وَأَمَّا مَنۡ خَفَّتۡ مَوَ ٰ⁠زِینُهُۥ",
   "tc": "واما من خفت مو زينه"
  },
  {
   "n": 9,
   "t": "فَأُمُّهُۥ هَاوِیَةࣱ",
   "tc": "فامه هاويهࣱ"
  },
  {
   "n": 10,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا هِیَهۡ",
   "tc": "وما ادريك ما هيه"
  },
  {
   "n": 11,
   "t": "نَارٌ حَامِیَةُۢ",
   "tc": "نار حاميه"
  }
 ]
}