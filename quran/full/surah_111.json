{
 "surah": 111,
 "ayahs": [
  {
   "n": 1,
   "t": "تَبَّتۡ یَدَاۤ أَبِی لَهَبࣲ وَتَبَّ",
   "tc": "تبت يدا ابي لهبࣲ وتب"
  },
  {
   "n": 2,
   "t": "مَاۤ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ",
   "tc": "ما اغني عنه ماله وما كسب"
  },
  {
   "n": 3,
   "t": "سَیَصۡلَىٰ نَارࣰا ذَاتَ لَهَبࣲ",
   "tc": "سيصلي نارࣰا ذات لهبࣲ"
  },
  {
   "n": 4,
   "t": "وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ",
   "tc": "وامراته حماله الحطب"
  },
  {
   "n": 5,
   "t": "فِی جِیدِهَا حَبۡلࣱ مِّن مَّسَدِۭ",
   "tc": "في جيدها حبلࣱ من مسد"
  }
 ]
}