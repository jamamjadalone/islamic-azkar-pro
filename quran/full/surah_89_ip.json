{"surah":89,"ayahs":[{"n":1,"t":"وَالْفَجْرِ ۟ۙ"},{"n":2,"t":"وَلَیَالٍ عَشْرٍ ۟ۙ"},{"n":3,"t":"وَّالشَّفْعِ وَالْوَتْرِ ۟ۙ"},{"n":4,"t":"وَالَّیْلِ اِذَا یَسْرِ ۟ۚ"},{"n":5,"t":"هَلْ فِیْ ذٰلِكَ قَسَمٌ لِّذِیْ حِجْرٍ ۟ؕ"},{"n":6,"t":"اَلَمْ تَرَ كَیْفَ فَعَلَ رَبُّكَ بِعَادٍ ۟"},{"n":7,"t":"اِرَمَ ذَاتِ الْعِمَادِ ۟"},{"n":8,"t":"الَّتِیْ لَمْ یُخْلَقْ مِثْلُهَا فِی الْبِلَادِ ۟"},{"n":9,"t":"وَثَمُوْدَ الَّذِیْنَ جَابُوا الصَّخْرَ بِالْوَادِ ۟"},{"n":10,"t":"وَفِرْعَوْنَ ذِی الْاَوْتَادِ ۟"},{"n":11,"t":"الَّذِیْنَ طَغَوْا فِی الْبِلَادِ ۟"},{"n":12,"t":"فَاَكْثَرُوْا فِیْهَا الْفَسَادَ ۟"},{"n":13,"t":"فَصَبَّ عَلَیْهِمْ رَبُّكَ سَوْطَ عَذَابٍ ۟ۚۙ"},{"n":14,"t":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِ ۟ؕ"},{"n":15,"t":"فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗ ۙ۬— فَیَقُوْلُ رَبِّیْۤ اَكْرَمَنِ ۟ؕ"},{"n":16,"t":"وَاَمَّاۤ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَیْهِ رِزْقَهٗ ۙ۬— فَیَقُوْلُ رَبِّیْۤ اَهَانَنِ ۟ۚ"},{"n":17,"t":"كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْیَتِیْمَ ۟ۙ"},{"n":18,"t":"وَلَا تَحٰٓضُّوْنَ عَلٰی طَعَامِ الْمِسْكِیْنِ ۟ۙ"},{"n":19,"t":"وَتَاْكُلُوْنَ التُّرَاثَ اَكْلًا لَّمًّا ۟ۙ"},{"n":20,"t":"وَّتُحِبُّوْنَ الْمَالَ حُبًّا جَمًّا ۟ؕ"},{"n":21,"t":"كَلَّاۤ اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّا ۟ۙ"},{"n":22,"t":"وَّجَآءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا ۟ۚ"},{"n":23,"t":"وَجِایْٓءَ یَوْمَىِٕذٍ بِجَهَنَّمَ ۙ۬— یَوْمَىِٕذٍ یَّتَذَكَّرُ الْاِنْسَانُ وَاَنّٰی لَهُ الذِّكْرٰی ۟ؕ"},{"n":24,"t":"یَقُوْلُ یٰلَیْتَنِیْ قَدَّمْتُ لِحَیَاتِیْ ۟ۚ"},{"n":25,"t":"فَیَوْمَىِٕذٍ لَّا یُعَذِّبُ عَذَابَهٗۤ اَحَدٌ ۟ۙ"},{"n":26,"t":"وَّلَا یُوْثِقُ وَثَاقَهٗۤ اَحَدٌ ۟ؕ"},{"n":27,"t":"یٰۤاَیَّتُهَا النَّفْسُ الْمُطْمَىِٕنَّةُ ۟ۗۙ"},{"n":28,"t":"ارْجِعِیْۤ اِلٰی رَبِّكِ رَاضِیَةً مَّرْضِیَّةً ۟ۚ"},{"n":29,"t":"فَادْخُلِیْ فِیْ عِبٰدِیْ ۟ۙ"},{"n":30,"t":"وَادْخُلِیْ جَنَّتِیْ ۟۠"}]}