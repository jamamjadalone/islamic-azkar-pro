{
 "surah": 92,
 "ayahs": [
  {
   "n": 1,
   "t": "وَٱلَّیۡلِ إِذَا یَغۡشَىٰ",
   "tc": "واليل اذا يغشي"
  },
  {
   "n": 2,
   "t": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
   "tc": "والنهار اذا تجلي"
  },
  {
   "n": 3,
   "t": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰۤ",
   "tc": "وما خلق الذكر والانثي"
  },
  {
   "n": 4,
   "t": "إِنَّ سَعۡیَكُمۡ لَشَتَّىٰ",
   "tc": "ان سعيكم لشتي"
  },
  {
   "n": 5,
   "t": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
   "tc": "فاما من اعطي واتقي"
  },
  {
   "n": 6,
   "t": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
   "tc": "وصدق بالحسني"
  },
  {
   "n": 7,
   "t": "فَسَنُیَسِّرُهُۥ لِلۡیُسۡرَىٰ",
   "tc": "فسنيسره لليسري"
  },
  {
   "n": 8,
   "t": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
   "tc": "واما من بخل واستغني"
  },
  {
   "n": 9,
   "t": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
   "tc": "وكذب بالحسني"
  },
  {
   "n": 10,
   "t": "فَسَنُیَسِّرُهُۥ لِلۡعُسۡرَىٰ",
   "tc": "فسنيسره للعسري"
  },
  {
   "n": 11,
   "t": "وَمَا یُغۡنِی عَنۡهُ مَالُهُۥۤ إِذَا تَرَدَّىٰۤ",
   "tc": "وما يغني عنه ماله اذا تردي"
  },
  {
   "n": 12,
   "t": "إِنَّ عَلَیۡنَا لَلۡهُدَىٰ",
   "tc": "ان علينا للهدي"
  },
  {
   "n": 13,
   "t": "وَإِنَّ لَنَا لَلۡـَٔاخِرَةَ وَٱلۡأُولَىٰ",
   "tc": "وان لنا للاخره والاولي"
  },
  {
   "n": 14,
   "t": "فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ",
   "tc": "فانذرتكم نارࣰا تلظي"
  },
  {
   "n": 15,
   "t": "لَا یَصۡلَىٰهَاۤ إِلَّا ٱلۡأَشۡقَى",
   "tc": "لا يصليها الا الاشقي"
  },
  {
   "n": 16,
   "t": "ٱلَّذِی كَذَّبَ وَتَوَلَّىٰ",
   "tc": "الذي كذب وتولي"
  },
  {
   "n": 17,
   "t": "وَسَیُجَنَّبُهَا ٱلۡأَتۡقَى",
   "tc": "وسيجنبها الاتقي"
  },
  {
   "n": 18,
   "t": "ٱلَّذِی یُؤۡتِی مَالَهُۥ یَتَزَكَّىٰ",
   "tc": "الذي يؤتي ماله يتزكي"
  },
  {
   "n": 19,
   "t": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰۤ",
   "tc": "وما لاحد عنده من نعمهࣲ تجزي"
  },
  {
   "n": 20,
   "t": "إِلَّا ٱبۡتِغَاۤءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
   "tc": "الا ابتغاء وجه ربه الاعلي"
  },
  {
   "n": 21,
   "t": "وَلَسَوۡفَ یَرۡضَىٰ",
   "tc": "ولسوف يرضي"
  }
 ]
}