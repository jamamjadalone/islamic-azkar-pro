{"surah":55,"ayahs":[{"n":1,"t":"اَلرَّحْمٰنُ ۟ۙ"},{"n":2,"t":"عَلَّمَ الْقُرْاٰنَ ۟ؕ"},{"n":3,"t":"خَلَقَ الْاِنْسَانَ ۟ۙ"},{"n":4,"t":"عَلَّمَهُ الْبَیَانَ ۟"},{"n":5,"t":"اَلشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ ۟ۙ"},{"n":6,"t":"وَّالنَّجْمُ وَالشَّجَرُ یَسْجُدٰنِ ۟"},{"n":7,"t":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ الْمِیْزَانَ ۟ۙ"},{"n":8,"t":"اَلَّا تَطْغَوْا فِی الْمِیْزَانِ ۟"},{"n":9,"t":"وَاَقِیْمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمِیْزَانَ ۟"},{"n":10,"t":"وَالْاَرْضَ وَضَعَهَا لِلْاَنَامِ ۟ۙ"},{"n":11,"t":"فِیْهَا فَاكِهَةٌ وَّالنَّخْلُ ذَاتُ الْاَكْمَامِ ۟ۖ"},{"n":12,"t":"وَالْحَبُّ ذُو الْعَصْفِ وَالرَّیْحَانُ ۟ۚ"},{"n":13,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":14,"t":"خَلَقَ الْاِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِ ۟ۙ"},{"n":15,"t":"وَخَلَقَ الْجَآنَّ مِنْ مَّارِجٍ مِّنْ نَّارٍ ۟ۚ"},{"n":16,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":17,"t":"رَبُّ الْمَشْرِقَیْنِ وَرَبُّ الْمَغْرِبَیْنِ ۟ۚ"},{"n":18,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":19,"t":"مَرَجَ الْبَحْرَیْنِ یَلْتَقِیٰنِ ۟ۙ"},{"n":20,"t":"بَیْنَهُمَا بَرْزَخٌ لَّا یَبْغِیٰنِ ۟ۚ"},{"n":21,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":22,"t":"یَخْرُجُ مِنْهُمَا اللُّؤْلُؤُ وَالْمَرْجَانُ ۟ۚ"},{"n":23,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":24,"t":"وَلَهُ الْجَوَارِ الْمُنْشَاٰتُ فِی الْبَحْرِ كَالْاَعْلَامِ ۟ۚ"},{"n":25,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟۠"},{"n":26,"t":"كُلُّ مَنْ عَلَیْهَا فَانٍ ۟ۚۖ"},{"n":27,"t":"وَّیَبْقٰی وَجْهُ رَبِّكَ ذُو الْجَلٰلِ وَالْاِكْرَامِ ۟ۚ"},{"n":28,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":29,"t":"یَسْـَٔلُهٗ مَنْ فِی السَّمٰوٰتِ وَالْاَرْضِ ؕ— كُلَّ یَوْمٍ هُوَ فِیْ شَاْنٍ ۟ۚ"},{"n":30,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":31,"t":"سَنَفْرُغُ لَكُمْ اَیُّهَ الثَّقَلٰنِ ۟ۚ"},{"n":32,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":33,"t":"یٰمَعْشَرَ الْجِنِّ وَالْاِنْسِ اِنِ اسْتَطَعْتُمْ اَنْ تَنْفُذُوْا مِنْ اَقْطَارِ السَّمٰوٰتِ وَالْ