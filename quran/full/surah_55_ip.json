َآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟ۙ"},{"n":64,"t":"مُدْهَآمَّتٰنِ ۟ۚ"},{"n":65,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟ۚ"},{"n":66,"t":"فِیْهِمَا عَیْنٰنِ نَضَّاخَتٰنِ ۟ۚ"},{"n":67,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟ۚ"},{"n":68,"t":"فِیْهِمَا فَاكِهَةٌ وَّنَخْلٌ وَّرُمَّانٌ ۟ۚ"},{"n":69,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟ۚ"},{"n":70,"t":"فِیْهِنَّ خَیْرٰتٌ حِسَانٌ ۟ۚ"},{"n":71,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":72,"t":"حُوْرٌ مَّقْصُوْرٰتٌ فِی الْخِیَامِ ۟ۚ"},{"n":73,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":74,"t":"لَمْ یَطْمِثْهُنَّ اِنْسٌ قَبْلَهُمْ وَلَا جَآنٌّ ۟ۚ"},{"n":75,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":76,"t":"مُتَّكِـِٕیْنَ عَلٰی رَفْرَفٍ خُضْرٍ وَّعَبْقَرِیٍّ حِسَانٍ ۟ۚ"},{"n":77,"t":"فَبِاَیِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ ۟"},{"n":78,"t":"تَبٰرَكَ اسْمُ رَبِّكَ ذِی الْجَلٰلِ وَالْاِكْرَامِ ۟۠"}]}