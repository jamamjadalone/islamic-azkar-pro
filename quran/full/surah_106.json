{
 "surah": 106,
 "ayahs": [
  {
   "n": 1,
   "t": "لِإِیلَـٰفِ قُرَیۡشٍ",
   "tc": "لايلف قريش"
  },
  {
   "n": 2,
   "t": "إِۦلَـٰفِهِمۡ رِحۡلَةَ ٱلشِّتَاۤءِ وَٱلصَّیۡفِ",
   "tc": "الفهم رحله الشتاء والصيف"
  },
  {
   "n": 3,
   "t": "فَلۡیَعۡبُدُوا۟ رَبَّ هَـٰذَا ٱلۡبَیۡتِ",
   "tc": "فليعبدوا رب هذا البيت"
  },
  {
   "n": 4,
   "t": "ٱلَّذِیۤ أَطۡعَمَهُم مِّن جُوعࣲ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
   "tc": "الذي اطعمهم من جوعࣲ وءامنهم من خوف"
  }
 ]
