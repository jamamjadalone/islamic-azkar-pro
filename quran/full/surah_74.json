{
 "surah": 74,
 "ayahs": [
  {
   "n": 1,
   "t": "یَـٰۤأَیُّهَا ٱلۡمُدَّثِّرُ",
   "tc": "يايها المدثر"
  },
  {
   "n": 2,
   "t": "قُمۡ فَأَنذِرۡ",
   "tc": "قم فانذر"
  },
  {
   "n": 3,
   "t": "وَرَبَّكَ فَكَبِّرۡ",
   "tc": "وربك فكبر"
  },
  {
   "n": 4,
   "t": "وَثِیَابَكَ فَطَهِّرۡ",
   "tc": "وثيابك فطهر"
  },
  {
   "n": 5,
   "t": "وَٱلرُّجۡزَ فَٱهۡجُرۡ",
   "tc": "والرجز فاهجر"
  },
  {
   "n": 6,
   "t": "وَلَا تَمۡنُن تَسۡتَكۡثِرُ",
   "tc": "ولا تمنن تستكثر"
  },
  {
   "n": 7,
   "t": "وَلِرَبِّكَ فَٱصۡبِرۡ",
   "tc": "ولربك فاصبر"
  },
  {
   "n": 8,
   "t": "فَإِذَا نُقِرَ فِی ٱلنَّاقُورِ",
   "tc": "فاذا نقر في الناقور"
  },
  {
   "n": 9,
   "t": "فَذَ ٰ⁠لِكَ یَوۡمَىِٕذࣲ یَوۡمٌ عَسِیرٌ",
   "tc": "فذ لك يوميذࣲ يوم عسير"
  },
  {
   "n": 10,
   "t": "عَلَى ٱلۡكَـٰفِرِینَ غَیۡرُ یَسِیرࣲ",
   "tc": "علي الكفرين غير يسيرࣲ"
  },
  {
   "n": 11,
   "t": "ذَرۡنِی وَمَنۡ خَلَقۡتُ وَحِیدࣰا",
   "tc": "ذرني ومن خلقت وحيدࣰا"
  },
  {
   "n": 12,
   "t": "وَجَعَلۡتُ لَهُۥ مَالࣰا مَّمۡدُودࣰا",
   "tc": "وجعلت له مالࣰا ممدودࣰا"
  },
  {
   "n": 13,
   "t": "وَبَنِینَ شُهُودࣰا",
   "tc": "وبنين شهودࣰا"
  },
  {
   "n": 14,
   "t": "وَمَهَّدتُّ لَهُۥ تَمۡهِیدࣰا",
   "tc": "ومهدت له تمهيدࣰا"
  },
  {
   "n": 15,
   "t": "ثُمَّ یَطۡمَعُ أَنۡ أَزِیدَ",
   "tc": "ثم يطمع ان ازيد"
  },
  {
   "n": 16,
   "t": "كَلَّاۤۖ إِنَّهُۥ كَانَ لِـَٔایَـٰتِنَا عَنِیدࣰا",
   "tc": "كلا انه كان لايتنا عنيدࣰا"
  },
  {
   "n": 17,
   "t": "سَأُرۡهِقُهُۥ صَعُودًا",
   "tc": "سارهقه صعودا"
  },
  {
   "n": 18,
   "t": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
   "tc": "انه فكر وقدر"
  },
  {
   "n": 19,
   "t": "فَقُتِلَ كَیۡفَ قَدَّرَ",
   "tc": "فقتل كيف قدر"
  },
  {
   "n": 20,
   "t": "ثُمَّ قُتِلَ كَیۡفَ قَدَّرَ",
   "tc": "ثم قتل كيف قدر"
  },
  {
   "n": 21,
   "t": "ثُمَّ نَظَرَ",
   "tc": "ثم نظر"
  },
  {
   "n": 22,
   "t": "ثُمَّ عَبَسَ وَبَسَرَ",
   "tc": "ثم عبس وبسر"
  },
  {
   "n": 23,
   "t": "ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ",
   "tc": "ثم ادبر واستكبر"
  },
  {
   "n": 24,
   "t": "فَقَالَ إِنۡ هَـٰذَاۤ إِلَّا سِحۡرࣱ یُؤۡثَرُ",
   "tc": "فقال ان هذا الا سحرࣱ يؤثر"
  },
  {
   "n": 25,
   "t": "إِنۡ هَـٰذَاۤ إِلَّا قَوۡلُ ٱلۡبَشَرِ",
   "tc": "ان هذا الا قول البشر"
  },
  {
   "n": 26,
   "t": "سَأُصۡلِیهِ سَقَرَ",
   "tc": "ساصليه سقر"
  },
  {
   "n": 27,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا سَقَرُ",
   "tc": "وما ادريك ما سقر"
  },
  {
   "n": 28,
   "t": "لَا تُبۡقِی وَلَا تَذَرُ",
   "tc": "لا تبقي ولا تذر"
  },
  {
   "n": 29,
   "t": "لَوَّاحَةࣱ لِّلۡبَشَرِ",
   "tc": "لواحهࣱ للبشر"
  },
  {
   "n": 30,
   "t": "عَلَیۡهَا تِسۡعَةَ عَشَرَ",
   "tc": "عليها تسعه عشر"
  },
  {
   "n": 31,
   "t": "وَمَا جَعَلۡنَاۤ أَصۡحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰۤىِٕكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِینَ كَفَرُوا۟ لِیَسۡتَیۡقِنَ ٱلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ وَیَزۡدَادَ ٱلَّذِینَ ءَامَنُوۤا۟ إِیمَـٰنࣰا وَلَا یَرۡتَابَ ٱلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ وَٱلۡمُؤۡمِنُونَ وَلِیَقُولَ ٱلَّذِینَ فِی قُلُوبِهِم مَّرَضࣱ وَٱلۡكَـٰفِرُونَ مَاذَاۤ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلࣰاۚ كَذَ ٰ⁠لِكَ یُضِلُّ ٱللَّهُ مَن یَشَاۤءُ وَیَهۡدِی مَن یَشَاۤءُۚ وَمَا یَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِیَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ",
   "tc": "وما جعلنا اصحب النار الا مليكهࣰ وما جعلنا عدتهم الا فتنهࣰ للذين كفروا ليستيقن الذين اوتوا الكتب ويزداد الذين ءامنوا ايمنࣰا ولا يرتاب الذين اوتوا الكتب والمؤمنون وليقول الذين في قلوبهم مرضࣱ والكفرون ماذا اراد الله بهذا مثلࣰا كذ لك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكري للبشر"
  },
  {
   "n": 32,
   "t": "كَلَّا وَٱلۡقَمَرِ",
   "tc": "كلا والقمر"
  },
  {
   "n": 33,
   "t": "وَٱلَّیۡلِ إِذۡ أَدۡبَرَ",
   "tc": "واليل اذ ادبر"
  },
  {
   "n": 34,
   "t": "وَٱلصُّبۡحِ إِذَاۤ أَسۡفَرَ",
   "tc": "والصبح اذا اسفر"
  },
  {
   "n": 35,
   "t": "إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ",
   "tc": "انها لاحدي الكبر"
  },
  {
   "n": 36,
   "t": "نَذِیرࣰا لِّلۡبَشَرِ",
   "tc": "نذيرࣰا للبشر"
  },
  {
   "n": 37,
   "t": "لِمَن شَاۤءَ مِنكُمۡ أَن یَتَقَدَّمَ أَوۡ یَتَأَخَّرَ",
   "tc": "لمن شاء منكم ان يتقدم او يتاخر"
  },
  {
   "n": 38,
   "t": "كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِینَةٌ",
   "tc": "كل نفس بما كسبت رهينه"
  },
  {
   "n": 39,
   "t": "إِلَّاۤ أَصۡحَـٰبَ ٱلۡیَمِینِ",
   "tc": "الا اصحب اليمين"
  },
  {
   "n": 40,
   "t": "فِی جَنَّـٰتࣲ یَتَسَاۤءَلُونَ",
   "tc": "في جنتࣲ يتساءلون"
  },
  {
   "n": 41,
   "t": "عَنِ ٱلۡمُجۡرِمِینَ",
   "tc": "عن المجرمين"
  },
  {
   "n": 42,
   "t": "مَا سَلَكَكُمۡ فِی سَقَرَ",
   "tc": "ما سلككم في سقر"
  },
  {
   "n": 43,
   "t": "قَالُوا۟ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّینَ",
   "tc": "قالوا لم نك من المصلين"
  },
  {
   "n": 44,
   "t": "وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِینَ",
   "tc": "ولم نك نطعم المسكين"
  },
  {
   "n": 45,
   "t": "وَكُنَّا نَخُوضُ مَعَ ٱلۡخَاۤىِٕضِینَ",
   "tc": "وكنا نخوض مع الخايضين"
  },
  {
   "n": 46,
   "t": "وَكُنَّا نُكَذِّبُ بِیَوۡمِ ٱلدِّینِ",
   "tc": "وكنا نكذب بيوم الدين"
  },
  {
   "n": 47,
   "t": "حَتَّىٰۤ أَتَىٰنَا ٱلۡیَقِینُ",
   "tc": "حتي اتينا اليقين"
  },
  {
   "n": 48,
   "t": "فَمَا تَنفَعُهُمۡ شَفَـٰعَةُ ٱلشَّـٰفِعِینَ",
   "tc": "فما تنفعهم شفعه الشفعين"
  },
  {
   "n": 49,
   "t": "فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِینَ",
   "tc": "فما لهم عن التذكره معرضين"
  },
  {
   "n": 50,
   "t": "كَأَنَّهُمۡ حُمُرࣱ مُّسۡتَنفِرَةࣱ",
   "tc": "كانهم حمرࣱ مستنفرهࣱ"
  },
  {
   "n": 51,
   "t": "فَرَّتۡ مِن قَسۡوَرَةِۭ",
   "tc": "فرت من قسوره"
  },
  {
   "n": 52,
   "t": "بَلۡ یُرِیدُ كُلُّ ٱمۡرِئࣲ مِّنۡهُمۡ أَن یُؤۡتَىٰ صُحُفࣰا مُّنَشَّرَةࣰ",
   "tc": "بل يريد كل امرئࣲ منهم ان يؤتي صحفࣰا منشرهࣰ"
  },
  {
   "n": 53,
   "t": "كَلَّاۖ بَل لَّا یَخَافُونَ ٱلۡـَٔاخِرَةَ",
   "tc": "كلا بل لا يخافون الاخره"
  },
  {
   "n": 54,
   "t": "كَلَّاۤ إِنَّهُۥ تَذۡكِرَةࣱ",
   "tc": "كلا انه تذكرهࣱ"
  },
  {
   "n": 55,
   "t": "فَمَن شَاۤءَ ذَكَرَهُۥ",
   "tc": "فمن شاء ذكره"
  },
  {
   "n": 56,
   "t": "وَمَا یَذۡكُرُونَ إِلَّاۤ أَن یَشَاۤءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ",
   "tc": "وما يذكرون الا ان يشاء الله هو اهل التقوي واهل المغفره"
  }
 ]
}