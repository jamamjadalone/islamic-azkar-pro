{
 "surah": 104,
 "ayahs": [
  {
   "n": 1,
   "t": "وَیۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ",
   "tc": "ويلࣱ لكل همزهࣲ لمزه"
  },
  {
   "n": 2,
   "t": "ٱلَّذِی جَمَعَ مَالࣰا وَعَدَّدَهُۥ",
   "tc": "الذي جمع مالࣰا وعدده"
  },
  {
   "n": 3,
   "t": "یَحۡسَبُ أَنَّ مَالَهُۥۤ أَخۡلَدَهُۥ",
   "tc": "يحسب ان ماله اخلده"
  },
  {
   "n": 4,
   "t": "كَلَّاۖ لَیُنۢبَذَنَّ فِی ٱلۡحُطَمَةِ",
   "tc": "كلا لينبذن في الحطمه"
  },
  {
   "n": 5,
   "t": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
   "tc": "وما ادريك ما الحطمه"
  },
  {
   "n": 6,
   "t": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
   "tc": "نار الله الموقده"
  },
  {
   "n": 7,
   "t": "ٱلَّتِی تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
   "tc": "التي تطلع علي الافده"
  },
  {
   "n": 8,
   "t": "إِنَّهَا عَلَیۡهِم مُّؤۡصَدَةࣱ",
   "tc": "انها عليهم مؤصدهࣱ"
  },
  {
   "n": 9,
   "t": "فِی عَمَدࣲ مُّمَدَّدَةِۭ",
   "tc": "في عمدࣲ ممدده"
  }
 ]
}