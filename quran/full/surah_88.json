{
 "surah": 88,
 "ayahs": [
  {
   "n": 1,
   "t": "هَلۡ أَتَىٰكَ حَدِیثُ ٱلۡغَـٰشِیَةِ",
   "tc": "هل اتيك حديث الغشيه"
  },
  {
   "n": 2,
   "t": "وُجُوهࣱ یَوۡمَىِٕذٍ خَـٰشِعَةٌ",
   "tc": "وجوهࣱ يوميذ خشعه"
  },
  {
   "n": 3,
   "t": "عَامِلَةࣱ نَّاصِبَةࣱ",
   "tc": "عاملهࣱ ناصبهࣱ"
  },
  {
   "n": 4,
   "t": "تَصۡلَىٰ نَارًا حَامِیَةࣰ",
   "tc": "تصلي نارا حاميهࣰ"
  },
  {
   "n": 5,
   "t": "تُسۡقَىٰ مِنۡ عَیۡنٍ ءَانِیَةࣲ",
   "tc": "تسقي من عين ءانيهࣲ"
  },
  {
   "n": 6,
   "t": "لَّیۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِیعࣲ",
   "tc": "ليس لهم طعام الا من ضريعࣲ"
  },
  {
   "n": 7,
   "t": "لَّا یُسۡمِنُ وَلَا یُغۡنِی مِن جُوعࣲ",
   "tc": "لا يسمن ولا يغني من جوعࣲ"
  },
  {
   "n": 8,
   "t": "وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاعِمَةࣱ",
   "tc": "وجوهࣱ يوميذࣲ ناعمهࣱ"
  },
  {
   "n": 9,
   "t": "لِّسَعۡیِهَا رَاضِیَةࣱ",
   "tc": "لسعيها راضيهࣱ"
  },
  {
   "n": 10,
   "t": "فِی جَنَّةٍ عَالِیَةࣲ",
   "tc": "في جنه عاليهࣲ"
  },
  {
   "n": 11,
   "t": "لَّا تَسۡمَعُ فِیهَا لَـٰغِیَةࣰ",
   "tc": "لا تسمع فيها لغيهࣰ"
  },
  {
   "n": 12,
   "t": "فِیهَا عَیۡنࣱ جَارِیَةࣱ",
   "tc": "فيها عينࣱ جاريهࣱ"
  },
  {
   "n": 13,
   "t": "فِیهَا سُرُرࣱ مَّرۡفُوعَةࣱ",
   "tc": "فيها سررࣱ مرفوعهࣱ"
  },
  {
   "n": 14,
   "t": "وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ",
   "tc": "واكوابࣱ موضوعهࣱ"
  },
  {
   "n": 15,
   "t": "وَنَمَارِقُ مَصۡفُوفَةࣱ",
   "tc": "ونمارق مصفوفهࣱ"
  },
  {
   "n": 16,
   "t": "وَزَرَابِیُّ مَبۡثُوثَةٌ",
   "tc": "وزرابي مبثوثه"
  },
  {
   "n": 17,
   "t": "أَفَلَا یَنظُرُونَ إِلَى ٱلۡإِبِلِ كَیۡفَ خُلِقَتۡ",
   "tc": "افلا ينظرون الي الابل كيف خلقت"
  },
  {
   "n": 18,
   "t": "وَإِلَى ٱلسَّمَاۤءِ كَیۡفَ رُفِعَتۡ",
   "tc": "والي السماء كيف رفعت"
  },
  {
   "n": 19,
   "t": "وَإِلَى ٱلۡجِبَالِ كَیۡفَ نُصِبَتۡ",
   "tc": "والي الجبال كيف نصبت"
  },
  {
   "n": 20,
   "t": "وَإِلَى ٱلۡأَرۡضِ كَیۡفَ سُطِحَتۡ",
   "tc": "والي الارض كيف سطحت"
  },
  {
   "n": 21,
   "t": "فَذَكِّرۡ إِنَّمَاۤ أَنتَ مُذَكِّرࣱ",
   "tc": "فذكر انما انت مذكرࣱ"
  },
  {
   "n": 22,
   "t": "لَّسۡتَ عَلَیۡهِم بِمُصَیۡطِرٍ",
   "tc": "لست عليهم بمصيطر"
  },
  {
   "n": 23,
   "t": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
   "tc": "الا من تولي وكفر"
  },
  {
   "n": 24,
   "t": "فَیُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
   "tc": "فيعذبه الله العذاب الاكبر"
  },
  {
   "n": 25,
   "t": "إِنَّ إِلَیۡنَاۤ إِیَابَهُمۡ",
   "tc": "ان الينا ايابهم"
  },
  {
   "n": 26,
   "t": "ثُمَّ إِنَّ عَلَیۡنَا حِسَابَهُم",
   "tc": "ثم ان علينا حسابهم"
  }
 ]
}