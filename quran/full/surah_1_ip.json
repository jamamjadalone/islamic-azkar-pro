{"surah":1,"ayahs":[{"n":1,"t":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِیْمِ ۟"},{"n":2,"t":"اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِیْنَ ۟ۙ"},{"n":3,"t":"الرَّحْمٰنِ الرَّحِیْمِ ۟ۙ"},{"n":4,"t":"مٰلِكِ یَوْمِ الدِّیْنِ ۟ؕ"},{"n":5,"t":"اِیَّاكَ نَعْبُدُ وَاِیَّاكَ نَسْتَعِیْنُ ۟ؕ"},{"n":6,"t":"اِهْدِنَا الصِّرَاطَ الْمُسْتَقِیْمَ ۟ۙ"},{"n":7,"t":"صِرَاطَ الَّذِیْنَ اَنْعَمْتَ عَلَیْهِمْ ۙ۬— غَیْرِ الْمَغْضُوْبِ عَلَیْهِمْ وَلَا الضَّآلِّیْنَ ۟۠"}]}