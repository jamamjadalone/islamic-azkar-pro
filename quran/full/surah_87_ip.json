{"surah":87,"ayahs":[{"n":1,"t":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَی ۟ۙ"},{"n":2,"t":"الَّذِیْ خَلَقَ فَسَوّٰی ۟"},{"n":3,"t":"وَالَّذِیْ قَدَّرَ فَهَدٰی ۟"},{"n":4,"t":"وَالَّذِیْۤ اَخْرَجَ الْمَرْعٰی ۟"},{"n":5,"t":"فَجَعَلَهٗ غُثَآءً اَحْوٰی ۟ؕ"},{"n":6,"t":"سَنُقْرِئُكَ فَلَا تَنْسٰۤی ۟ۙ"},{"n":7,"t":"اِلَّا مَا شَآءَ اللّٰهُ ؕ— اِنَّهٗ یَعْلَمُ الْجَهْرَ وَمَا یَخْفٰی ۟ؕ"},{"n":8,"t":"وَنُیَسِّرُكَ لِلْیُسْرٰی ۟ۚۖ"},{"n":9,"t":"فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰی ۟ؕ"},{"n":10,"t":"سَیَذَّكَّرُ مَنْ یَّخْشٰی ۟ۙ"},{"n":11,"t":"وَیَتَجَنَّبُهَا الْاَشْقَی ۟ۙ"},{"n":12,"t":"الَّذِیْ یَصْلَی النَّارَ الْكُبْرٰی ۟ۚ"},{"n":13,"t":"ثُمَّ لَا یَمُوْتُ فِیْهَا وَلَا یَحْیٰی ۟ؕ"},{"n":14,"t":"قَدْ اَفْلَحَ مَنْ تَزَكّٰی ۟ۙ"},{"n":15,"t":"وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰی ۟ؕ"},{"n":16,"t":"بَلْ تُؤْثِرُوْنَ الْحَیٰوةَ الدُّنْیَا ۟ۚۖ"},{"n":17,"t":"وَالْاٰخِرَةُ خَیْرٌ وَّاَبْقٰی ۟ؕ"},{"n":18,"t":"اِنَّ هٰذَا لَفِی الصُّحُفِ الْاُوْلٰی ۟ۙ"},{"n":19,"t":"صُحُفِ اِبْرٰهِیْمَ وَمُوْسٰی ۟۠"}]}