{
 "surah": 113,
 "ayahs": [
  {
   "n": 1,
   "t": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",
   "tc": "قل اعوذ برب الفلق"
  },
  {
   "n": 2,
   "t": "مِن شَرِّ مَا خَلَقَ",
   "tc": "من شر ما خلق"
  },
  {
   "n": 3,
   "t": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
   "tc": "ومن شر غاسق اذا وقب"
  },
  {
   "n": 4,
   "t": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِی ٱلۡعُقَدِ",
   "tc": "ومن شر النفثت في العقد"
  },
  {
   "n": 5,
   "t": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
   "tc": "ومن شر حاسد اذا حسد"
  }
 ]
}